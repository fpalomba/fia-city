var CONTENT = {"levels":[{"id":"L1","name":"Quartiere delle Origini","implemented":true,"buildings":[{"id":"biblioteca","name":"Biblioteca Treccani","stages":[{"title":"Lo schedario delle facoltà","presentation":"connect","instructions":"Collega ogni facoltà della definizione Treccani all'area dell'Intelligenza Artificiale corrispondente. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 1 · slide 5","items":[{"id":"bib.match.facolta","kind":"match","weight":3,"prompt":"Facoltà dell'intelligenza → area dell'IA","leftTitle":"Facoltà (Treccani)","rightTitle":"Area dell'IA","pairs":[["Pensare","Reasoning"],["Comprendere o spiegare i fatti o le azioni","Understanding, Explanation"],["Elaborare modelli astratti della realtà","Knowledge Representation"],["Intendere e farsi intendere","Language, Interaction"],["Giudicare","Decision Making"],["Adattarsi a situazioni nuove o modificare la situazione stessa","Learning, Action"]],"explain":"Quasi tutte le facoltà della definizione Treccani sono oggi oggetto di aree specifiche dell'IA."}]},{"title":"Sfida della Bibliotecaria","presentation":"battle","pick":3,"ref":"Lezione 1 · slide 3-9","items":[{"id":"bib.q.complesso","kind":"mcq","prompt":"Nella definizione Treccani, su quale espressione va posta quasi più enfasi che sulle singole facoltà?","options":["«Complesso di facoltà»","«Pensare»","«Modelli astratti»","«Giudicare»"],"answer":0,"explain":"Il punto non è che reasoning o learning siano singolarmente intelligenza: l'intelligenza è il costrutto che descrive la loro integrazione."},{"id":"bib.q.separate","kind":"mcq","prompt":"Aver costruito sistemi che realizzano separatamente reasoning, learning, language... significa aver costruito l'intelligenza?","options":["No: ciascuna capacità presa da sola ≠ intelligenza, conta la loro integrazione","Sì, se le prestazioni superano quelle umane","Sì, purché il sistema sappia anche apprendere","Solo se il sistema supera il test di Turing"],"answer":0,"explain":"Reasoning ≠ Intelligence, Learning ≠ Intelligence, ecc.: l'intelligenza è un complesso di facoltà integrate."},{"id":"bib.q.mappa","kind":"mcq","prompt":"«Una mappa non è un territorio» è l'esempio usato per quale facoltà?","options":["Elaborare modelli astratti della realtà","Giudicare","Intendere e farsi intendere","Adattarsi a situazioni nuove"],"answer":0,"explain":"L'intelligenza costruisce rappresentazioni del mondo che permettono di ragionare anche su ciò che non è immediatamente presente."},{"id":"bib.q.giudicare","kind":"mcq","prompt":"Nel corso, che cosa significa «giudicare»?","options":["Valutare alternative sulla base delle informazioni disponibili, dei criteri adottati e delle conseguenze previste","Reagire direttamente agli stimoli dell'ambiente","Comunicare agli altri le proprie intenzioni","Memorizzare le esperienze passate"],"answer":0,"explain":"Giudicare corrisponde, nell'IA, al Decision Making."},{"id":"bib.q.adattarsi","kind":"mcq","prompt":"Quale di questi aspetti fa parte di «adattarsi a situazioni nuove o modificare la situazione stessa»?","options":["Agire sul mondo per renderlo compatibile con i propri obiettivi","Evitare di modificare la propria rappresentazione del mondo","Ripetere solo comportamenti già sperimentati","Attribuire un significato a ciò che si percepisce"],"answer":0,"explain":"Adattarsi significa modificare comportamento e rappresentazioni con l'esperienza, generalizzare e agire sul mondo (Learning, Action)."}]}]},{"id":"museo","name":"Museo della Storia dell'IA","stages":[{"title":"La linea del tempo","presentation":"timeline","instructions":"Trascina le teche (o usa le frecce ▲▼) per ordinarle dalla più antica alla più recente.","ref":"Lezione 1 · slide 10-18, 38","items":[{"id":"mus.order.storia","kind":"order","weight":3,"prompt":"Ordina gli eventi dal più antico al più recente","entries":[{"label":"Gödel pubblica il teorema di incompletezza","reveal":"1931"},{"label":"Muore Kenneth Craik; il suo lavoro sarà continuato da Broadbent","reveal":"1945"},{"label":"Norbert Wiener pubblica «Cybernetics»","reveal":"1948"},{"label":"Alan Turing pubblica «Computing Machinery and Intelligence»","reveal":"1950"},{"label":"Dartmouth Summer Research Project on Artificial Intelligence","reveal":"1956"}],"explain":"Gödel 1931 · Craik 1945 · Wiener 1948 · Turing 1950 · Dartmouth 1956."}]},{"title":"Le targhe dei pionieri","presentation":"connect","instructions":"Collega ogni pioniere al contributo descritto nella sua targa.","ref":"Lezione 1 · slide 10-18, 23-25","items":[{"id":"mus.match.pionieri","kind":"match","weight":2,"prompt":"Pioniere → contributo","leftTitle":"Pioniere","rightTitle":"Contributo","pairs":[["Norbert Wiener","Comunicazione e controllo in organismi e macchine tramite feedback"],["Alan Turing","Dal «possono pensare?» al comportamento osservabile"],["John McCarthy","Conia il termine «Artificial Intelligence»"],["Kenneth Craik","Il «modello in scala» della realtà nella testa dell'organismo"],["Herbert Simon","Gli esseri umani sono agenti a razionalità limitata"]],"explain":"Wiener: cibernetica (1948). Turing: comportamento osservabile (1950). McCarthy: Dartmouth (1956). Craik: psicologia cognitiva. Simon: razionalità limitata."}]},{"title":"L'esame del Curatore","presentation":"battle","pick":3,"ref":"Lezione 1 · slide 10-18","items":[{"id":"mus.q.cibernetica","kind":"mcq","prompt":"Qual era l'oggetto di studio della cibernetica di Wiener?","options":["I meccanismi di comunicazione e controllo con cui organismi e macchine si adattano all'ambiente tramite feedback","Come costruire una macchina che pensi come un essere umano","La formalizzazione logica del ragionamento corretto","L'imitazione del linguaggio umano da parte delle macchine"],"answer":0,"explain":"La cibernetica non cerca di stabilire cosa sia l'intelligenza: studia i meccanismi da cui può emergere un comportamento adattivo."},{"id":"mus.q.turing","kind":"mcq","prompt":"Quale passo compie Turing nel 1950, cambiando per sempre il futuro dell'IA?","options":["Invece di definire l'intelligenza, definisce il comportamento osservabile","Definisce formalmente il significato di «pensare»","Dimostra che le macchine possono pensare","Fonda la cibernetica insieme a Wiener"],"answer":0,"explain":"«Machine» e «think» sono troppo ambigui: la domanda diventa «possono le macchine comportarsi come un umano?»."},{"id":"mus.q.statistica","kind":"mcq","prompt":"Secondo quanto visto nel corso, l'attenzione al comportamento (più che al pensiero) ci ha di fatto portato a...","options":["Un'IA basata su statistica e probabilità","Sistemi esperti basati solo su regole","Abbandonare lo studio dell'IA per decenni","Simulare il cervello neurone per neurone"],"answer":0,"explain":"Non ci interessa tanto sapere se una macchina pensa, ma se si comporta in maniera coerente."},{"id":"mus.q.mccarthy","kind":"mcq","prompt":"Perché McCarthy volle un termine nuovo come «Artificial Intelligence»?","options":["Anche per distinguere il proprio programma dalla cibernetica e dall'influenza di Wiener","Perché Turing lo aveva già proposto nel 1950","Perché esisteva ormai una definizione condivisa di intelligenza","Per rispettare un requisito del finanziamento di Dartmouth"],"answer":0,"explain":"Tra McCarthy e Wiener c'era una forte antipatia. E il nome cambiò prima di una definizione condivisa di intelligenza!"},{"id":"mus.q.dartmouth","kind":"mcq","prompt":"«Every aspect of learning or any other feature of intelligence can in principle be so precisely described that a machine can be made to simulate it.» Da dove viene questa frase?","options":["Dalla proposta del Dartmouth Summer Research Project (1956)","Da «Cybernetics» di Wiener (1948)","Da «Computing Machinery and Intelligence» di Turing (1950)","Dal teorema di Gödel (1931)"],"answer":0,"explain":"La firmarono McCarthy, Minsky, Rochester e Shannon: lì nasce l'etichetta disciplinare."}]}]},{"id":"osservatorio","name":"Osservatorio dei Quattro Quadranti","stages":[{"title":"Smista le stelle-definizione","presentation":"bins","instructions":"Per ogni definizione, scegli il quadrante a cui appartiene. Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 1 · slide 20","items":[{"id":"oss.cat.quadranti","kind":"categorize","weight":4,"prompt":"Definizioni di IA → quadrante","categories":["Pensare umanamente","Pensare razionalmente","Agire umanamente","Agire razionalmente"],"entries":[{"label":"Il tentativo di far sì che i computer arrivino a pensare","cat":0},{"label":"L'automazione delle attività che associamo al pensiero umano: decisioni, risoluzione di problemi, apprendimento","cat":0},{"label":"Lo studio delle facoltà mentali attraverso l'uso di modelli computazionali","cat":1},{"label":"Lo studio dei processi di calcolo che rendono possibile percepire, ragionare e agire","cat":1},{"label":"L'arte di creare macchine che eseguono attività che richiedono intelligenza quando svolte da persone","cat":2},{"label":"Lo studio di come far eseguire ai computer le attività in cui, al momento, le persone sono più brave","cat":2},{"label":"L'Intelligenza Computazionale è lo studio della progettazione di agenti intelligenti","cat":3},{"label":"L'IA riguarda il comportamento intelligente negli artefatti","cat":3}],"explain":"Ogni quadrante corrisponde a un diverso modo di rendere operativo il concetto di intelligenza."}]},{"title":"Costellazioni degli approcci","presentation":"connect","instructions":"Collega ogni approccio al quadrante in cui lo abbiamo studiato.","ref":"Lezione 1 · slide 22-40","items":[{"id":"oss.match.approcci","kind":"match","weight":1,"prompt":"Approccio → quadrante","leftTitle":"Approccio","rightTitle":"Quadrante","pairs":[["Modellazione cognitiva","Pensare umanamente"],["Leggi del pensiero (sillogismi, logica)","Pensare razionalmente"],["Test di Turing","Agire umanamente"],["Agenti razionali","Agire razionalmente"]],"explain":"Modellazione cognitiva, leggi del pensiero, test di Turing, agenti razionali: un approccio per quadrante."}]},{"title":"Il quiz di Vega","presentation":"battle","pick":4,"ref":"Lezione 1 · slide 22-30, 40","items":[{"id":"oss.q.tremodi","kind":"mcq","prompt":"Quali sono i tre modi per modellare i meccanismi interni del cervello umano?","options":["Introspezione, sperimentazione psicologica, imaging cerebrale","Logica, probabilità, statistica","Percezione, ragionamento, azione","Test di Turing, sillogismi, agenti razionali"],"answer":0,"explain":"È l'approccio della modellazione cognitiva (pensare umanamente)."},{"id":"oss.q.craik","kind":"mcq","prompt":"Quale di questi NON è uno dei tre requisiti di un agente intelligente secondo Craik?","options":["Le rappresentazioni devono essere dimostrabili formalmente come corrette","Lo stimolo deve essere tradotto in una rappresentazione interna","La rappresentazione deve essere manipolata da processi cognitivi per ottenerne di nuove","Le nuove rappresentazioni devono essere trasformate in azioni"],"answer":0,"explain":"Stimolo → rappresentazione interna → manipolazione → azione. Nessun requisito di dimostrabilità formale."},{"id":"oss.q.logicisti","kind":"mcq","prompt":"Quali sono i due problemi della tradizione logicista?","options":["È difficile formalizzare conoscenza non certa al 100%, e risolvere un problema «in linea di principio» è diverso dal farlo nella pratica","Mancano sensori e attuatori, e i computer sono troppo lenti","Non si possono rappresentare relazioni tra oggetti, né numeri","Dipende troppo dai dati, e dalla statistica"],"answer":0,"explain":"Anche poche centinaia di fatti possono esaurire le risorse, se non si guida il ragionamento."},{"id":"oss.q.razionale","kind":"mcq","prompt":"Un agente razionale agisce in modo da ottenere...","options":["Il miglior risultato o, in condizioni di incertezza, il miglior risultato atteso","Sempre il risultato perfetto","Lo stesso risultato che otterrebbe un essere umano","Un risultato dimostrabile come logicamente corretto"],"answer":0,"explain":"Razionalità non è perfezione, ma massimizzazione del risultato (atteso)."},{"id":"oss.q.inferenze","kind":"mcq","prompt":"Perché saper fare inferenze corrette (leggi del pensiero) non basta per essere un agente razionale?","options":["Perché in alcune situazioni non si può dimostrare quale sia l'azione giusta, eppure qualcosa va fatto","Perché le inferenze logiche sono sempre sbagliate","Perché un agente razionale non usa mai la logica","Perché le inferenze funzionano solo per i numeri"],"answer":0,"explain":"La razionalità include le inferenze corrette, ma aggiunge l'idea di agire al meglio con le informazioni disponibili."},{"id":"oss.q.cervello","kind":"mcq","prompt":"Confrontando cervello e computer, a quale conclusione arriva il corso?","options":["Anche con un computer di capacità virtualmente illimitata non sapremmo come raggiungere l'intelligenza del cervello","Un supercomputer supera già il cervello in ogni misura, quindi è più intelligente","Il cervello è più lento in tutto, quindi è meno intelligente","Basta aumentare il numero di CPU per ottenere intelligenza"],"answer":0,"explain":"Il problema non è solo di capacità di calcolo: non sappiamo come si origina un pensiero."}]}]},{"id":"teatro","name":"Teatro dell'Imitazione","stages":[{"title":"Assegna i ruoli","presentation":"connect","instructions":"Nella versione con la macchina, collega ogni protagonista al suo obiettivo.","ref":"Lezione 1 · slide 32-33","items":[{"id":"tea.match.ruoli","kind":"match","weight":1,"prompt":"Protagonista → obiettivo","leftTitle":"Protagonista","rightTitle":"Obiettivo","pairs":[["A, la macchina","Ingannare C e indurlo in errore, rispondendo come se fosse B"],["B, la donna","Aiutare C nella corretta identificazione"],["C, l'interrogante","Capire, tramite domande, quale delle due entità è la macchina"]],"explain":"C è isolato in una stanza e conosce A e B solo come X e Y. A è l'imitatore."}]},{"title":"Duello delle obiezioni","presentation":"duel","instructions":"Il pubblico lancia un'obiezione contro Turing: scegli la risposta che Turing stesso diede.","ref":"Lezione 1 · slide 34-37","items":[{"id":"tea.duel.anima","kind":"mcq","prompt":"«Il pensiero è funzione esclusiva dell'anima immortale dell'uomo, con origine divina!»","options":["Il test di Turing sottolinea una limitazione all'onnipotenza divina","Questa obiezione è solo il frutto dell'idea dell'uomo superiore a tutti gli altri esseri","Questo argomento è irrilevante nel contesto del gioco dell'imitazione","È un errore pensare che tutte le conseguenze di un fatto si presentino alla mente simultaneamente"],"answer":0},{"id":"tea.duel.conseguenze","kind":"mcq","prompt":"«Ci saranno conseguenze terribili nel pensare a macchine pensanti!»","options":["Il test di Turing sottolinea una limitazione all'onnipotenza divina","Questa obiezione è solo il frutto dell'idea dell'uomo superiore a tutti gli altri esseri","Questo argomento è irrilevante nel contesto del gioco dell'imitazione","È un errore pensare che tutte le conseguenze di un fatto si presentino alla mente simultaneamente"],"answer":1},{"id":"tea.duel.discreto","kind":"mcq","prompt":"«È impossibile simulare il sistema nervoso come una macchina a stati discreti!»","options":["Il test di Turing sottolinea una limitazione all'onnipotenza divina","Questa obiezione è solo il frutto dell'idea dell'uomo superiore a tutti gli altri esseri","Questo argomento è irrilevante nel contesto del gioco dell'imitazione","È un errore pensare che tutte le conseguenze di un fatto si presentino alla mente simultaneamente"],"answer":2},{"id":"tea.duel.ordini","kind":"mcq","prompt":"«Le macchine possono fare solo ciò che gli viene ordinato di fare!»","options":["Il test di Turing sottolinea una limitazione all'onnipotenza divina","Questa obiezione è solo il frutto dell'idea dell'uomo superiore a tutti gli altri esseri","Questo argomento è irrilevante nel contesto del gioco dell'imitazione","È un errore pensare che tutte le conseguenze di un fatto si presentino alla mente simultaneamente"],"answer":3}]},{"title":"Domande dal loggione","presentation":"battle","pick":2,"ref":"Lezione 1 · slide 32-38","items":[{"id":"tea.q.comportamento","kind":"mcq","prompt":"Secondo l'approccio del test di Turing, l'intelligenza si misura guardando...","options":["Il comportamento esterno, non il ragionamento che lo ha prodotto","Il codice sorgente del programma","Il numero di neuroni artificiali","La velocità di calcolo della macchina"],"answer":0,"explain":"L'unico modo per essere sicuri che una macchina pensi sarebbe essere la macchina stessa: impossibile."},{"id":"tea.q.godel","kind":"mcq","prompt":"Cosa dimostra il teorema di Gödel (1931), citato tra le limitazioni delle macchine a stati discreti?","options":["In ogni sistema logico sufficientemente potente esistono proposizioni che non si possono dimostrare né confutare nel sistema","Ogni proposizione vera è dimostrabile da una macchina","Le macchine non potranno mai superare il test di Turing","Il cervello umano è una macchina a stati discreti"],"answer":0,"explain":"E le stesse limitazioni potrebbero valere anche per l'intelletto umano: ad oggi non esiste una dimostrazione."},{"id":"tea.q.umani","kind":"mcq","prompt":"Le limitazioni evidenziate dal teorema di Gödel...","options":["Potrebbero valere anche per l'intelletto umano: ad oggi non esiste una dimostrazione a riguardo","Dimostrano che le macchine non potranno mai pensare","Riguardano solo i computer quantistici","Sono state superate dal test di Turing"],"answer":0,"explain":"Il punto è che nulla dimostra che l'intelletto umano ne sia esente."},{"id":"tea.q.perche","kind":"mcq","prompt":"Perché Turing propone il gioco dell'imitazione?","options":["Per dare una definizione operativa dell'intelligenza, visto che «machine» e «think» sono termini troppo ambigui","Per dimostrare che uomini e donne pensano in modo diverso","Per misurare la velocità di risposta dei computer","Per definire formalmente la coscienza"],"answer":0,"explain":"Il test fornisce una «soddisfacente definizione operativa dell'intelligenza»."}]}]},{"id":"agora","name":"Agorà di Floridi","stages":[{"title":"Vero o Falso a raffica","presentation":"rush","timeLimitSec":15,"pick":8,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Lezione 1 · slide 41-50","items":[{"id":"ago.tf.termostato","kind":"tf","prompt":"Un termostato è perfettamente razionale rispetto al suo obiettivo, eppure nessuno lo definirebbe intelligente.","answer":true,"explain":"La razionalità può essere necessaria, ma non sufficiente, per l'intelligenza."},{"id":"ago.tf.sufficiente","kind":"tf","prompt":"La razionalità è una condizione sufficiente per l'intelligenza.","answer":false,"explain":"Altrimenti ogni algoritmo di ottimizzazione sarebbe intelligente."},{"id":"ago.tf.simon","kind":"tf","prompt":"Secondo Herbert Simon, gli esseri umani sono agenti a razionalità limitata.","answer":true,"explain":"Gli esseri umani sono intelligenti ma non pienamente razionali."},{"id":"ago.tf.dijkstra","kind":"tf","prompt":"L'algoritmo di Dijkstra calcola una soluzione ottimale, quindi va considerato intelligente.","answer":false,"explain":"È perfettamente razionale, ma non gli attribuiamo intelligenza."},{"id":"ago.tf.formalizzabile","kind":"tf","prompt":"La razionalità è osservabile e formalizzabile; l'intelligenza molto meno.","answer":true,"explain":"Per questo, in questo senso, «l'Intelligenza Artificiale non esiste»."},{"id":"ago.tf.capability","kind":"tf","prompt":"Per Floridi, «zero intelligence» significa anche «zero capability».","answer":false,"explain":"Zero intelligence NON significa zero capability."},{"id":"ago.tf.agency","kind":"tf","prompt":"Secondo Floridi, un sistema può avere agency senza avere intelligence.","answer":true,"explain":"Una lavastoviglie lava i piatti meglio di noi senza bisogno di intelligenza."},{"id":"ago.tf.envelope","kind":"tf","prompt":"L'environmental envelope consiste nel rendere le macchine capaci di adattarsi a qualsiasi complessità dell'ambiente.","answer":false,"explain":"È il contrario: adattiamo l'ambiente alle capacità della macchina."},{"id":"ago.tf.guida","kind":"tf","prompt":"Con sensori, GPS, mappe digitali e segnaletica standardizzata abbiamo, in parte, reso il mondo più semplice per l'auto.","answer":true,"explain":"È l'alternativa (2) dell'esempio della guida automatica."},{"id":"ago.tf.ottimizzare","kind":"tf","prompt":"L'intelligenza è semplicemente la capacità di ottimizzare un obiettivo.","answer":false,"explain":"Altrimenti ogni algoritmo di ottimizzazione sarebbe intelligente."},{"id":"ago.tf.sociotecnico","kind":"tf","prompt":"L'unità di progettazione non è più soltanto l'AI, ma il sistema socio-tecnico in cui opera.","answer":true,"explain":"Lavorare nell'IA significa progettare il mondo in cui umani e sistemi artificiali convivono."},{"id":"ago.tf.treccani","kind":"tf","prompt":"Per la Treccani, razionalità è la capacità di pensare, giudicare e agire in modo coerente rispetto ai fini prefissati.","answer":true,"explain":"Definizione di «razionale» del Vocabolario Treccani."},{"id":"ago.tf.mccarthy","kind":"tf","prompt":"L'agentività artificiale di oggi va nella stessa direzione dell'idea originaria di McCarthy et al.","answer":false,"explain":"Va di fatto in contrasto: modifichiamo il mondo affinché l'agente possa operarvi."}]},{"title":"Il dibattito finale","presentation":"battle","pick":2,"ref":"Lezione 1 · slide 47-50","items":[{"id":"ago.q.domanda","kind":"mcq","prompt":"Alla fine della Lezione 1, come si sposta la domanda centrale dell'IA?","options":["Da «quanto possiamo rendere intelligente una macchina?» a «come distribuire capacità e responsabilità tra esseri umani, macchine e ambiente?»","Da «come distribuire responsabilità?» a «quanto possiamo rendere intelligente una macchina?»","Da «le macchine pensano?» a «le macchine sono coscienti?»","Da «cos'è l'intelligenza?» a «quanti parametri servono?»"],"answer":0,"explain":"Il limite dell'IA diventa un problema di progettazione, non solo tecnologico."},{"id":"ago.q.envelope","kind":"mcq","prompt":"Nell'esempio della guida automatica, quale alternativa corrisponde all'environmental envelope?","options":["Costruire l'intelligenza nella macchina e nell'ambiente: sensori, GPS, mappe, segnaletica, infrastrutture","Costruire un robot umanoide capace di guidare qualsiasi auto progettata per esseri umani","Vietare la guida agli esseri umani","Addestrare l'auto solo in simulazione"],"answer":0,"explain":"È diventata più intelligente la macchina, o abbiamo reso il mondo più semplice per la macchina?"},{"id":"ago.q.umano","kind":"mcq","prompt":"Che differenza c'è tra intelligenza umana e agentività artificiale, secondo quanto visto nel corso?","options":["L'umano si adatta al mondo e, se serve, lo modifica; per l'agente artificiale sempre più spesso modifichiamo il mondo affinché possa operarvi","Nessuna: entrambe si adattano allo stesso modo","L'agente artificiale si adatta al mondo meglio dell'umano","L'umano modifica sempre il mondo, l'agente artificiale mai"],"answer":0,"explain":"Per questo l'IA va, di fatto, in contrasto con l'idea originaria di McCarthy."}]}]},{"id":"laboratorio","name":"Laboratorio dell'Aspirapolvere","stages":[{"title":"Programma l'aspirapolvere","presentation":"vacuum","instructions":"Per ogni percezione [stanza, stato] scegli l'azione dell'agente reattivo semplice. Poi guarda il robot all'opera!","ref":"Lezione 2 · slide 7, 21","items":[{"id":"lab.vacuum.tabella","kind":"matrix","weight":2,"keepOrder":true,"prompt":"Tabella percezione → azione","cols":[{"label":"Azione","options":["Aspira","Destra","Sinistra","Nessuna azione"]}],"rows":[{"label":"[A, Pulito]","answers":[1]},{"label":"[A, Sporco]","answers":[0]},{"label":"[B, Pulito]","answers":[2]},{"label":"[B, Sporco]","answers":[0]}],"explain":"Funzione agente: se il riquadro corrente è sporco, aspira; altrimenti muoviti nell'altro riquadro."}]},{"title":"Il glossario del laboratorio","presentation":"connect","instructions":"Collega ogni termine alla sua definizione.","ref":"Lezione 2 · slide 4-6, 18","items":[{"id":"lab.match.glossario","kind":"match","weight":2,"prompt":"Termine → definizione","leftTitle":"Termine","rightTitle":"Definizione","pairs":[["Percezione","Insieme degli input percettivi dell'agente in un dato istante"],["Sequenza percettiva","Storia completa di tutto ciò che l'agente ha percepito"],["Funzione agente","Corrispondenza tra qualsiasi sequenza percettiva e un'azione"],["Programma agente","Implementazione che riceve la percezione corrente e restituisce un'azione"],["Architettura","Il computer dotato di sensori e attuatori su cui gira il programma"]],"explain":"Agente = architettura + programma. Il programma implementa la funzione agente."}]},{"title":"Collaudo finale","presentation":"battle","pick":4,"ref":"Lezione 2 · slide 18-26","items":[{"id":"lab.q.righe","kind":"mcq","prompt":"Sia P l'insieme delle percezioni possibili e T la durata di vita dell'agente. Quante righe ha la tabella di un AGENTE-CON-TABELLA?","options":["Σ_{t=1..T} |P|^t","|P| · T","|P|^2","T!"],"answer":0,"explain":"Per gli scacchi sarebbero circa 10^150 righe, contro meno di 10^80 atomi nell'universo."},{"id":"lab.q.agente","kind":"mcq","prompt":"Completa: agente = ...","options":["architettura + programma","sensori + ambiente","funzione agente + tabella","percezione + azione"],"answer":0,"explain":"L'architettura è il computer con sensori e attuatori; il programma implementa la funzione agente."},{"id":"lab.q.cicli","kind":"mcq","prompt":"Cosa può succedere a un agente reattivo semplice in un ambiente parzialmente osservabile?","options":["Può incappare in cicli infiniti; una componente casuale può aiutare a evitarli","Diventa automaticamente un agente basato su modello","Funziona meglio che in un ambiente completamente osservabile","Smette di usare le regole condizione-azione"],"answer":0,"explain":"Un agente reattivo semplice funziona bene solo se l'ambiente è completamente osservabile."},{"id":"lab.q.casuale","kind":"mcq","prompt":"La componente casuale aggiunta a un agente reattivo semplice...","options":["Serve solo a evitare cicli infiniti, ma non «crea» intelligenza","Lo rende pienamente razionale","Sostituisce le regole condizione-azione","Gli fornisce un modello del mondo"],"answer":0,"explain":"Attenzione: la casualità qui non genera comportamento razionale."},{"id":"lab.q.modello","kind":"mcq","prompt":"Per un agente basato su modello, «se vado a destra da A arrivo in B» è...","options":["Il modello (una funzione di transizione)","Lo stato interno","Una regola condizione-azione","La misura di prestazione"],"answer":0,"explain":"«B non è pulita» è lo stato interno; «se vado a destra da A arrivo in B» è il modello."},{"id":"lab.q.stato","kind":"mcq","prompt":"La variabile «stato» di un agente reattivo basato su modello...","options":["È la migliore ipotesi dell'agente sullo stato del mondo, non necessariamente esatta","Rappresenta sempre con esattezza lo stato del mondo","Contiene l'intera tabella delle azioni","Viene azzerata a ogni percezione"],"answer":0,"explain":"Lo stato è la concezione corrente del mondo da parte dell'agente."},{"id":"lab.q.programma","kind":"mcq","prompt":"Qual è la differenza tra programma agente e funzione agente?","options":["Il programma prende in input solo la percezione corrente, la funzione l'intera storia percettiva","Il programma prende l'intera storia percettiva, la funzione solo la percezione corrente","Non c'è differenza: sono sinonimi","La funzione gira sull'hardware, il programma è solo teorico"],"answer":0,"explain":"La sfida dell'IA: comportamento razionale con poco codice, non con la rappresentazione di tutti gli input possibili."}]}]},{"id":"agenzia","name":"Agenzia PEAS","stages":[{"title":"Il fascicolo del taxi","presentation":"bins","instructions":"Archivia ogni elemento del taxi autonomo nella cartella PEAS corretta.","ref":"Lezione 2 · slide 11","items":[{"id":"age.cat.taxi","kind":"categorize","weight":3,"prompt":"Guidatore di taxi: elemento → componente PEAS","categories":["P · Misura di prestazione","E · Ambiente","A · Attuatori","S · Sensori"],"entries":[{"label":"Sicuro, veloce, ligio alla legge","cat":0},{"label":"Viaggio confortevole, profitti massimi","cat":0},{"label":"Strada","cat":1},{"label":"Altri veicoli nel traffico, pedoni","cat":1},{"label":"Clienti","cat":1},{"label":"Sterzo, acceleratore, freni","cat":2},{"label":"Frecce, clacson, schermo di interfaccia","cat":2},{"label":"Telecamere","cat":3},{"label":"Tachimetro, GPS, contachilometri","cat":3},{"label":"Accelerometro, sensori sullo stato del motore, tastiera","cat":3}],"explain":"PEAS = Performance, Environment, Actuators, Sensors."}]},{"title":"Clienti dell'agenzia","presentation":"connect","instructions":"Collega ogni agente alla sua misura di prestazione.","ref":"Lezione 2 · slide 12","items":[{"id":"age.match.misure","kind":"match","weight":2,"prompt":"Agente → misura di prestazione","leftTitle":"Agente","rightTitle":"Misura di prestazione","pairs":[["Sistema di diagnosi medica","Paziente sano, minimizzare costi e denunce"],["Analisi di immagini satellitari","Categorizzazione corretta delle immagini"],["Robot selezionatore di parti meccaniche","Percentuale di pezzi inseriti nei contenitori giusti"],["Tutor interattivo per l'inglese","Risultati del test dello studente"]],"explain":"La misura di prestazione si progetta sull'effetto desiderato nell'ambiente."}]},{"title":"Interrogatorio dell'Agente Speciale","presentation":"battle","pick":3,"ref":"Lezione 2 · slide 4-11","items":[{"id":"age.q.fattori","kind":"mcq","prompt":"Da quali quattro fattori dipende la razionalità di un agente?","options":["Misura di prestazione, conoscenza pregressa, azioni possibili, sequenza percettiva fino all'istante corrente","Sensori, attuatori, ambiente, obiettivi","Velocità, memoria, energia, costo","Tabella, regole, modello, utilità"],"answer":0,"explain":"Come un agente umano: razionale rispetto a conoscenze, obiettivo e contesto."},{"id":"age.q.misura","kind":"mcq","prompt":"Come regola generale, come va progettata la misura di prestazione?","options":["In base all'effetto che si desidera osservare sull'ambiente, non su come dovrebbe comportarsi l'agente","In base a come dovrebbe comportarsi l'agente, passo dopo passo","In base alla velocità di calcolo dell'agente","In modo che l'agente ottenga sempre il punteggio massimo"],"answer":0,"explain":"Altrimenti l'agente otterrebbe una razionalità perfetta semplicemente «illudendosi» di fare la cosa giusta."},{"id":"age.q.onniscienza","kind":"mcq","prompt":"Razionalità significa onniscienza?","options":["No: un agente razionale massimizza il risultato atteso, non conosce l'esito effettivo delle sue azioni","Sì: un agente razionale conosce sempre l'esito delle sue azioni","Sì, ma solo negli ambienti deterministici","No, perché la razionalità riguarda solo gli esseri umani"],"answer":0,"explain":"Nel mondo reale l'onniscienza è impossibile. Razionalità ≠ perfezione."},{"id":"age.q.gathering","kind":"mcq","prompt":"Guardare a destra e a sinistra prima di attraversare la strada è un esempio di...","options":["Information gathering","Onniscienza","Agente basato sull'utilità","Agente reattivo semplice"],"answer":0,"explain":"Azioni il cui unico scopo è raccogliere informazioni e modificare le percezioni future. L'esplorazione ne è un altro esempio."},{"id":"age.q.autonomia","kind":"mcq","prompt":"Un agente che agisce solo sulla base della conoscenza inserita in fase di progettazione, e non delle sue percezioni...","options":["Manca di autonomia","È onnisciente","È un agente capace di apprendere","È perfettamente razionale"],"answer":0,"explain":"L'apprendimento permette di imparare coppie percezione-azione dai risultati ottenuti."},{"id":"age.q.ambiente","kind":"mcq","prompt":"Nel corso, un ambiente è essenzialmente...","options":["Un'istanza di un problema di cui gli agenti razionali rappresentano le soluzioni","L'insieme dei sensori di un agente","Il programma che implementa la funzione agente","La misura di prestazione dell'agente"],"answer":0,"explain":"Un ambiente si descrive con la formulazione PEAS."},{"id":"age.q.software","kind":"mcq","prompt":"Per un agente software, quale di questi è un ATTUATORE?","options":["Scrittura di file e invio di pacchetti di rete","Battute di tasti","Contenuto di file","Pacchetti di rete ricevuti"],"answer":0,"explain":"Battute di tasti, contenuto di file e pacchetti di rete ricevuti sono sensori."}]}]},{"id":"stazione","name":"Stazione Meteo degli Ambienti","stages":[{"title":"Il bollettino degli ambienti","presentation":"grid","instructions":"Clicca sulle caselle per scegliere la proprietà corretta di ogni ambiente (classificazione vista a lezione).","ref":"Lezione 2 · slide 17","items":[{"id":"sta.grid.ambienti","kind":"matrix","weight":4,"keepOrder":true,"prompt":"Classifica gli ambienti","cols":[{"label":"Osservabile","options":["Completamente","Parzialmente"]},{"label":"Agenti","options":["Singolo","Multi"]},{"label":"Deterministico","options":["Deterministico","Stocastico"]},{"label":"Episodico","options":["Episodico","Sequenziale"]},{"label":"Statico","options":["Statico","Dinamico","Semi"]},{"label":"Discreto","options":["Discreto","Continuo"]}],"rows":[{"label":"Cruciverba","answers":[0,0,0,1,0,0]},{"label":"Scacchi con orologio","answers":[0,1,0,1,2,0]},{"label":"Poker","answers":[1,1,1,1,0,0]},{"label":"Backgammon","answers":[0,1,1,1,0,0]},{"label":"Autista di taxi","answers":[1,1,1,1,1,null]},{"label":"Diagnosi medica","answers":[1,0,1,1,1,null]}],"explain":"Classificazione della tabella vista a lezione (Lezione 2)."}]},{"title":"Le domande del meteorologo","presentation":"battle","pick":4,"ref":"Lezione 2 · slide 13-16","items":[{"id":"sta.q.statico","kind":"mcq","prompt":"«Il mondo può cambiare mentre sto decidendo?» è la domanda che caratterizza la dimensione...","options":["Statico / dinamico","Episodico / sequenziale","Deterministico / stocastico","Osservabile"],"answer":0,"explain":"Statico: l'ambiente è invariato mentre l'agente delibera."},{"id":"sta.q.episodico","kind":"mcq","prompt":"«La decisione corrente influenza quelle future?» è la domanda che caratterizza la dimensione...","options":["Episodico / sequenziale","Statico / dinamico","Discreto / continuo","Singolo / multi-agente"],"answer":0,"explain":"Nel sequenziale (es. scacchi) una mossa modifica le possibilità successive."},{"id":"sta.q.semi","kind":"mcq","prompt":"Negli scacchi con orologio il mondo non cambia mentre penso, ma cambia la mia misura di prestazione. L'ambiente è...","options":["Semi-dinamico","Dinamico","Stocastico","Continuo"],"answer":0,"explain":"Semi-dinamico: l'ambiente non cambia col tempo, ma il punteggio delle prestazioni sì."},{"id":"sta.q.immagini","kind":"mcq","prompt":"Classificare un'immagine non dipende da come ho classificato la precedente. L'ambiente è quindi...","options":["Episodico","Sequenziale","Multi-agente","Parzialmente osservabile"],"answer":0,"explain":"Ogni episodio consiste in una singola azione che dipende solo dall'episodio stesso."},{"id":"sta.q.cooperativo","kind":"mcq","prompt":"Due agenti A e B puntano a massimizzare la stessa misura di prestazione. L'ambiente è...","options":["Cooperativo","Competitivo","Episodico","Deterministico"],"answer":0,"explain":"Competitivo: il comportamento di A massimizza/minimizza la misura di prestazione di B (e viceversa)."},{"id":"sta.q.backgammon","kind":"mcq","prompt":"Perché il backgammon è un ambiente stocastico?","options":["Perché il risultato del lancio dei dadi è incerto","Perché non vedo le pedine dell'avversario","Perché le mosse sono continue","Perché si gioca da soli"],"answer":0,"explain":"Stocastico: lo stato successivo non è completamente determinato da stato corrente e azione."},{"id":"sta.q.poker","kind":"mcq","prompt":"Perché il poker è parzialmente osservabile?","options":["Perché non vedo le carte degli avversari","Perché il mazzo cambia mentre penso","Perché le carte sono infinite","Perché si gioca con l'orologio"],"answer":0,"explain":"I sensori non danno accesso allo stato completo dell'ambiente."}]}]},{"id":"officina","name":"Officina degli Agenti","stages":[{"title":"Il nastro trasportatore","presentation":"bins","instructions":"Leggi la scheda di ogni agente e mettila nel reparto giusto.","ref":"Lezione 2 · slide 21-31","items":[{"id":"off.cat.tipi","kind":"categorize","weight":4,"prompt":"Descrizione → tipo di agente","categories":["Reattivo semplice","Reattivo basato su modello","Basato su obiettivi","Basato sull'utilità"],"entries":[{"label":"Vede sporco sotto di sé e aspira; vede pulito e si sposta. Non ricorda nulla.","cat":0},{"label":"Applica «if la-macchina-davanti-frena then inizia-a-frenare» alla sola percezione corrente.","cat":0},{"label":"È nella stanza A, pulita, ma ricorda che B non è ancora stata pulita: va in B.","cat":1},{"label":"Aggiorna uno stato interno con «come evolve il mondo» e «cosa fanno le mie azioni», poi applica regole condizione-azione.","cat":1},{"label":"Obiettivo: «tutte le stanze pulite». Da A ragiona su quale sequenza di azioni porta allo stato-obiettivo.","cat":2},{"label":"Si chiede «cosa accadrà se faccio così?» e distingue solo stati che raggiungono o meno l'obiettivo.","cat":2},{"label":"Tra un percorso da 5 minuti e 8% di batteria e uno da 8 minuti e 4%, sceglie bilanciando tempo, consumo e rumore.","cat":3},{"label":"Assegna a ogni stato un numero reale che ne quantifica la desiderabilità, per scegliere tra obiettivi in conflitto.","cat":3}],"explain":"Reattivo semplice: nessuna memoria. Basato su modello: stato interno. Obiettivi: stati buoni/cattivi. Utilità: grado di desiderabilità."}]},{"title":"Montaggio dell'agente che apprende","presentation":"connect","instructions":"Collega ogni componente dell'agente capace di apprendere alla sua funzione.","ref":"Lezione 2 · slide 32-33","items":[{"id":"off.match.componenti","kind":"match","weight":2,"prompt":"Componente → funzione","leftTitle":"Componente","rightTitle":"Funzione","pairs":[["Elemento di apprendimento","Responsabile del miglioramento interno"],["Elemento esecutivo","Seleziona le azioni esterne (ciò che finora chiamavamo agente)"],["Elemento critico","Fornisce feedback sulle prestazioni rispetto a uno standard"],["Generatore di problemi","Suggerisce azioni che portano a esperienze nuove e significative"]],"explain":"Il critico dà feedback, l'elemento di apprendimento decide come modificare l'esecutivo, il generatore di problemi spinge a esplorare."}]},{"title":"Il collaudo del meccanico","presentation":"battle","pick":2,"ref":"Lezione 2 · slide 1, 27-33","items":[{"id":"off.q.utilita","kind":"mcq","prompt":"Perché gli obiettivi da soli non bastano e serve una funzione di utilità?","options":["Gli obiettivi distinguono in modo binario stati «buoni» e «cattivi»; l'utilità misura il grado di desiderabilità","Gli obiettivi richiedono troppa memoria","L'utilità elimina la necessità di un modello del mondo","Gli obiettivi funzionano solo in ambienti continui"],"answer":0,"explain":"Nelle situazioni reali esistono stati più o meno desiderabili."},{"id":"off.q.obiettivi","kind":"mcq","prompt":"Le decisioni di un agente basato su obiettivi...","options":["Non si basano su regole condizione-azione esplicite, ma su come cambierà l'ambiente rispetto agli obiettivi","Si basano esclusivamente su regole condizione-azione","Ignorano l'effetto delle proprie azioni","Sono sempre casuali"],"answer":0,"explain":"Ricerca e pianificazione servono proprio a trovare sequenze di azioni che raggiungono gli obiettivi."},{"id":"off.q.apprendere","kind":"mcq","prompt":"Quale vantaggio offre l'apprendimento a un agente?","options":["Operare in ambienti inizialmente sconosciuti diventando col tempo più competente","Non avere più bisogno di sensori","Diventare onnisciente","Eliminare la misura di prestazione"],"answer":0,"explain":"È la base degli algoritmi di machine learning della seconda parte del corso."},{"id":"off.q.antropo","kind":"mcq","prompt":"Ripensare l'«intelligenza» in termini di «agentività» aiuta soprattutto a evitare...","options":["L'antropomorfizzazione dei sistemi di IA","L'uso di sensori","Gli ambienti stocastici","La formulazione PEAS"],"answer":0,"explain":"La domanda diventa: cosa sa fare, con quali strumenti, entro quali vincoli e con quale autonomia?"}]}]}],"bossPool":[{"id":"boss1.regole","kind":"mcq","prompt":"Quante regole condizione-azione servono a un agente reattivo semplice per coprire tutte le percezioni del mondo dell'aspirapolvere?","options":["4","2","8","4^T"],"answer":0,"explain":"Ignorando la storia percettiva, bastano le 4 percezioni [stanza, stato].","ref":"Lezione 2 · slide 21"},{"id":"boss1.coppia","kind":"mcq","prompt":"Quale coppia di affermazioni è corretta?","options":["La razionalità può essere necessaria ma non sufficiente per l'intelligenza; gli umani sono intelligenti ma a razionalità limitata","La razionalità implica l'intelligenza; gli umani sono pienamente razionali","L'intelligenza implica la perfetta razionalità; il termostato è intelligente","Razionalità e intelligenza coincidono; Dijkstra è intelligente"],"answer":0,"explain":"Termostato e Dijkstra sono razionali ma non intelligenti; Simon: razionalità limitata.","ref":"Lezione 1 · slide 43"},{"id":"boss1.ruoloA","kind":"mcq","prompt":"Nel gioco dell'imitazione con la macchina, la macchina ricopre il ruolo di...","options":["A, l'imitatore che deve rispondere come se fosse B","B, che aiuta C nell'identificazione","C, l'interrogante","Un arbitro esterno alle due stanze"],"answer":0,"explain":"La macchina prende il posto dell'uomo (A).","ref":"Lezione 1 · slide 33"},{"id":"boss1.pr","kind":"mcq","prompt":"Quale definizione appartiene al quadrante «Pensare razionalmente»?","options":["Lo studio dei processi di calcolo che rendono possibile percepire, ragionare e agire","L'arte di creare macchine che eseguono attività che richiedono intelligenza quando svolte da persone","L'IA riguarda il comportamento intelligente negli artefatti","Il tentativo di far sì che i computer arrivino a pensare"],"answer":0,"explain":"Le altre sono: agire umanamente, agire razionalmente, pensare umanamente.","ref":"Lezione 1 · slide 20"},{"id":"boss1.ar","kind":"mcq","prompt":"Quale definizione appartiene al quadrante «Agire razionalmente»?","options":["L'Intelligenza Computazionale è lo studio della progettazione di agenti intelligenti","Lo studio delle facoltà mentali attraverso l'uso di modelli computazionali","Lo studio di come far eseguire ai computer le attività in cui le persone sono più brave","L'automazione delle attività che associamo al pensiero umano"],"answer":0,"explain":"Le altre sono: pensare razionalmente, agire umanamente, pensare umanamente.","ref":"Lezione 1 · slide 20"},{"id":"boss1.taxi","kind":"mcq","prompt":"Secondo la classificazione vista nel corso, quale combinazione descrive l'ambiente dell'autista di taxi?","options":["Parzialmente osservabile, multi-agente, stocastico, sequenziale, dinamico","Completamente osservabile, singolo agente, deterministico, episodico, statico","Parzialmente osservabile, singolo agente, stocastico, episodico, dinamico","Parzialmente osservabile, multi-agente, deterministico, sequenziale, semi-dinamico"],"answer":0,"explain":"Tabella delle proprietà degli ambienti.","ref":"Lezione 2 · slide 17"},{"id":"boss1.diagnosi","kind":"mcq","prompt":"Secondo la classificazione vista nel corso, in quale dimensione la diagnosi medica differisce dall'autista di taxi?","options":["Agenti: singolo invece che multi","Osservabile: completamente invece che parzialmente","Deterministico invece che stocastico","Episodico invece che sequenziale"],"answer":0,"explain":"Per il resto le due righe coincidono.","ref":"Lezione 2 · slide 17"},{"id":"boss1.cruciscacchi","kind":"mcq","prompt":"In quali dimensioni differiscono il cruciverba e gli scacchi con orologio?","options":["Agenti (singolo/multi) e Statico (statico/semi-dinamico)","Osservabile e Deterministico","Episodico e Discreto","Deterministico e Agenti"],"answer":0,"explain":"Entrambi sono completamente osservabili, deterministici, sequenziali e discreti.","ref":"Lezione 2 · slide 17"},{"id":"boss1.pokerback","kind":"mcq","prompt":"In quale dimensione differiscono il poker e il backgammon, secondo la classificazione vista nel corso?","options":["Osservabilità: il poker è parzialmente osservabile, il backgammon completamente","Agenti: il poker è a singolo agente","Determinismo: il backgammon è deterministico","Il poker è dinamico, il backgammon statico"],"answer":0,"explain":"Entrambi sono multi-agente, stocastici, sequenziali, statici e discreti.","ref":"Lezione 2 · slide 17"},{"id":"boss1.conflitto","kind":"mcq","prompt":"In presenza di più obiettivi tra loro contrastanti, un agente basato sull'utilità...","options":["Usa il punteggio della funzione di utilità per decidere quale obiettivo preferire","Sceglie un obiettivo a caso","Si blocca finché un obiettivo non viene rimosso","Torna a comportarsi come un agente reattivo semplice"],"answer":0,"explain":"La funzione di utilità assegna a ogni stato un numero reale di desiderabilità.","ref":"Lezione 2 · slide 29"},{"id":"boss1.critico","kind":"mcq","prompt":"In un agente capace di apprendere, chi determina se e come modificare l'elemento esecutivo?","options":["L'elemento di apprendimento, sulla base del feedback dell'elemento critico","Il generatore di problemi, da solo","L'elemento esecutivo stesso","Lo standard di prestazione"],"answer":0,"explain":"Il critico confronta con lo standard e fornisce feedback; l'elemento di apprendimento produce i cambiamenti.","ref":"Lezione 2 · slide 32-33"},{"id":"boss1.illudersi","kind":"mcq","prompt":"Perché è pericoloso progettare la misura di prestazione su come l'agente «dovrebbe comportarsi»?","options":["Perché l'agente otterrebbe una razionalità perfetta semplicemente «illudendosi» di fare la cosa giusta","Perché l'agente diventerebbe troppo lento","Perché servirebbero troppi sensori","Perché la misura diventerebbe stocastica"],"answer":0,"explain":"La misura si progetta sull'effetto desiderato nell'ambiente.","ref":"Lezione 2 · slide 8"},{"id":"boss1.righe84","kind":"mcq","prompt":"Un AGENTE-CON-TABELLA ha |P| = 4 percezioni possibili e vive T = 3 istanti. Quante righe ha la sua tabella?","options":["84","12","64","81"],"answer":0,"explain":"Σ_{t=1..3} 4^t = 4 + 16 + 64 = 84.","ref":"Lezione 2 · slide 20"},{"id":"boss1.craik","kind":"mcq","prompt":"Cosa permette, secondo Craik, il «modello in scala» della realtà nella testa di un organismo?","options":["Provare alternative, scegliere la migliore e reagire a situazioni future prima che si manifestino","Ricordare perfettamente ogni percezione passata","Comunicare con gli altri organismi","Evitare di dover agire nell'ambiente"],"answer":0,"explain":"Il professore la considera probabilmente la miglior definizione di IA che potrete mai avere.","ref":"Lezione 1 · slide 24"},{"id":"boss1.wienerfacolta","kind":"mcq","prompt":"Quale facoltà della definizione Treccani intercetta soprattutto la cibernetica?","options":["Adattarsi a situazioni nuove e modificare la situazione stessa","Intendere e farsi intendere","Elaborare modelli astratti della realtà","Giudicare"],"answer":0,"explain":"La cibernetica studia come un comportamento adattivo possa emergere tramite feedback.","ref":"Lezione 1 · slide 12"},{"id":"boss1.zero","kind":"mcq","prompt":"«Artificial Intelligence = Zero Intelligence» (Floridi) significa che...","options":["I sistemi possono avere grandi capacità di agire senza bisogno di postulare intelligenza","I sistemi di IA non hanno alcuna capacità pratica","L'IA è inutile e va abbandonata","Solo i sistemi con zero parametri sono affidabili"],"answer":0,"explain":"Zero intelligence NON significa zero capability.","ref":"Lezione 1 · slide 46"},{"id":"boss1.completo","kind":"mcq","prompt":"Quando abbiamo descritto un agente in modo completo?","options":["Quando abbiamo specificato l'azione scelta per ogni possibile sequenza percettiva","Quando conosciamo i suoi sensori","Quando conosciamo la sua misura di prestazione","Quando l'agente ha visitato tutto l'ambiente"],"answer":0,"explain":"Il comportamento è descritto dalla funzione agente.","ref":"Lezione 2 · slide 6"},{"id":"boss1.dipende","kind":"mcq","prompt":"La scelta di un'azione da parte dell'agente, in un qualsiasi istante, può dipendere da...","options":["L'intera sequenza percettiva osservata fino a quel momento, ma non da ciò che non ha percepito","Solo l'ultima percezione, sempre","Qualsiasi informazione, anche non percepita","Solo dalla conoscenza del progettista"],"answer":0,"explain":"L'agente non può basarsi su ciò che non ha percepito.","ref":"Lezione 2 · slide 6"},{"id":"boss1.esplorazione","kind":"mcq","prompt":"Cos'è l'esplorazione, nel senso visto nel corso?","options":["Una forma di information gathering per conoscere un ambiente sconosciuto, rilevante per gli algoritmi di ricerca","Un sinonimo di apprendimento supervisionato","La componente casuale di un agente reattivo semplice","Una proprietà degli ambienti dinamici"],"answer":0,"explain":"È l'azione necessaria per far «conoscenza» di un ambiente sconosciuto.","ref":"Lezione 2 · slide 9"},{"id":"boss1.ingsw","kind":"mcq","prompt":"Secondo la Lezione 1, perché l'Ingegneria del Software è «l'unica ragione per cui parliamo oggi di IA»?","options":["Perché l'unità di progettazione non è più solo l'AI, ma il sistema socio-tecnico in cui opera","Perché i modelli di IA sono scritti in Python","Perché senza test unitari un modello non apprende","Perché l'IA è nata in un dipartimento di Ingegneria del Software"],"answer":0,"explain":"Progettiamo il mondo nel quale esseri umani e sistemi artificiali dovranno convivere.","ref":"Lezione 1 · slide 50"},{"id":"boss1.mappa","kind":"mcq","prompt":"Quale di queste NON compare tra le aree dell'IA nella mappa riassuntiva di fine Lezione 2?","options":["Compilatori ottimizzanti","Constraint Satisfaction Problems","Meta-heuristics","Game Theory"],"answer":0,"explain":"La mappa include NLP, ricerca, meta-euristiche, teoria dei giochi, ML, CSP, reasoning, planning...","ref":"Lezione 2 · slide 34"},{"id":"boss1.atteso","kind":"mcq","prompt":"Per ogni sequenza di percezioni, un agente razionale dovrebbe scegliere l'azione che...","options":["Massimizza il valore atteso della misura di prestazione, data la sequenza percettiva e la sua conoscenza","Minimizza il numero di azioni eseguite","Imita il comportamento di un essere umano","È stata eseguita più spesso in passato"],"answer":0,"explain":"Definizione di agente razionale.","ref":"Lezione 2 · slide 8"},{"id":"boss1.agentivita","kind":"mcq","prompt":"Che cosa cambia parlando di «agentività» invece che di «intelligenza»?","options":["La domanda passa da «quanto è intelligente?» a «cosa sa fare, con quali strumenti, entro quali vincoli e con quale autonomia?»","Si ammette che le macchine siano coscienti","Si smette di valutare le prestazioni dei sistemi","Si torna alla definizione di Turing"],"answer":0,"explain":"Evita l'antropomorfizzazione e dà il giusto peso a strumenti potenti.","ref":"Lezione 2 · slide 1"},{"id":"boss1.sinapsi","kind":"mcq","prompt":"Secondo le neuroscienze viste a lezione, su cosa si ritiene si basi l'apprendimento?","options":["Sui cambiamenti a lungo termine nelle connessioni tra neuroni","Sul numero totale di neuroni, che cresce con lo studio","Sulla velocità di un singolo ciclo neuronale","Sull'introspezione"],"answer":0,"explain":"I segnali si propagano tra neuroni tramite sinapsi; i cambiamenti a lungo termine sono la base dell'apprendimento.","ref":"Lezione 1 · slide 27"},{"id":"boss1.sensorirobot","kind":"mcq","prompt":"Per il robot selezionatore di parti meccaniche, quale elemento appartiene ai SENSORI?","options":["Telecamera e sensori di posizionamento del braccio","Braccio meccanico con manipolatore","Nastro trasportatore con parti e contenitori","Percentuale di pezzi nei contenitori giusti"],"answer":0,"explain":"Gli altri sono, rispettivamente, attuatori, ambiente e misura di prestazione.","ref":"Lezione 2 · slide 12"},{"id":"boss1.nome","kind":"mcq","prompt":"Cosa è successo al Dartmouth Summer Research Project del 1956?","options":["La disciplina ha ricevuto un nome prima di avere una definizione condivisa di intelligenza","È stata data la definizione definitiva di intelligenza","È stato costruito il primo agente razionale","È stato superato per la prima volta il test di Turing"],"answer":0,"explain":"Lì nasce l'etichetta disciplinare, non l'idea di costruire macchine sofisticate.","ref":"Lezione 1 · slide 18"}]},{"id":"L2","name":"Borgo dell'Apprendimento","implemented":true,"buildings":[{"id":"accademia","name":"Accademia dell'Agente che Apprende","stages":[{"title":"Le quattro domande dell'agente","presentation":"connect","instructions":"Collega ogni componente dell'agente che apprende alla domanda che si pone. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 3 · slide 3-4","items":[{"id":"acc.match.componenti","kind":"match","weight":3,"prompt":"Componente → la domanda da farsi","leftTitle":"Componente","rightTitle":"Domanda","pairs":[["Elemento esecutivo","Cosa faccio?"],["Elemento critico","Come sto andando?"],["Elemento di apprendimento","Come posso migliorare?"],["Generatore di problemi","Cosa potrei provare di nuovo?"]],"explain":"L'esecutivo sceglie le azioni, il critico le confronta con uno standard di prestazione, l'elemento di apprendimento usa il feedback per migliorare l'esecutivo, il generatore di problemi suggerisce esperienze nuove."}]},{"title":"Smista gli scenari","presentation":"bins","instructions":"Per ogni scenario, scegli il tipo di apprendimento. Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 3 · slide 8-11","items":[{"id":"acc.cat.tipi","kind":"categorize","weight":3,"prompt":"Scenario → tipo di apprendimento","categories":["Supervisionato","Non supervisionato","Semi-supervisionato","Per rinforzo"],"entries":[{"label":"Un filtro impara da migliaia di e-mail già etichettate come spam o no-spam","cat":0},{"label":"Si stima il prezzo di una casa da esempi in cui il prezzo è noto","cat":0},{"label":"Si cercano gruppi di clienti simili senza sapere in anticipo quali gruppi esistano","cat":1},{"label":"Solo una piccola parte delle foto è etichettata e l'agente deve dedurre le etichette mancanti","cat":2},{"label":"Un robot compie una sequenza di mosse e alla fine riceve una ricompensa","cat":3},{"label":"Un agente impara a giocare ricevendo un premio quando vince la partita","cat":3}],"explain":"Supervisionato: dati etichettati. Non supervisionato: nessuna etichetta. Semi-supervisionato: solo alcune etichette. Per rinforzo: azioni in sequenza e ricompensa al termine."}]},{"title":"Sfida della Rettrice","presentation":"battle","pick":4,"ref":"Lezione 3 · slide 4-11","items":[{"id":"acc.q.generatore","kind":"mcq","prompt":"Che cosa fa il generatore di problemi dell'aspirapolvere che ha sempre seguito A→B→A→B?","options":["Suggerisce di provare un comportamento diverso, per verificare se porta a prestazioni migliori","Segnala gli errori commessi dall'elemento esecutivo","Confronta il comportamento con lo standard di prestazione","Modifica direttamente le regole dell'elemento esecutivo"],"answer":0,"explain":"Non genera «problemi» nel senso di errori: suggerisce azioni esplorative che producono nuove esperienze."},{"id":"acc.q.exploration","kind":"mcq","prompt":"Quale componente dell'agente che apprende introduce l'exploration?","options":["Il generatore di problemi","L'elemento critico","L'elemento esecutivo","I sensori"],"answer":0,"explain":"Il generatore di problemi spinge a provare azioni nuove o poco conosciute invece di usare solo ciò che si sa già."},{"id":"acc.q.exploitation","kind":"mcq","prompt":"Che cosa si intende per exploitation?","options":["Scegliere l'azione che, sulla base delle conoscenze attuali, si ritiene migliore","Provare azioni nuove per acquisire informazioni","Sfruttare un errore dell'ambiente per ottenere più ricompensa","Eliminare dalla memoria le esperienze negative"],"answer":0,"explain":"Exploitation: usare ciò che si è già appreso. Exploration: provare il nuovo per scoprire se va meglio."},{"id":"acc.q.tpe","kind":"mcq","prompt":"Nel filtro anti-spam visto a lezione, che cosa rappresenta E?","options":["Il database di e-mail etichettate come spam o no-spam","La percentuale di e-mail spam filtrate correttamente","Identificare le e-mail che l'utente non vuole ricevere","Il server di posta elettronica"],"answer":0,"explain":"T è il task (identificare lo spam), P la misura di prestazione (% di spam filtrate correttamente), E l'esperienza (le e-mail etichettate)."},{"id":"acc.q.definizione","kind":"mcq","prompt":"Quale definizione di apprendimento è stata data a lezione?","options":["Qualunque processo tramite il quale un sistema migliora le sue prestazioni sulla base dell'esperienza","La capacità di memorizzare tutti i dati di addestramento","L'esecuzione corretta di comandi espliciti scritti dal programmatore","Il passaggio da un ambiente stocastico a uno deterministico"],"answer":0,"explain":"Più tecnicamente: migliorare nel task T, rispetto alla misura di prestazione P, sulla base dell'esperienza E."},{"id":"acc.q.popolarita","kind":"mcq","prompt":"Quali due fattori hanno reso popolare il machine learning nell'ultimo decennio?","options":["La disponibilità dei dati e di strumenti computazionali adeguati","L'invenzione della regressione e del test di Turing","La fine della programmazione classica e dei database","Le leggi di Lehman e il modello a cascata"],"answer":0,"explain":"Il ML ha una lunga storia (Gauss, la regressione già nel 1800), ma è esploso con dati e potenza di calcolo."},{"id":"acc.q.etichette","kind":"mcq","prompt":"Nell'apprendimento supervisionato, che cosa determinano le etichette?","options":["La variabile dipendente, cioè ciò che l'agente dovrà apprendere","Il numero di feature da usare","L'algoritmo di apprendimento da scegliere","La ricompensa ricevuta al termine di una sequenza"],"answer":0,"explain":"Per ogni osservazione, oltre ai dati di input, è noto il valore della variabile dipendente fornito dal progettista."}]}]},{"id":"mercato","name":"Mercato dei Problemi","stages":[{"title":"Le bancarelle dell'output","presentation":"bins","instructions":"Porta ogni problema alla bancarella giusta, in base all'output che si vuole ottenere.","ref":"Lezione 3 · slide 12-13","items":[{"id":"mer.cat.problemi","kind":"categorize","weight":3,"prompt":"Problema → tipo di problema","categories":["Regressione","Classificazione","Clustering","Mining di associazioni"],"entries":[{"label":"Stimare lo stipendio di una persona in base al titolo di studio","cat":0},{"label":"Stimare l'altezza di una persona da peso, genere ed età","cat":0},{"label":"Valutare se una e-mail è spam in base al suo oggetto","cat":1},{"label":"Decidere se un frutto è una mela, una banana o una pera","cat":1},{"label":"Scoprire se esistono gruppi di utenti web con comportamento simile","cat":2},{"label":"Market basket analysis: chi compra il pane compra spesso anche il latte","cat":3}],"explain":"Output continuo → regressione; discreto → classificazione; gruppi → clustering; pattern comuni nelle transazioni → mining di associazioni."}]},{"title":"La mappa degli algoritmi","presentation":"connect","instructions":"Collega ogni algoritmo alla famiglia di problemi in cui è stato presentato. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 3 · slide 14","items":[{"id":"mer.match.algoritmi","kind":"match","weight":3,"prompt":"Algoritmo → famiglia","leftTitle":"Algoritmo","rightTitle":"Famiglia","pairs":[["K-means","Clustering"],["PCA","Riduzione della dimensionalità"],["Naive Bayes","Classificazione"],["Regressione polinomiale","Regressione"],["Apriori","Association analysis"]],"explain":"Supervisionati: regressione (lineare, polinomiale) e classificazione (KNN, alberi, logistic regression, Naive Bayes, SVM). Non supervisionati: clustering e riduzione (SVD, PCA, K-means) e association analysis (Apriori, FP-Growth)."}]},{"title":"Trattativa col Mercante","presentation":"battle","pick":3,"ref":"Lezione 3 · slide 12-15","items":[{"id":"mer.q.migliore","kind":"mcq","prompt":"Come si sceglie, in pratica, l'algoritmo da usare per un problema?","options":["Con il metodo empirico: si costruiscono più modelli, si misura l'errore di ciascuno e si sceglie il migliore","Si usa sempre l'algoritmo più recente","Si sceglie l'algoritmo con più parametri","La teoria indica sempre un unico algoritmo ottimo"],"answer":0,"explain":"La teoria aiuta a caratterizzare il problema e a fare una prima selezione; la misura dell'errore fornisce la base di confronto."},{"id":"mer.q.primo","kind":"mcq","prompt":"Prima di scegliere un algoritmo, che cosa è importante fare?","options":["Caratterizzare il problema, per esempio capire se è un problema supervisionato di classificazione","Raccogliere più feature possibili, anche irrilevanti","Scegliere il linguaggio di programmazione","Bilanciare il dataset con l'oversampling"],"answer":0,"explain":"Prima si capisce di che problema si tratta, poi si valutano gli algoritmi adatti."},{"id":"mer.q.dimensionalita","kind":"mcq","prompt":"A che cosa serve la riduzione della dimensionalità?","options":["A ridurre le caratteristiche significative ed eliminare quelle ridondanti in un vasto insieme di dati","A ridurre il numero di righe del dataset","A trasformare un problema di regressione in uno di classificazione","A trovare pattern comuni nelle transazioni"],"answer":0,"explain":"Esempi visti: SVD e PCA."},{"id":"mer.q.output","kind":"mcq","prompt":"Che cosa si intende per «output» quando si distinguono regressione e classificazione?","options":["Il range di valori che la variabile dipendente potrà assumere","Il numero di feature in ingresso","Il formato del file in cui si salvano le predizioni","Il tempo di addestramento del modello"],"answer":0,"explain":"Range continuo → regressione, range discreto → classificazione."},{"id":"mer.q.gauss","kind":"mcq","prompt":"Quale affermazione sulla storia del machine learning è corretta secondo le slide?","options":["Il primo algoritmo di regressione lineare fu realizzato da Gauss all'inizio del 1800","Il termine «regressione» fu introdotto nel 2010","Il machine learning nasce con i Large Language Model","Il machine learning è nato a Dartmouth nel 1956"],"answer":0,"explain":"Il termine «regressione» è del 1889, la regressione lineare risale a Gauss all'inizio del 1800."}]}]},{"id":"tiroasegno","name":"Tiro a Segno di Bias e Varianza","stages":[{"title":"Vero o Falso al bersaglio","presentation":"rush","timeLimitSec":15,"pick":8,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Lezione 3 · slide 16-23","items":[{"id":"tir.tf.residuo","kind":"tf","prompt":"L'errore, o residuo, è la differenza tra il valore stimato e il valore reale della variabile da predire.","answer":true,"explain":"Nell'esempio: differenza tra altezza stimata e altezza reale."},{"id":"tir.tf.irriducibile","kind":"tf","prompt":"Con un algoritmo abbastanza potente l'errore irriducibile si può azzerare.","answer":false,"explain":"È la variabilità intrinseca del fenomeno: lo avremo sempre e comunque."},{"id":"tir.tf.stessoinput","kind":"tf","prompt":"Persone con stesso peso, genere ed età possono avere altezze diverse, e questo non significa che il modello sia sbagliato.","answer":true,"explain":"Le feature potrebbero non contenere tutte le informazioni: genetica, alimentazione, crescita."},{"id":"tir.tf.inversi","kind":"tf","prompt":"Bias e varianza sono inversamente correlati.","answer":true,"explain":"Tanto diminuisce il bias tanto aumenta la varianza, e viceversa: serve un compromesso."},{"id":"tir.tf.underfit","kind":"tf","prompt":"Un modello in underfitting va bene sul training ma male sui nuovi dati.","answer":false,"explain":"Underfitting: male sul training e male sui nuovi dati. Quello descritto è l'overfitting."},{"id":"tir.tf.overfit","kind":"tf","prompt":"L'overfitting si riconosce confrontando le prestazioni sul training con quelle su dati mai visti.","answer":true,"explain":"Molto bene sul training e molto peggio su dati nuovi: probabile overfitting."},{"id":"tir.tf.biasalto","kind":"tf","prompt":"Un bias elevato indica un modello troppo semplice per rappresentare le relazioni nei dati.","answer":true,"explain":"È lo studente superficiale che non apprende gli schemi importanti."},{"id":"tir.tf.varianza","kind":"tf","prompt":"Una varianza elevata indica che piccole variazioni nel training set possono produrre modelli molto diversi.","answer":true,"explain":"Il modello è troppo sensibile ai dati con cui è addestrato."},{"id":"tir.tf.riducibile","kind":"tf","prompt":"L'errore riducibile dipende principalmente da bias e varianza.","answer":true,"explain":"ε = bias + varianza: è l'errore che la ricerca del modello migliore cerca di minimizzare."},{"id":"tir.tf.piudati","kind":"tf","prompt":"Aumentare la dimensione dei dati di input non aiuta contro underfitting e overfitting.","answer":false,"explain":"Più osservazioni rendono più facile apprendere correttamente: è una delle mitigazioni elencate."}]},{"title":"Sfida dell'Arciera","presentation":"battle","pick":3,"ref":"Lezione 3 · slide 19-24","items":[{"id":"tir.q.memoria","kind":"mcq","prompt":"«Uno studente che impara a memoria: conosce bene gli esempi studiati ma fatica con quelli nuovi.» Di quale problema si tratta?","options":["Overfitting, cioè varianza elevata","Underfitting, cioè bias elevato","Errore irriducibile","Data leakage"],"answer":0,"explain":"Il modello apprende anche il rumore dei dati di training e non generalizza."},{"id":"tir.q.superficiale","kind":"mcq","prompt":"Come ci si accorge dell'underfitting?","options":["Misurando le prestazioni sui dati di training: sono basse anche lì","Confrontando training e test: il test è molto peggiore","Controllando che le classi siano bilanciate","Guardando il numero di feature"],"answer":0,"explain":"Se il modello va male anche sui dati su cui è stato addestrato, non ha appreso le relazioni presenti."},{"id":"tir.q.formula","kind":"mcq","prompt":"Nella formula yᵢ = ỹᵢ + ε_irr + ε, che cosa rappresenta ε?","options":["L'errore riducibile, dovuto al modello","L'errore irriducibile del fenomeno","Il valore stimato dal modello","Il numero di feature"],"answer":0,"explain":"ε_irr è la variabilità intrinseca, ε è l'errore del modello, scomponibile in bias e varianza."},{"id":"tir.q.mitigazione","kind":"mcq","prompt":"Quale di queste NON è tra le operazioni elencate per mitigare underfitting e overfitting?","options":["Duplicare a caso le righe del training set","Selezionare le caratteristiche rilevanti","Usare la convalida incrociata","Configurare i parametri dell'algoritmo"],"answer":0,"explain":"Le operazioni elencate sono selezione delle feature, convalida incrociata, configurazione dei parametri e aumento dei dati di input."},{"id":"tir.q.compromesso","kind":"mcq","prompt":"Perché serve un compromesso bias-varianza?","options":["Perché più il modello si adatta al training, meno sbaglia lì ma più diventa sensibile a come sono fatti quei dati","Perché bias e varianza aumentano sempre insieme","Perché la varianza dipende solo dall'errore irriducibile","Perché il bias si può eliminare solo con più feature"],"answer":0,"explain":"Il compromesso è tra la flessibilità del modello e il suo comportamento su dati mai visti."}]}]},{"id":"cantierecrisp","name":"Cantiere CRISP-DM","stages":[{"title":"Le fasi del cantiere","presentation":"timeline","instructions":"Trascina le fasi (o usa le frecce ▲▼) per metterle nell'ordine del modello CRISP-DM.","ref":"Lezione 4 · slide 4-10","items":[{"id":"cri.order.fasi","kind":"order","weight":3,"prompt":"Ordina le fasi del CRISP-DM","entries":[{"label":"Business Understanding","reveal":"Output: piano di progetto"},{"label":"Data Understanding","reveal":"Output: documento di analisi dei dati"},{"label":"Data Preparation","reveal":"Output: insieme di dati di input"},{"label":"Data Modeling","reveal":"Output: il modello di machine learning"},{"label":"Evaluation","reveal":"Output: risultati della validazione"},{"label":"Deployment","reveal":"Output: report finale di progetto"}],"explain":"Business Understanding → Data Understanding → Data Preparation → Modeling → Evaluation → Deployment, con la possibilità di tornare indietro più volte."}]},{"title":"I ruoli del TDSP","presentation":"connect","instructions":"Collega ogni ruolo del TDSP alla sua responsabilità. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 4 · slide 12-18","items":[{"id":"cri.match.ruoli","kind":"match","weight":3,"prompt":"Ruolo → responsabilità","leftTitle":"Ruolo","rightTitle":"Responsabilità","pairs":[["Project manager","Responsabile dell'intero progetto"],["Project lead","Team leader, simile allo SCRUM Master"],["Data engineer","Responsabile della data acquisition"],["Data scientist","Responsabile della data understanding"],["Application developer","Implementa l'applicazione"],["Solution architect","Progetta e manutiene le architetture"]],"explain":"TDSP (Microsoft, 2020) combina SCRUM e CRISP-DM e definisce sei ruoli espliciti."}]},{"title":"Riunione di cantiere","presentation":"battle","pick":4,"ref":"Lezione 4 · slide 5-19","items":[{"id":"cri.q.successcriteria","kind":"mcq","prompt":"In quale fase del CRISP-DM si definiscono i business success criteria?","options":["Business Understanding","Data Understanding","Evaluation","Deployment"],"answer":0,"explain":"Nella prima fase si raccolgono i requisiti, si definiscono obiettivi di business e tecnici, si stimano rischi e risorse."},{"id":"cri.q.featureeng","kind":"mcq","prompt":"In quale fase del CRISP-DM rientra il feature engineering?","options":["Data Preparation","Business Understanding","Evaluation","Deployment"],"answer":0,"explain":"Data Preparation: selezione delle feature con maggiore potenza predittiva, pulizia e formattazione dei dati."},{"id":"cri.q.qualita","kind":"mcq","prompt":"In quale fase si identificano e documentano i problemi di qualità dei dati, come i dati mancanti?","options":["Data Understanding","Data Modeling","Deployment","Business Understanding"],"answer":0,"explain":"Data Understanding: acquisizione, descrizione, esplorazione e verifica della qualità dei dati."},{"id":"cri.q.lehman","kind":"mcq","prompt":"Perché nella fase di Deployment si citano le leggi di Lehman?","options":["Perché un sistema che non cambia diventa presto inutile e la sua complessità cresce: il modello va monitorato e manutenuto","Perché dimostrano che il modello a cascata è sempre migliore","Perché impongono di rilasciare il modello una sola volta","Perché definiscono le metriche di valutazione"],"answer":0,"explain":"Il modello non resta nel suo stato in eterno: serve un piano di manutenzione e monitoraggio."},{"id":"cri.q.rigido","kind":"mcq","prompt":"Il CRISP-DM è un modello rigido a cascata?","options":["No: è flessibile, le fasi si possono ripetere e può essere usato in modo tradizionale o agile","Sì: ogni fase si esegue una sola volta","Sì: è identico al modello a cascata senza feedback","No: è un modello che non prevede fasi"],"answer":0,"explain":"È simile a una cascata con feedback, ma non sequenziale: le fasi possono essere eseguite un numero illimitato di volte."},{"id":"cri.q.manca","kind":"mcq","prompt":"Che cosa NON considera esplicitamente il CRISP-DM?","options":["L'aspetto socio-tecnico: chi è responsabile di fare cosa","La preparazione dei dati","La valutazione del modello","Il rilascio del modello"],"answer":0,"explain":"I progetti software sono socio-tecnici: lo sviluppo è fatto dalle persone. TDSP colma questa lacuna con ruoli espliciti."},{"id":"cri.q.acceptance","kind":"mcq","prompt":"Qual è la vera, grande differenza del TDSP rispetto al CRISP-DM?","options":["Una fase periodica di customer acceptance, che valida come il sistema implementa i requisiti di business","L'assenza della fase di modeling","L'uso esclusivo di dati non strutturati","L'eliminazione degli sprint"],"answer":0,"explain":"Ad intervalli regolari si valida il sistema rispetto ai requisiti, e i ruoli sono definiti esplicitamente."},{"id":"cri.q.scrummaster","kind":"mcq","prompt":"Che cosa distingue lo SCRUM Master da un project manager?","options":["Agevola il lavoro e coordina lo sviluppo, ma non ha responsabilità di gestione del personale","Definisce e prioritizza i requisiti del backlog","Scrive il codice di produzione","Rappresenta gli stakeholder"],"answer":0,"explain":"Il product owner gestisce il backlog; lo SCRUM Master facilita e coordina."},{"id":"cri.q.contro","kind":"mcq","prompt":"Quale svantaggio del TDSP è stato evidenziato?","options":["Gli sprint possono essere controproducenti, perché nel ML si incontrano problemi tecnici come dati mancanti o di bassa qualità","Non prevede rilasci incrementali","Ignora l'ingegneria del software","Usa una terminologia del tutto diversa da SCRUM"],"answer":0,"explain":"I punti di forza sono rilasci incrementali, ruoli complementari e terminologia SCRUM; il rischio è legato ai problemi sui dati."}]}]},{"id":"lavanderia","name":"Lavanderia dei Dati","stages":[{"title":"Il ciclo di lavaggio del testo","presentation":"timeline","instructions":"Ordina i passi di normalizzazione applicati a «connect = DBConnection.getConnection();» come visto a lezione.","ref":"Lezione 5 · slide 22-26","items":[{"id":"lav.order.testo","kind":"order","weight":3,"prompt":"Ordina i passi di normalizzazione del testo","entries":[{"label":"Sostituire i simboli con parole tramite un dizionario","reveal":"connect equals DBConnection calls getConnection"},{"label":"Separare le parole concatenate (camelCase, underscore)","reveal":"connect equals DB Connection calls get Connection"},{"label":"Contraction expansion","reveal":"connect equals database Connection calls get Connection"},{"label":"Stemming: ridurre le parole alla radice","reveal":"connect equals database Connect calls get Connect"},{"label":"Ridurre tutto in minuscolo","reveal":"connect equals database connect calls get connect"}],"explain":"Simboli → parole, split degli identificatori, espansione delle contrazioni, stemming, lowercase. Altri passi possibili: spelling correction, singolarizzazione, stopword removal."}]},{"title":"Smista i dati","presentation":"bins","instructions":"Per ogni esempio, scegli il tipo di dato. Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 5 · slide 8-10","items":[{"id":"lav.cat.tipi","kind":"categorize","weight":2,"prompt":"Esempio → tipo di dato","categories":["Strutturato","Semi-strutturato","Non strutturato"],"entries":[{"label":"Una tabella di un database relazionale interrogabile con query","cat":0},{"label":"Un foglio con colonne ben definite e tipi noti per ogni colonna","cat":0},{"label":"Dati tabulari con valori mancanti o campi espressi in testo libero","cat":1},{"label":"Documenti salvati in una base di dati document-oriented","cat":1},{"label":"Le recensioni degli utenti sul Google Play Store","cat":2},{"label":"Il codice sorgente di una classe Java","cat":2}],"explain":"Strutturati: righe e colonne ben definite. Semi-strutturati: formato fissato ma struttura non stretta. Non strutturati: tutto il resto, testo incluso."}]},{"title":"Sfida della Lavandaia","presentation":"battle","pick":4,"ref":"Lezione 5 · slide 2-16","items":[{"id":"lav.q.antibiotico","kind":"mcq","prompt":"Perché «Ha preso antibiotico» è un problema nel modello che predice la polmonite?","options":["Perché l'antibiotico si prende DOPO la diagnosi: il dato c'è nello storico ma non sarà disponibile quando si deve predire","Perché è una variabile non numerica","Perché ha troppi valori mancanti","Perché ha varianza zero"],"answer":0,"explain":"È un leaky predictor: aiuta in addestramento ma nella pratica non sarà disponibile, causando data leakage."},{"id":"lav.q.leakage","kind":"mcq","prompt":"Che cos'è il data leakage?","options":["Un problema per cui il modello lavora accuratamente in addestramento ma non in fase di rilascio","La perdita di dati per un guasto del disco","La pubblicazione accidentale di dati personali","Lo sbilanciamento tra classi"],"answer":0,"explain":"Si usa un'informazione che in produzione non ci sarà."},{"id":"lav.q.media","kind":"mcq","prompt":"Quali sono i due problemi dell'imputazione con la media?","options":["Non si applica a dati non numerici e non considera l'incertezza","È troppo lenta e richiede etichette","Funziona solo su testi in inglese","Elimina le righe e le colonne con dati mancanti"],"answer":0,"explain":"Facile da applicare, ma con questi due limiti."},{"id":"lav.q.frequente","kind":"mcq","prompt":"Qual è il rischio della most frequent imputation quando mancano molti dati?","options":["Influenzare eccessivamente la distribuzione della variabile","Rendere il dataset sbilanciato verso la classe di minoranza","Introdurre leaky predictor","Trasformare i dati strutturati in non strutturati"],"answer":0,"explain":"Riempire tanti buchi con lo stesso valore schiaccia la distribuzione su quel valore."},{"id":"lav.q.deduttiva","kind":"mcq","prompt":"Una famiglia ha 2 figli nell'anno 1 e 2 figli nell'anno 3; si pone 2 anche per l'anno 2. Che tecnica è?","options":["Imputazione deduttiva","Most frequent imputation","Imputazione con la media","Oversampling"],"answer":0,"explain":"Una regola definita dal progettista per deduzione logica. Limite: non sempre si trova una regola valida e non scala."},{"id":"lav.q.scartare","kind":"mcq","prompt":"Quando NON conviene scartare una colonna con dati mancanti?","options":["Quando rappresenta una caratteristica rilevante per il problema","Quando i dati mancanti sono pochi","Quando la colonna è numerica","Mai: conviene sempre scartarla"],"answer":0,"explain":"Scartare righe è un problema con poche osservazioni; scartare colonne lo è se la colonna è rilevante."},{"id":"lav.q.sfide","kind":"mcq","prompt":"Quali sono le tre sfide principali dei dati testuali?","options":["Difficoltà di estrazione, ambiguità del linguaggio, molti modi di esprimere concetti simili","Lunghezza, colore e font del testo","Bias, varianza ed errore irriducibile","Undersampling, oversampling e clustering"],"answer":0,"explain":"Abbreviazioni, refusi ed errori grammaticali rendono difficile il text mining."},{"id":"lav.q.governance","kind":"mcq","prompt":"Che cosa gestisce la data governance?","options":["Disponibilità, usabilità, integrità e sicurezza dei dati","Accuratezza, completezza e consistenza dei dati","Il bilanciamento delle classi","La normalizzazione delle feature"],"answer":0,"explain":"Accuratezza, completezza e consistenza descrivono invece la qualità dei dati."}]}]},{"id":"sartoria","name":"Sartoria delle Feature","stages":[{"title":"Il banco delle tecniche","presentation":"connect","instructions":"Collega ogni tecnica alla sua descrizione. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 5 · slide 31-43","items":[{"id":"sar.match.tecniche","kind":"match","weight":3,"prompt":"Tecnica → descrizione","leftTitle":"Tecnica","rightTitle":"Descrizione","pairs":[["Min-max normalization","Riporta i valori in un intervallo [a, b], per esempio [0, 1]"],["Z-score normalization","Sottrae la media e divide per la deviazione standard"],["Feature extraction","Genera automaticamente nuove feature dai dati grezzi (riduzione della dimensionalità)"],["Feature construction","Il progettista crea nuove feature usando la conoscenza del dominio"],["Feature selection","Sceglie le variabili più significative tra quelle esistenti"],["Undersampling","Elimina a caso istanze della classe di maggioranza"],["Oversampling","Aggiunge a caso istanze della classe di minoranza"]],"explain":"Scaling (min-max, z-score), feature engineering (extraction, construction, selection) e data balancing (under e oversampling)."}]},{"title":"Prova di cucito","presentation":"battle","pick":4,"ref":"Lezione 5 · slide 28-44","items":[{"id":"sar.q.minmax","kind":"mcq","prompt":"La lunghezza del testo va da 180 a 492. Con la min-max normalization in [0, 1], quanto diventa 300?","options":["Circa 0,38","Circa 0,61","0,30","Circa 0,13"],"answer":0,"explain":"(300 − 180) / (492 − 180) = 120 / 312 ≈ 0,38."},{"id":"sar.q.minmaxestremi","kind":"mcq","prompt":"Dopo la min-max normalization in [0, 1] della lunghezza del testo, quanto valgono 180 e 492?","options":["0 e 1","−1 e 1","180 e 492","0,5 e 1"],"answer":0,"explain":"Il minimo diventa a = 0 e il massimo diventa b = 1."},{"id":"sar.q.perchescaling","kind":"mcq","prompt":"Perché serve il feature scaling?","options":["Perché scale molto diverse possono far sottostimare o sovrastimare l'importanza di una feature","Perché gli algoritmi non accettano numeri decimali","Per eliminare i dati mancanti","Per bilanciare le classi"],"answer":0,"explain":"Il numero di allegati (0-3) e la lunghezza del testo (180-492) hanno distribuzioni molto diverse."},{"id":"sar.q.varianza","kind":"mcq","prompt":"Nel dataset dello spam il colore del testo è sempre «Nero». Quale metodo la elimina?","options":["Eliminazione di feature con bassa varianza","Eliminazione univariata con χ²","Undersampling","Z-score normalization"],"answer":0,"explain":"Una variabile simile in tutto il dataset probabilmente non è discriminante; di default si eliminano quelle a varianza zero."},{"id":"sar.q.univariata","kind":"mcq","prompt":"Come funziona l'eliminazione univariata di feature?","options":["Ogni variabile indipendente viene correlata con la dipendente tramite un test statistico e si tengono le k migliori","Si eliminano le variabili con valori mancanti","Si sceglie una sola variabile a caso","Si generano nuove variabili dai dati grezzi"],"answer":0,"explain":"Per esempio con il test χ² di Pearson si ottiene una classifica delle variabili."},{"id":"sar.q.datofeature","kind":"mcq","prompt":"Nel caso della polmonite, qual è la differenza tra dato e feature?","options":["I valori numerici dell'età sono dati; l'età è la feature usata per predire","Sono sinonimi","La feature è sempre la variabile dipendente","Il dato è sempre testuale, la feature sempre numerica"],"answer":0,"explain":"Il feature engineering usa la conoscenza del dominio per ricavare feature dai dati grezzi."},{"id":"sar.q.sbilanciato","kind":"mcq","prompt":"Che cosa succede ignorando lo sbilanciamento in un problema medico?","options":["Il modello caratterizza bene solo la classe più popolosa, di solito i sani, che è la meno interessante","Il modello trova meglio i malati","Il modello va in underfitting su entrambe le classi sempre","Non succede nulla: lo sbilanciamento non conta"],"answer":0,"explain":"Ci interessa trovare i malati, che sono molti meno."},{"id":"sar.q.oversampling","kind":"mcq","prompt":"Qual è il rischio dell'oversampling casuale?","options":["Overfitting: il modello impara a memoria le istanze duplicate della classe di minoranza","Perdere istanze rilevanti della classe di maggioranza","Underfitting della classe di minoranza","Data leakage dai dati di test"],"answer":0,"explain":"Perdere istanze rilevanti è invece il rischio dell'undersampling casuale."},{"id":"sar.q.vantaggi","kind":"mcq","prompt":"Quale di questi è un vantaggio di avere buone feature?","options":["Le prestazioni restano alte anche con un algoritmo o una configurazione sub-ottimi","Non serve più valutare il modello","Si può fare a meno dei dati","Il dataset diventa automaticamente bilanciato"],"answer":0,"explain":"Buone feature aumentano flessibilità, semplicità, explainability e prestazioni del modello."}]}]}],"bossPool":[{"id":"boss2.critico","kind":"mcq","prompt":"Quale componente dell'agente che apprende confronta il comportamento con uno standard di prestazione?","options":["L'elemento critico","Il generatore di problemi","L'elemento esecutivo","L'elemento di apprendimento"],"answer":0,"explain":"Il critico produce il feedback per l'elemento di apprendimento.","ref":"Lezione 3 · slide 3-4"},{"id":"boss2.semi","kind":"mcq","prompt":"Solo alcuni dati sono etichettati e l'agente deve apprendere le etichette mancanti. Che apprendimento è?","options":["Semi-supervisionato","Per rinforzo","Non supervisionato","Supervisionato"],"answer":0,"explain":"Alcuni dati etichettati, altri no.","ref":"Lezione 3 · slide 11"},{"id":"boss2.overfit","kind":"mcq","prompt":"Un modello ha il 99% sul training e il 60% su dati mai visti. Che cosa sospetti?","options":["Overfitting","Underfitting","Errore irriducibile nullo","Dataset bilanciato"],"answer":0,"explain":"Bene sul training, male sui nuovi dati.","ref":"Lezione 3 · slide 23"},{"id":"boss2.biasvar","kind":"mcq","prompt":"Quale coppia è corretta?","options":["Bias alto → underfitting; varianza alta → overfitting","Bias alto → overfitting; varianza alta → underfitting","Bias e varianza alti → errore irriducibile","Bias basso e varianza bassa si ottengono sempre insieme"],"answer":0,"explain":"Bias e varianza sono inversamente correlati.","ref":"Lezione 3 · slide 20-23"},{"id":"boss2.crisp","kind":"mcq","prompt":"Quale fase del CRISP-DM produce il documento di analisi dei dati?","options":["Data Understanding","Data Preparation","Evaluation","Business Understanding"],"answer":0,"explain":"Riporta metodi di estrazione, relazioni tra i dati e problemi di qualità.","ref":"Lezione 4 · slide 6"},{"id":"boss2.tdsp","kind":"mcq","prompt":"Che cosa ottieni combinando SCRUM e CRISP-DM?","options":["Il TDSP, Team Data Science Process","Il modello a cascata","Il PEAS","Il modello di Lehman"],"answer":0,"explain":"Sviluppato da Microsoft nel 2020.","ref":"Lezione 4 · slide 13"},{"id":"boss2.leakage","kind":"mcq","prompt":"Il modello sulla polmonite va benissimo in addestramento e male in produzione. Quale variabile è il colpevole più probabile?","options":["Ha preso antibiotico","Età","Peso","Sesso"],"answer":0,"explain":"L'antibiotico si prende dopo la diagnosi: è un leaky predictor.","ref":"Lezione 5 · slide 3-7"},{"id":"boss2.minmax","kind":"mcq","prompt":"Valori da 0 a 10: con la min-max normalization in [0, 1], quanto vale 5?","options":["0,5","5","0,05","1"],"answer":0,"explain":"(5 − 0) / (10 − 0) = 0,5.","ref":"Lezione 5 · slide 31-32"},{"id":"boss2.balancing","kind":"mcq","prompt":"Duplicare a caso le istanze della classe di minoranza può causare...","options":["Overfitting","Data leakage","Underfitting della maggioranza","Perdita di feature"],"answer":0,"explain":"Il modello impara a memoria le copie.","ref":"Lezione 5 · slide 43-44"}]},{"id":"L3","name":"Rione Shallow","implemented":true,"buildings":[{"id":"serrabayes","name":"Serra di Naive Bayes","stages":[{"title":"I tre passi della semina","presentation":"timeline","instructions":"Trascina i passi (o usa le frecce ▲▼) nell'ordine in cui Naive Bayes classifica una nuova istanza.","ref":"Lezione 6 · slide 6","items":[{"id":"nb.order.passi","kind":"order","weight":2,"prompt":"Ordina i passi di Naive Bayes","entries":[{"label":"Calcolo della probabilità di ciascuna classe","reveal":"frequenza della classe / numero di istanze"},{"label":"Calcolo delle probabilità condizionate delle caratteristiche","reveal":"tabelle di frequenza e teorema di Bayes"},{"label":"Decisione: la classe con la probabilità più alta","reveal":"per esempio «Non giocare»"}],"explain":"Probabilità di classe, probabilità condizionate, decisione."}]},{"title":"Sfida della Giardiniera","presentation":"battle","pick":4,"ref":"Lezione 6 · slide 3-16","items":[{"id":"nb.q.naive","kind":"mcq","prompt":"Perché Naive Bayes si chiama «naive»?","options":["Perché assume che le caratteristiche non siano correlate tra loro","Perché usa solo una caratteristica","Perché non richiede dati di training","Perché sceglie la classe a caso"],"answer":0,"explain":"La mela rossa, rotonda e di 8 cm: le caratteristiche sono collegate, ma l'algoritmo le tratta come indipendenti."},{"id":"nb.q.pb","kind":"mcq","prompt":"Lanciando due dadi, qual è la probabilità di ottenere un solo 2 (evento B)?","options":["10/36","6/36","11/36","2/6"],"answer":0,"explain":"Gli esiti favorevoli sono 10 su 36: (2,1), (2,3), (2,4), (2,5), (2,6), (1,2), (3,2), (4,2), (5,2), (6,2)."},{"id":"nb.q.pab","kind":"mcq","prompt":"Con P(B|A) = 2/6, P(A) = 6/36 e P(B) = 10/36, quanto vale P(A|B)?","options":["20%","33,33%","16,67%","27,77%"],"answer":0,"explain":"P(A|B) = P(B|A)·P(A)/P(B) = (2/6 · 6/36) / (10/36) = 2/10 = 20%."},{"id":"nb.q.classe","kind":"mcq","prompt":"Nel dataset del tennis ci sono 14 giornate, di cui 9 «Giocare». Quanto vale P(Giocare)?","options":["9/14 ≈ 64,29%","5/14 ≈ 35,71%","9/5","1/2"],"answer":0,"explain":"La probabilità di classe è la frequenza della classe divisa per il numero totale di istanze."},{"id":"nb.q.soleggiato","kind":"mcq","prompt":"P(Soleggiato|Sì) = 0,2222, P(Sì) = 0,6429, P(Soleggiato) = 0,3571. Quanto vale P(Sì|Soleggiato)?","options":["0,4","0,6","0,2222","0,6429"],"answer":0,"explain":"(0,2222 × 0,6429) / 0,3571 ≈ 0,4. Di conseguenza P(No|Soleggiato) = 0,6."},{"id":"nb.q.normalizza","kind":"mcq","prompt":"Per «Pioggia, Caldo, Umidità elevata» si ottengono 0,03 per Sì e 0,19 per No. Quanto vale Sì dopo la normalizzazione?","options":["Circa 0,14","Circa 0,86","0,03","0,22"],"answer":0,"explain":"0,03 / (0,03 + 0,19) ≈ 0,14, e No ≈ 0,86: Naive Bayes suggerisce di non giocare."},{"id":"nb.q.modello","kind":"mcq","prompt":"Dopo l'addestramento, in che cosa consiste il modello di Naive Bayes?","options":["Nelle tabelle di probabilità per ogni caratteristica più le probabilità delle classi","In un albero di regole","Nei coefficienti β0 e β1","Nei k centroidi"],"answer":0,"explain":"L'addestramento conta le frequenze; il modello sono le tabelle di probabilità."},{"id":"nb.q.ensemble","kind":"mcq","prompt":"Che cosa fa il Majority Voting?","options":["Classifica una nuova istanza in base alla predizione della maggioranza dei classificatori di base","Sceglie la classe più frequente nel training set","Elimina le feature meno votate","Bilancia le classi del dataset"],"answer":0,"explain":"È un semplice esempio di ensemble, cioè di combinazione di più classificatori."}]}]},{"id":"frutteto","name":"Frutteto degli Alberi Decisionali","stages":[{"title":"Come cresce un albero","presentation":"timeline","instructions":"Trascina i passi (o usa le frecce ▲▼) nell'ordine della procedura raffinata con entropia e information gain.","ref":"Lezione 6 · slide 31","items":[{"id":"fru.order.procedura","kind":"order","weight":2,"prompt":"Ordina i passi di costruzione dell'albero","entries":[{"label":"Calcola l'entropia per ogni attributo del dataset"},{"label":"Dividi il training set con l'attributo che massimizza l'information gain"},{"label":"Crea un nodo dell'albero con quell'attributo"},{"label":"Ripeti finché tutti i sottoinsiemi non sono puri"}],"explain":"Massimizzare l'information gain equivale a minimizzare l'entropia dei sottoinsiemi."}]},{"title":"Classificazione o regressione?","presentation":"bins","instructions":"Ogni affermazione vale per gli alberi di classificazione o per gli alberi regressivi? Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 6 · slide 26-28 · Lezione 7 · slide 25-29","items":[{"id":"fru.cat.alberi","kind":"categorize","weight":3,"prompt":"Affermazione → tipo di albero","categories":["Albero di classificazione","Albero regressivo"],"entries":[{"label":"Lo split si sceglie con l'information gain","cat":0},{"label":"La foglia restituisce una classe, per esempio «mela»","cat":0},{"label":"Ci si ferma quando i sottoinsiemi sono puri","cat":0},{"label":"Lo split si sceglie con la massima riduzione della varianza","cat":1},{"label":"La foglia contiene la media dei valori target, o la mediana se ci sono outlier","cat":1},{"label":"Ci si ferma per profondità massima o numero minimo di campioni in una foglia","cat":1}],"explain":"Stesso albero, due criteri: information gain per la classificazione, riduzione della varianza per la regressione."}]},{"title":"Sfida del Contadino","presentation":"battle","pick":4,"ref":"Lezione 6 · slide 17-31","items":[{"id":"fru.q.regola","kind":"mcq","prompt":"Un frutto giallo largo 63 mm: come lo classifica l'albero visto a lezione?","options":["Mela","Banana","Arancia","Non è classificabile"],"answer":0,"explain":"colore = giallo ∧ larghezza ≤ 80 ⇒ mela."},{"id":"fru.q.puro","kind":"mcq","prompt":"Che cos'è un sottoinsieme puro?","options":["Un sottoinsieme che contiene tutti e soli gli elementi di una classe","Un sottoinsieme senza dati mancanti","Un sottoinsieme con entropia massima","Un sottoinsieme con un solo attributo"],"answer":0,"explain":"Se il sottoinsieme non è puro resta incertezza e bisogna dividere ancora."},{"id":"fru.q.entropia","kind":"mcq","prompt":"Che cosa indica un'entropia alta?","options":["Che il messaggio è ambiguo: minore è l'informazione","Che il sottoinsieme è puro","Che l'albero è troppo profondo","Che l'attributo è il migliore per lo split"],"answer":0,"explain":"H(D) = −Σ p(c) · log₂ p(c): maggiore l'entropia, minore l'informazione."},{"id":"fru.q.puroentropia","kind":"mcq","prompt":"Quanto vale l'entropia di un sottoinsieme puro, come i frutti verdi (tutte mele)?","options":["0","1","1,57","0,97"],"answer":0,"explain":"Con una sola classe p = 1 e log₂ 1 = 0."},{"id":"fru.q.gain","kind":"mcq","prompt":"H(D) = 1,57; dividendo per colore, solo il giallo (5 frutti su 10) ha entropia 0,97. Quanto vale Gain(D, Colore)?","options":["Circa 1,09","Circa 0,60","1,57","0,97"],"answer":0,"explain":"1,57 − (5/10 · 0,97 + 2/10 · 0 + 3/10 · 0) ≈ 1,09."},{"id":"fru.q.leggibile","kind":"mcq","prompt":"Perché gli alberi decisionali sono particolarmente utili?","options":["Perché sono facili da leggere: ogni percorso dalla radice a una foglia è una regola","Perché non vanno mai in overfitting","Perché non richiedono dati di training","Perché funzionano solo per la classificazione"],"answer":0,"explain":"Per questo sono adatti quando le decisioni vanno spiegate. Si usano sia per classificazione sia per regressione."},{"id":"fru.q.splitcontinuo","kind":"mcq","prompt":"In un albero regressivo, con i valori [1, 3, 5, 7] di una variabile continua, quali sono i potenziali punti di split?","options":["Tra 1 e 3, tra 3 e 5, tra 5 e 7","Solo il valore medio, 4","1, 3, 5 e 7","Nessuno: le variabili continue non si dividono"],"answer":0,"explain":"Si ordinano i valori unici e si valutano gli split tra valori consecutivi, scegliendo quello che massimizza la riduzione della varianza."},{"id":"fru.q.pochivalori","kind":"mcq","prompt":"Che differenza c'è tra la predizione di un albero regressivo e quella di una retta di regressione?","options":["L'albero restituisce pochi valori distinti, uno per foglia","L'albero restituisce sempre valori più precisi","La retta restituisce solo valori interi","Nessuna differenza"],"answer":0,"explain":"Ogni foglia ha un valore, per esempio la media della regione (R1 ≈ 42k, R2 ≈ 58k)."}]}]},{"id":"convalida","name":"Tribunale della Convalida","stages":[{"title":"Le formule della sentenza","presentation":"connect","instructions":"Collega ogni metrica alla sua formula. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 6 · slide 40-41","items":[{"id":"con.match.metriche","kind":"match","weight":3,"prompt":"Metrica → formula","leftTitle":"Metrica","rightTitle":"Formula","pairs":[["Precision","TP / (TP + FP)"],["Recall","TP / (TP + FN)"],["Accuracy","(TP + TN) / (TP + TN + FP + FN)"],["Specificity","TN / (TN + FP)"],["MCC","(TP·TN − FP·FN) / √((TP+FP)(TP+FN)(TN+FP)(TN+FN))"]],"explain":"Ogni metrica dà un'indicazione complementare. L'MCC considera tutte le celle della matrice di confusione."}]},{"title":"Gli atti della convalida","presentation":"timeline","instructions":"Trascina i passi (o usa le frecce ▲▼) nell'ordine della k-fold cross validation.","ref":"Lezione 6 · slide 34-37","items":[{"id":"con.order.kfold","kind":"order","weight":2,"prompt":"Ordina i passi della convalida incrociata","entries":[{"label":"Mischiare in maniera casuale i dati di partenza"},{"label":"Dividere i dati in k gruppi"},{"label":"Per ogni gruppo: usarlo come test set e i k−1 restanti come training set"},{"label":"Addestrare il modello sul training set"},{"label":"Valutare le prestazioni del modello ed eliminarlo"}],"explain":"Spesso k = 10. Ogni istanza appartiene a un solo gruppo, e normalizzazione, feature selection e balancing vanno ripetuti a ogni addestramento."}]},{"title":"L'arringa del Giudice","presentation":"battle","pick":4,"ref":"Lezione 6 · slide 33-42","items":[{"id":"con.q.stesso","kind":"mcq","prompt":"Che cosa succede se si addestra e si valuta un modello sullo stesso dataset?","options":["Si commette un grosso errore metodologico: i risultati sono totalmente inaffidabili","Si ottiene la stima più precisa possibile","Si elimina l'errore irriducibile","Si evita il data leakage"],"answer":0,"explain":"Bisogna simulare istanze con etichetta non nota, dividendo per esempio 67% training e 33% test."},{"id":"con.q.leakyval","kind":"mcq","prompt":"Normalizzare o bilanciare l'intero dataset prima di dividerlo in training e test causa...","options":["Una leaky validation strategy","Underfitting","Un leaky predictor","Un dataset sbilanciato"],"answer":0,"explain":"Dati di training e test si mescolano, anche in modo indiretto: è una forma di data leakage."},{"id":"con.q.stratified","kind":"mcq","prompt":"Che cosa fa la stratified k-fold validation?","options":["Crea sottoinsiemi con un numero simile di istanze delle diverse classi","Ripete la validazione N volte","Rispetta l'ordine temporale dei dati","Usa un solo fold come training"],"answer":0,"explain":"Ripetere N volte è invece la N-times k-fold validation."},{"id":"con.q.temporale","kind":"mcq","prompt":"Perché la convalida incrociata classica è un problema con dati in ordine temporale?","options":["Perché mescola dati passati e futuri: nella realtà non si possono usare dati futuri per predire il passato","Perché i dati temporali non si possono mischiare in memoria","Perché richiede k = 10","Perché i dati temporali sono sempre sbilanciati"],"answer":0,"explain":"Serve una validazione che rispetti i vincoli temporali: il training precede sempre il test."},{"id":"con.q.precision","kind":"mcq","prompt":"Che cosa indica la precision?","options":["Quanti errori ci sono nella lista delle predizioni positive fatte dal classificatore","Quante istanze positive del dataset il classificatore riesce a trovare","Il numero totale di predizioni corrette","Quanto bene riconosce i negativi"],"answer":0,"explain":"La seconda opzione descrive la recall."},{"id":"con.q.melanoma","kind":"mcq","prompt":"I malati sono il 3%. Un classificatore risponde sempre «sano». Quanto vale la sua accuracy?","options":["97%","3%","50%","0%"],"answer":0,"explain":"Accuracy altissima ma recall zero: riconosce chi sta bene, mentre a noi interessano i malati."},{"id":"con.q.costo","kind":"mcq","prompt":"Se un falso negativo è molto grave (un malato non riconosciuto), quale metrica guardi soprattutto?","options":["La recall","La precision","La specificity","L'accuracy"],"answer":0,"explain":"La recall dice quante istanze positive vengono trovate; se è grave un falso positivo si guarda la precision."},{"id":"con.q.unico","kind":"mcq","prompt":"Perché ogni istanza deve appartenere a un unico gruppo durante la convalida incrociata?","options":["Altrimenti si mescolano dati di training e di test, influenzando le capacità predittive","Per ridurre il tempo di calcolo","Perché k deve essere pari","Per bilanciare le classi"],"answer":0,"explain":"Mescolarli porta a una leaky validation strategy."}]}]},{"id":"borsa","name":"Borsa della Regressione","stages":[{"title":"Le assunzioni del listino","presentation":"connect","instructions":"Collega ogni assunzione della regressione lineare alla sua descrizione. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 7 · slide 20-23","items":[{"id":"reg.match.assunzioni","kind":"match","weight":3,"prompt":"Assunzione → descrizione","leftTitle":"Assunzione","rightTitle":"Descrizione","pairs":[["Linearità","La relazione tra X e Y si rappresenta con una funzione lineare"],["Normalità dei residui","Gli errori residui sono normalmente distribuiti"],["Omoschedasticità","Gli errori residui hanno varianza costante"],["Indipendenza degli errori","Il test di Durbin-Watson dà un valore vicino a 2"]],"explain":"Per la regressione multipla valgono gli stessi vincoli, più il rischio di multicollinearità."}]},{"title":"Contrattazioni a raffica","presentation":"rush","timeLimitSec":15,"pick":7,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Lezione 7 · slide 4-24","items":[{"id":"reg.tf.intercetta","kind":"tf","prompt":"L'intercetta β0 indica il valore di y quando x è zero.","answer":true,"explain":"β1 è invece l'inclinazione: la variazione di y quando x aumenta di una unità."},{"id":"reg.tf.residuo","kind":"tf","prompt":"Il residuo è la differenza tra il valore reale e il valore predetto.","answer":true,"explain":"ε = y − ỹ."},{"id":"reg.tf.loss","kind":"tf","prompt":"La somma dei residui è detta funzione di perdita (loss function).","answer":true,"explain":"Molte tecniche di regressione mirano a minimizzarla."},{"id":"reg.tf.singola","kind":"tf","prompt":"Predire il salario dai soli anni di esperienza richiede una regressione lineare multipla.","answer":false,"explain":"Con un unico predittore è una regressione lineare singola."},{"id":"reg.tf.piano","kind":"tf","prompt":"Nella regressione multipla si cerca un piano che interpoli i dati invece di una retta.","answer":true,"explain":"Si usa una forma matriciale per le variabili."},{"id":"reg.tf.multicoll","kind":"tf","prompt":"Con più variabili conviene tenere anche quelle ridondanti, per non perdere informazione.","answer":false,"explain":"Si rischia la multicollinearità: le variabili ridondanti vanno eliminate."},{"id":"reg.tf.mse","kind":"tf","prompt":"MSE e RMSE pesano di più gli errori grandi rispetto al MAE.","answer":true,"explain":"Gli errori sono elevati al quadrato."},{"id":"reg.tf.mae","kind":"tf","prompt":"Il MAE si legge nella stessa unità della variabile dipendente, per esempio in euro.","answer":true,"explain":"È la differenza media in valore assoluto tra predetti e reali."},{"id":"reg.tf.ensemble","kind":"tf","prompt":"Gli ensemble di regressori sono più semplici di quelli di classificatori.","answer":false,"explain":"Sono più complessi: devono interpretare valori numerici, non contare voti sulle classi."}]},{"title":"Chiusura delle contrattazioni","presentation":"battle","pick":3,"ref":"Lezione 7 · slide 4-19","items":[{"id":"reg.q.predici","kind":"mcq","prompt":"Con ỹ = 32.375,85 + 6.995,31 · x, quale salario si stima per 5 anni di esperienza?","options":["67.352,40 euro","39.371,16 euro","34.976,55 euro","62.375,85 euro"],"answer":0,"explain":"32.375,85 + 6.995,31 · 5 = 67.352,40."},{"id":"reg.q.beta1","kind":"mcq","prompt":"Nel modello del salario, che cosa significa β1 = 6.995,31?","options":["Ogni anno di esperienza in più aumenta il salario stimato di circa 6.995 euro","Il salario di chi ha zero anni di esperienza","L'errore medio del modello","Il numero di impiegati nel dataset"],"answer":0,"explain":"È l'inclinazione della retta."},{"id":"reg.q.minimiquadrati","kind":"mcq","prompt":"Nel metodo dei minimi quadrati, che cosa si calcola per ogni punto (x, y) prima di sommare?","options":["x² e xy","y² e x/y","|x − y|","La media e la mediana"],"answer":0,"explain":"Poi β1 = (N·Σxy − Σx·Σy) / (N·Σx² − (Σx)²) e β0 = (Σy − β1·Σx) / N."},{"id":"reg.q.omosch","kind":"mcq","prompt":"Come si verifica l'omoschedasticità?","options":["Plottando i residui standardizzati contro i valori predetti: deve comparire un trend orizzontale","Con il test χ² di Pearson","Calcolando l'information gain","Con la convalida incrociata stratificata"],"answer":0,"explain":"Se la proprietà è soddisfatta non si vedono punti sparsi nello spazio."},{"id":"reg.q.rmse","kind":"mcq","prompt":"Che cosa indica la RMSE?","options":["La radice quadrata dell'errore quadratico medio sul test set","La differenza media in valore assoluto","La percentuale di predizioni corrette","La somma dei residui"],"answer":0,"explain":"MAE: media dei valori assoluti; MSE: media dei quadrati; RMSE: radice del MSE."},{"id":"reg.q.r","kind":"mcq","prompt":"Quale ambiente è stato indicato come il più appropriato per i test statistici della regressione?","options":["Il linguaggio R","Excel","Prolog","Il linguaggio C"],"answer":0,"explain":"Per esempio: regressore <- lm(salario ~ anniDiEsperienza, data = dataset)."}]}]},{"id":"piazzacluster","name":"Piazza dei Raggruppamenti","stages":[{"title":"Le distanze della piazza","presentation":"connect","instructions":"Collega ogni misura alla sua descrizione. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 8 · slide 8-11","items":[{"id":"clu.match.distanze","kind":"match","weight":3,"prompt":"Misura → descrizione","leftTitle":"Misura","rightTitle":"Descrizione","pairs":[["Euclidea","Radice della somma dei quadrati delle differenze delle coordinate"],["Manhattan","Somma dei valori assoluti delle differenze delle coordinate"],["Mahalanobis","Distanza standardizzata che tiene conto di dispersione e correlazione delle variabili"],["Jaccard","Dimensione dell'intersezione diviso dimensione dell'unione di due insiemi"],["Hamming","Numero di sostituzioni per convertire una stringa nell'altra"],["Levenshtein","Numero minimo di cancellazioni, sostituzioni e inserimenti tra due stringhe"]],"explain":"Nessuna è migliore in assoluto: dipende dal problema, e il clustering si valida a posteriori."}]},{"title":"Smista le affermazioni","presentation":"bins","instructions":"A quale algoritmo si riferisce ogni affermazione? Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 8 · slide 14-40","items":[{"id":"clu.cat.algoritmi","kind":"categorize","weight":3,"prompt":"Affermazione → algoritmo","categories":["k-means","Clustering gerarchico","DBSCAN"],"entries":[{"label":"Bisogna fissare a priori il numero di cluster","cat":0},{"label":"Funziona bene con cluster compatti, ipersferici e ben separati","cat":0},{"label":"Produce un dendrogramma, navigabile per scegliere il numero di cluster","cat":1},{"label":"Può essere agglomerativo o divisivo","cat":1},{"label":"Si basa sui parametri minPts ed ε","cat":2},{"label":"Scopre cluster di forma arbitraria","cat":2}],"explain":"k-means è partizionale ad errore quadratico, il gerarchico lavora su più livelli di similarità, DBSCAN si basa sulla densità."}]},{"title":"La multa del Vigile","presentation":"battle","pick":4,"ref":"Lezione 8 · slide 2-43","items":[{"id":"clu.q.jaccard","kind":"mcq","prompt":"«Mi piace andare al mare» e «Ieri sono stato al mare»: quanto vale l'indice di Jaccard tra gli insiemi di parole?","options":["0,25","0,5","0,2","2"],"answer":0,"explain":"Intersezione {al, mare} = 2 parole; unione = 8 parole; 2/8 = 0,25."},{"id":"clu.q.metrica","kind":"mcq","prompt":"Quale proprietà NON è richiesta a una misura metrica?","options":["Che d(x, y) sia sempre minore di 1","Identità: d(x, x) = 0","Simmetria: d(x, y) = d(y, x)","Disuguaglianza triangolare"],"answer":0,"explain":"Le quattro proprietà sono identità, positività, simmetria e disuguaglianza triangolare."},{"id":"clu.q.semimetrica","kind":"mcq","prompt":"Una misura soddisfa identità, positività e simmetria, ma non la disuguaglianza triangolare. È...","options":["Semi-metrica","Pseudo-metrica","Metrica","Non è una misura di distanza"],"answer":0,"explain":"Pseudo-metrica: identità, simmetria e disuguaglianza triangolare (senza positività)."},{"id":"clu.q.kmeans","kind":"mcq","prompt":"Punti {2, 4, 5, 10, 11, 13}, k = 2, centroidi iniziali 2 e 4. Dopo l'iterazione 1, quali sono i nuovi centroidi?","options":["2 e 8,6","3,67 e 11,33","2 e 4","4,5 e 11"],"answer":0,"explain":"Cluster {2} e {4, 5, 10, 11, 13}: le medie sono 2 e 43/5 = 8,6. All'iterazione 2 si arriva a 3,67 e 11,33."},{"id":"clu.q.nuovo","kind":"mcq","prompt":"Con centroidi 3,67 e 11,33, a quale cluster va il nuovo punto 7?","options":["Al primo, con centroide 3,67","Al secondo, con centroide 11,33","A entrambi","A nessuno"],"answer":0,"explain":"|7 − 3,67| = 3,33 è minore di |7 − 11,33| = 4,33."},{"id":"clu.q.categorici","kind":"mcq","prompt":"Che algoritmo usi al posto di k-means con dati categorici?","options":["k-medoids","DBSCAN","Regressione lineare","Naive Bayes"],"answer":0,"explain":"Il medoide è il punto meno dissimile di una distribuzione, per esempio la moda."},{"id":"clu.q.gomito","kind":"mcq","prompt":"A che cosa serve il punto di gomito?","options":["A scegliere il numero di cluster, cercando il compromesso tra errore e capacità di raggruppamento","A misurare coesione e separazione di ogni punto","A confrontare il clustering con le etichette reali","A scegliere i centroidi iniziali"],"answer":0,"explain":"Si grafica la somma degli errori quadratici al variare di k. La silhouette misura coesione e separazione; la MoJo richiede le etichette."},{"id":"clu.q.silhouette","kind":"mcq","prompt":"Entro quale intervallo varia il silhouette coefficient?","options":["Tra −1 e +1","Tra 0 e 1","Tra 0 e +∞","Tra −∞ e 0"],"answer":0,"explain":"s(i) = (b(i) − a(i)) / max(a(i), b(i)); valori alti indicano più coesione e separazione."},{"id":"clu.q.dmin","kind":"mcq","prompt":"Nel clustering gerarchico, usando dmin come distanza tra cluster si parla di...","options":["Clustering del nearest neighbor","Clustering del farthest neighbor","Density-based clustering","k-medoids"],"answer":0,"explain":"dmin è la minima distanza tra due punti dei cluster; con dmax si parla di farthest neighbor."}]}]},{"id":"labscenari","name":"Laboratorio degli Scenari","stages":[{"title":"Ha senso usare il machine learning?","presentation":"bins","instructions":"Per ogni scenario, decidi se il machine learning ha senso. Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 9 · slide 6-8","items":[{"id":"lab.cat.senso","kind":"categorize","weight":3,"prompt":"Scenario → il ML ha senso?","categories":["Sì","No","Non ancora","Sì, con vincoli"],"entries":[{"label":"Calcolare il codice fiscale da nome, cognome, data e comune di nascita","cat":1},{"label":"Prevedere i numeri del Lotto dallo storico degli ultimi 50 anni","cat":1},{"label":"Stimare il prezzo delle case da 5 anni di compravendite","cat":0},{"label":"Una startup con 40 clienti e nessuna disdetta vuole prevedere le disdette","cat":2},{"label":"Concedere mutui dovendo motivare ogni rifiuto al cliente","cat":3},{"label":"Bloccare in tempo reale le frodi, che sono lo 0,1% delle transazioni","cat":3}],"explain":"Codice fiscale: regola nota. Lotto: tutto errore irriducibile. Disdette: manca l'esperienza E. Mutui: serve un modello interpretabile. Frodi: attenzione a sbilanciamento e costo degli errori."}]},{"title":"Quale task?","presentation":"bins","instructions":"Per ogni scenario, scegli il task adatto. Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 9 · slide 9-12","items":[{"id":"lab.cat.task","kind":"categorize","weight":3,"prompt":"Scenario → task","categories":["Classificazione","Regressione","Clustering","Servono prima etichette"],"entries":[{"label":"Organizzare in gruppi 50.000 prodotti senza categoria","cat":2},{"label":"Stimare quanto spenderà un'assicurazione in sinistri per ciascun cliente","cat":1},{"label":"Sapere se un cliente avrà almeno un sinistro l'anno prossimo","cat":0},{"label":"Capire quali fermate del bus hanno un utilizzo simile nella giornata","cat":2},{"label":"Riconoscere le fratture in 10.000 radiografie senza referto","cat":3}],"explain":"È la domanda a decidere il task, non i dati. E non avere etichette non significa poter usare il clustering: i gruppi di radiografie simili non dicono «frattura»."}]},{"title":"Diagnosi dei modelli","presentation":"battle","pick":4,"ref":"Lezione 9 · slide 21-31","items":[{"id":"lab.q.nb","kind":"mcq","prompt":"Naive Bayes con 2 sole feature: 72% di accuracy sul training e 71% sul test, baseline 70%. Diagnosi?","options":["Underfitting: va aggiunta qualche caratteristica","Overfitting: va potato","Compromesso ottimale","Data leakage"],"answer":0,"explain":"Errore alto già sul training e gap di 1 punto: il modello non apprende nemmeno i dati che vede."},{"id":"lab.q.albero","kind":"mcq","prompt":"Albero senza limite di profondità: 100% sul training, 74% sul test. Diagnosi?","options":["Overfitting: limitare la profondità o potare","Underfitting: aggiungere feature","Compromesso ottimale","Errore irriducibile"],"answer":0,"explain":"Gap di 26 punti: l'albero si è adattato al rumore del training."},{"id":"lab.q.fold","kind":"mcq","prompt":"Con la 10-fold le accuracy dei fold vanno da 0,68 a 0,93, media 0,80. Che cosa indica?","options":["Varianza alta: le prestazioni dipendono troppo da quali dati finiscono nel training","Bias alto","Dataset perfettamente bilanciato","Data leakage certo"],"answer":0,"explain":"Si interviene come per l'overfitting, verificando anche che i fold siano stratificati."},{"id":"lab.q.troppobasso","kind":"mcq","prompt":"L'errore sul test è molto più basso di quanto ti aspettassi. Che cosa sospetti per primo?","options":["Data leakage: controllare le feature e la procedura di validazione","Underfitting","Che il modello sia perfetto","Che servano più cluster"],"answer":0,"explain":"La domanda da farsi sempre: avrò questa informazione nel momento in cui il modello dovrà predire?"},{"id":"lab.q.unfattore","kind":"mcq","prompt":"Nell'esperimento sulla profondità dell'albero, perché si varia solo la profondità?","options":["Perché cambiando più fattori insieme non si saprebbe quale ha causato la variazione dell'errore","Perché le altre impostazioni non contano","Per ridurre il tempo di addestramento","Perché la profondità è l'unico parametro di un albero"],"answer":0,"explain":"Gli altri fattori sono potenziali fattori di confondimento e vanno tenuti fissi."},{"id":"lab.q.compromesso","kind":"mcq","prompt":"Quale profondità scegli se l'errore sul test è minimo alla profondità 5 e risale alla 6?","options":["5","10","1","6"],"answer":0,"explain":"Guardando solo il training sceglieresti 10, che sul test è tra le peggiori."},{"id":"lab.q.solleciti","kind":"mcq","prompt":"Si vuole predire, al momento della richiesta, se un cliente restituirà un prestito. Quale feature è un leaky predictor?","options":["Il numero di solleciti ricevuti per il prestito in esame","Il reddito annuo dichiarato alla richiesta","Il numero di prestiti ottenuti in precedenza","L'età del cliente"],"answer":0,"explain":"I solleciti esistono solo dopo l'erogazione: come l'antibiotico nella polmonite."}]}]}],"bossPool":[{"id":"boss3.naive","kind":"mcq","prompt":"Quale assunzione fa Naive Bayes?","options":["Che le caratteristiche siano indipendenti tra loro","Che le classi siano bilanciate","Che i dati siano lineari","Che i residui siano normali"],"answer":0,"explain":"Per questo è «ingenuo».","ref":"Lezione 6 · slide 4"},{"id":"boss3.gain","kind":"mcq","prompt":"Come sceglie l'attributo di split un albero decisionale di classificazione?","options":["Massimizzando l'information gain","Massimizzando l'entropia dei sottoinsiemi","Minimizzando l'MCC","A caso"],"answer":0,"explain":"Equivale a minimizzare l'entropia.","ref":"Lezione 6 · slide 31"},{"id":"boss3.recall","kind":"mcq","prompt":"Quale formula definisce la recall?","options":["TP / (TP + FN)","TP / (TP + FP)","TN / (TN + FP)","(TP + TN) / totale"],"answer":0,"explain":"Quante istanze positive il classificatore riesce a trovare.","ref":"Lezione 6 · slide 41"},{"id":"boss3.temporale","kind":"mcq","prompt":"Dati di vendita ordinati nel tempo: quale validazione è corretta?","options":["Una che addestra sul passato e testa sul futuro","La k-fold classica","Addestrare e testare su tutto","La stratified k-fold casuale"],"answer":0,"explain":"Altrimenti si usano dati futuri per predire il passato.","ref":"Lezione 6 · slide 38-39"},{"id":"boss3.beta0","kind":"mcq","prompt":"Nella retta ỹ = β0 + β1·x, che cosa rappresenta β0?","options":["Il valore di y quando x è zero","L'inclinazione della retta","Il residuo medio","La varianza dei residui"],"answer":0,"explain":"È l'intercetta.","ref":"Lezione 7 · slide 6"},{"id":"boss3.foglia","kind":"mcq","prompt":"Che valore si mette di solito nella foglia di un albero regressivo?","options":["La media dei valori target delle istanze che la raggiungono","La classe più frequente","L'entropia della foglia","Il valore massimo"],"answer":0,"explain":"La mediana se ci sono outlier.","ref":"Lezione 7 · slide 29"},{"id":"boss3.kmeans","kind":"mcq","prompt":"Quale limite ha k-means?","options":["Bisogna fissare k a priori","Non usa distanze","Richiede dati etichettati","Funziona solo con dati categorici"],"answer":0,"explain":"Il valore di k si sceglie con dati empirici, conoscenza del dominio o un algoritmo di ricerca.","ref":"Lezione 8 · slide 19"},{"id":"boss3.silhouette","kind":"mcq","prompt":"Quale metrica di clustering richiede delle etichette?","options":["MoJo distance","Silhouette coefficient","Elbow point","Somma degli errori quadrati"],"answer":0,"explain":"Le etichette vengono ignorate in costruzione e usate in validazione.","ref":"Lezione 8 · slide 41"},{"id":"boss3.dbscan","kind":"mcq","prompt":"Quale algoritmo di clustering scopre cluster di forma arbitraria?","options":["DBSCAN","k-means","k-medoids","Regressione lineare"],"answer":0,"explain":"È basato sulla densità, con i parametri minPts ed ε.","ref":"Lezione 8 · slide 39-40"},{"id":"boss3.radiografie","kind":"mcq","prompt":"Un ospedale ha 10.000 radiografie senza referto e vuole riconoscere le fratture. Che cosa serve?","options":["Far refertare un campione di immagini per avere etichette","Applicare k-means con k = 2","Usare la regressione lineare","Nulla: basta il clustering"],"answer":0,"explain":"Il clustering trova immagini simili, non fratture.","ref":"Lezione 9 · slide 11-12"}]},{"id":"L4","name":"Distretto Deep","implemented":true,"buildings":[{"id":"fucina","name":"Fucina dei Neuroni","stages":[{"title":"Dal biologico all'artificiale","presentation":"connect","instructions":"Collega ogni elemento del neurone biologico al suo corrispondente artificiale. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 10 · slide 11","items":[{"id":"fuc.match.neurone","kind":"match","weight":3,"prompt":"Neurone biologico → neurone artificiale","leftTitle":"Neurone biologico","rightTitle":"Neurone artificiale","pairs":[["Segnali provenienti da altri neuroni","Input x1, …, xn"],["Forza delle connessioni","Pesi w1, …, wn"],["Integrazione dei segnali","Somma pesata"],["Decisione di attivarsi","Funzione di attivazione"],["Segnale trasmesso lungo l'assone","Output"]],"explain":"z = x1w1 + … + xnwn, poi y = f(z). I pesi sono tra i parametri appresi dalla rete."}]},{"title":"Vero o Falso sull'incudine","presentation":"rush","timeLimitSec":15,"pick":8,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Lezione 10 · slide 2-26","items":[{"id":"fuc.tf.feature","kind":"tf","prompt":"Nei modelli shallow, rappresentare un'immagine richiede spesso una fase di feature engineering manuale.","answer":true,"explain":"Bordi, forme, texture: qualcuno deve decidere come misurarli."},{"id":"fuc.tf.rosenblatt","kind":"tf","prompt":"Il percettrone fu proposto da Frank Rosenblatt nel 1957.","answer":true,"explain":"Usa una funzione a gradino: nella forma più semplice è un classificatore binario."},{"id":"fuc.tf.heaviside","kind":"tf","prompt":"Se la soglia θ della funzione a gradino è 0, si parla di funzione Heaviside.","answer":true,"explain":"f(z) = 1 se z > θ, 0 altrimenti."},{"id":"fuc.tf.hebb","kind":"tf","prompt":"Secondo la regola di Hebb, se A contribuisce ripetutamente ad attivare B, la connessione tra A e B si indebolisce.","answer":false,"explain":"Si rafforza: «neurons that fire together, wire together»."},{"id":"fuc.tf.lr","kind":"tf","prompt":"Il learning rate η viene appreso dal percettrone durante il training.","answer":false,"explain":"È un iperparametro: lo definisce il progettista per bilanciare velocità e stabilità."},{"id":"fuc.tf.epoca","kind":"tf","prompt":"Un'epoca è l'applicazione del training a tutti gli esempi del training set una volta.","answer":true,"explain":"A ogni epoca si riparte dai pesi appresi nella precedente."},{"id":"fuc.tf.piuepoche","kind":"tf","prompt":"Più epoche producono sempre un modello migliore.","answer":false,"explain":"A un certo punto il modello smette di migliorare o va in overfitting."},{"id":"fuc.tf.and","kind":"tf","prompt":"L'AND logico è linearmente separabile.","answer":true,"explain":"Esiste una retta che separa l'unico esempio con y = 1 dagli altri."},{"id":"fuc.tf.xor","kind":"tf","prompt":"Con il giusto learning rate, un singolo percettrone può risolvere lo XOR.","answer":false,"explain":"XOR non è linearmente separabile: nessuna combinazione di pesi funziona."},{"id":"fuc.tf.frontiera","kind":"tf","prompt":"Il percettrone impara una frontiera di decisione lineare.","answer":true,"explain":"w1x1 + … + wnxn = θ identifica una retta (o un iperpiano)."}]},{"title":"Prova del Fabbro","presentation":"battle","pick":3,"ref":"Lezione 10 · slide 12-24","items":[{"id":"fuc.q.regola","kind":"mcq","prompt":"w = 0,5, η = 0,1, input x = 1, valore atteso 1, predizione 0. Quanto vale il nuovo peso con la Perceptron Learning Rule?","options":["0,6","0,4","0,5","1,5"],"answer":0,"explain":"w + η(y − ŷ)x = 0,5 + 0,1 · (1 − 0) · 1 = 0,6."},{"id":"fuc.q.corretto","kind":"mcq","prompt":"Se la predizione del percettrone è corretta, che cosa succede ai pesi?","options":["Non cambiano, perché l'errore (y − ŷ) è zero","Raddoppiano","Si azzerano","Cambiano a caso"],"answer":0,"explain":"La correzione è proporzionale all'errore commesso e agli input."},{"id":"fuc.q.contributo","kind":"mcq","prompt":"A produce sempre xA = 2. Con il peso wAB = 0,8, quale contributo arriva a B?","options":["1,6","0,4","2,8","0,8"],"answer":0,"explain":"wAB · xA = 0,8 · 2 = 1,6. Con wAB = 0,2 sarebbe 0,4: stesso segnale, influenza diversa."},{"id":"fuc.q.attivazione","kind":"mcq","prompt":"A che cosa serve la funzione di attivazione?","options":["A trasformare la somma pesata degli input nell'output del neurone","A scegliere quali input usare","A calcolare la loss","A inizializzare i pesi"],"answer":0,"explain":"Determina come il neurone reagisce e quale segnale trasmette ai successivi."},{"id":"fuc.q.passi","kind":"mcq","prompt":"Quale passo contraddistingue davvero il training del percettrone?","options":["La correzione dei pesi quando la predizione è errata","Il calcolo della somma pesata","La lettura degli input","La scelta della soglia θ"],"answer":0,"explain":"Predizione, errore, correzione, ripetizione: è la correzione a far apprendere."},{"id":"fuc.q.dl","kind":"mcq","prompt":"Qual è una delle idee fondamentali del Deep Learning?","options":["Apprendere non solo la soluzione, ma anche la rappresentazione dei dati utile a risolverla","Eliminare la necessità dei dati di training","Usare solo regole esplicite scritte dal progettista","Sostituire le reti con alberi decisionali"],"answer":0,"explain":"Deep Learning = Representation Learning + Task Learning."}]}]},{"id":"torre","name":"Torre degli Strati","stages":[{"title":"Il ciclo di apprendimento","presentation":"timeline","instructions":"Trascina i passi (o usa le frecce ▲▼) nell'ordine del ciclo di training di una rete, come nell'esempio del gatto.","ref":"Lezione 10 · slide 35-41","items":[{"id":"tor.order.training","kind":"order","weight":3,"prompt":"Ordina il ciclo di training","entries":[{"label":"Forward pass: la rete produce una predizione","reveal":"ŷ = 0,30"},{"label":"Loss function: quanto abbiamo sbagliato?","reveal":"L = (1 − 0,30)² = 0,49"},{"label":"Backpropagation: quali pesi correggere?","reveal":"gradienti della loss rispetto ai pesi"},{"label":"Gradient Descent: aggiorno i pesi","reveal":"nella direzione che riduce la loss, di un passo legato a η"},{"label":"Ripeto su molte istanze e per più epoche","reveal":"fino a generalizzare, non a errore zero sul training"}],"explain":"Forward pass, loss, backpropagation, gradient descent, ripetizione."}]},{"title":"Chi decide cosa?","presentation":"bins","instructions":"Che cosa decide il progettista e che cosa apprende la rete? Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 10 · slide 31-42","items":[{"id":"tor.cat.decide","kind":"categorize","weight":2,"prompt":"Elemento → chi lo determina","categories":["Il progettista","La rete, durante il training"],"entries":[{"label":"Profondità e larghezza della rete","cat":0},{"label":"La funzione di attivazione","cat":0},{"label":"Il learning rate","cat":0},{"label":"La loss function","cat":0},{"label":"I pesi delle connessioni","cat":1},{"label":"Le rappresentazioni costruite nei livelli nascosti","cat":1}],"explain":"Noi progettiamo lo spazio in cui la rete può apprendere; il training determina ciò che effettivamente apprende."}]},{"title":"Sfida della Guardiana","presentation":"battle","pick":4,"ref":"Lezione 10 · slide 27-43","items":[{"id":"tor.q.xor","kind":"mcq","prompt":"Come si ottiene lo XOR con due neuroni nascosti h1 = x1 ∨ x2 e h2 = x1 ∧ x2?","options":["h1 ∧ ¬h2","h1 ∨ h2","¬h1 ∧ h2","h1 ∧ h2"],"answer":0,"explain":"Vero se almeno uno è vero, ma non entrambi. Il primo livello costruisce una rappresentazione che semplifica il problema."},{"id":"tor.q.deep","kind":"mcq","prompt":"Quando una rete neurale diventa «deep»?","options":["Quando usa più livelli nascosti tra input e output","Quando ha più di mille neuroni","Quando usa la funzione a gradino","Quando viene addestrata per più di una epoca"],"answer":0,"explain":"Deep si riferisce al numero di trasformazioni successive dell'informazione."},{"id":"tor.q.larghezza","kind":"mcq","prompt":"Che cosa determina la larghezza di una rete?","options":["Quante rappresentazioni possono essere elaborate in parallelo a ciascun livello","Quante trasformazioni successive si applicano ai dati","La velocità di apprendimento","Il numero di epoche"],"answer":0,"explain":"La profondità è il numero di hidden layer; la larghezza il numero di neuroni per hidden layer."},{"id":"tor.q.capacita","kind":"mcq","prompt":"Quale rischio comporta aumentare profondità e larghezza?","options":["Servono più dati e risorse e aumenta il rischio di overfitting","La rete non può più apprendere","Si perde la funzione di attivazione","Si riduce la capacità del modello"],"answer":0,"explain":"Più capacità non significa necessariamente un modello migliore."},{"id":"tor.q.backprop","kind":"mcq","prompt":"Che cosa fa la backpropagation?","options":["Propaga l'errore dall'output verso i livelli precedenti, calcolando quanto ogni parametro contribuisce alla loss","Aggiorna i pesi con il learning rate","Produce la predizione a partire dagli input","Sceglie l'architettura della rete"],"answer":0,"explain":"Calcola i gradienti; è poi il gradient descent ad aggiornare i pesi."},{"id":"tor.q.cnn","kind":"mcq","prompt":"Quale architettura usa filtri per riconoscere pattern locali ed è adatta alle immagini?","options":["CNN","RNN","FNN","Transformer"],"answer":0,"explain":"Le Convolutional Neural Networks costruiscono rappresentazioni gerarchiche di dati spaziali."},{"id":"tor.q.rnn","kind":"mcq","prompt":"Quale architettura mantiene informazioni sugli elementi già elaborati per modellare sequenze e serie temporali?","options":["RNN","CNN","FNN","MLP fully-connected"],"answer":0,"explain":"Le Recurrent Neural Networks; i Transformer invece usano l'attention, e sono alla base degli LLM."},{"id":"tor.q.feedforward","kind":"mcq","prompt":"Che cosa significa che una rete è feedforward?","options":["Che l'informazione procede dagli input all'output senza cicli","Che ogni neurone è collegato a tutti quelli del livello successivo","Che usa l'attention","Che ha un solo livello"],"answer":0,"explain":"Collegare ogni neurone a tutti quelli del livello successivo è un layer fully-connected (dense)."}]}]},{"id":"biblioteca-transfer","name":"Biblioteca del Transfer","stages":[{"title":"Il catalogo dei concetti","presentation":"connect","instructions":"Collega ogni concetto alla sua definizione. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 11 · slide 3-23","items":[{"id":"tra.match.concetti","kind":"match","weight":3,"prompt":"Concetto → definizione","leftTitle":"Concetto","rightTitle":"Definizione","pairs":[["Memorizzazione","Riprodurre correttamente gli esempi visti durante il training"],["Generalizzazione","Fare predizioni corrette su esempi mai osservati"],["Grokking","Generalizzare all'improvviso dopo un lungo training su un training set già memorizzato"],["Pre-training","Addestrare su un task o dominio sorgente per ottenere rappresentazioni riutilizzabili"],["Freezing","Tenere fissi alcuni parametri pre-addestrati, aggiornando solo gli altri"],["Fine-tuning","Continuare l'addestramento sui dati target, aggiornando tutti o parte dei parametri"]],"explain":"Il fine-tuning è solo una delle possibili tecniche di adattamento."}]},{"title":"Prestito della Biblioteca","presentation":"battle","pick":4,"ref":"Lezione 11 · slide 2-26","items":[{"id":"tra.q.grokking","kind":"mcq","prompt":"Nell'esperimento di OpenAI del 2021, che cosa si osservò dopo un training molto lungo?","options":["L'accuratezza sul test, rimasta a lungo bassissima, salì improvvisamente vicino al 100%","L'accuratezza sul training crollò","Il modello dimenticò tutto il training set","La loss sul training aumentò all'infinito"],"answer":0,"explain":"È il grokking: dalla memorizzazione alla generalizzazione."},{"id":"tra.q.loss","kind":"mcq","prompt":"Che cosa ci dice, e che cosa non ci dice, la loss sul training?","options":["Quanto bene il modello risolve gli esempi di training, non come li sta risolvendo","Come il modello rappresenta internamente il problema","Quanto il modello generalizzerà sempre","Quale regola il modello ha imparato"],"answer":0,"explain":"Due modelli con la stessa loss possono aver imparato rappresentazioni diverse: qui nasce il problema dell'explainability."},{"id":"tra.q.or","kind":"mcq","prompt":"Quale condizione vale nel transfer learning?","options":["Ds ≠ Dt OR Ts ≠ Tt","Ds ≠ Dt AND Ts ≠ Tt","Ds = Dt AND Ts = Tt","Ts = Tt sempre"],"answer":0,"explain":"C'è un OR, non un AND: si può cambiare il task nello stesso dominio, o il dominio per lo stesso task."},{"id":"tra.q.agi","kind":"mcq","prompt":"Il transfer learning produce una Artificial General Intelligence?","options":["No, ma introduce il principio di non dover costruire un nuovo modello da zero per ogni task","Sì, è la definizione stessa di AGI","Sì, se il pre-training è abbastanza lungo","No, perché non usa reti neurali"],"answer":0,"explain":"È un primo passo verso capacità meno legate a un singolo problema."},{"id":"tra.q.freezing","kind":"mcq","prompt":"In un modello linguistico, perché si congelano spesso i primi strati?","options":["Perché catturano pattern sintattici di base e generici, che conviene preservare","Perché sono gli unici con pesi","Perché non partecipano alla predizione","Perché sono troppo pochi per essere addestrati"],"answer":0,"explain":"Più parametri aggiorniamo, più specializziamo il modello, ma aumentano costo e rischio di perdere rappresentazioni utili."},{"id":"tra.q.sentiment","kind":"mcq","prompt":"Nell'esempio del sentiment delle recensioni, su che cosa si fa il pre-training?","options":["Su un grande corpus di testo generico, come Wikipedia o BookCorpus","Solo sulle recensioni del prodotto specifico","Su immagini di prodotti","Su un dataset di numeri casuali"],"answer":0,"explain":"Si apprendono rappresentazioni linguistiche generiche, poi si adatta al sentiment."},{"id":"tra.q.step3","kind":"mcq","prompt":"Nel sequential transfer learning, il terzo step (adattamenti successivi) è...","options":["Opzionale: con pre-training e adattamento si parla già di sequential transfer learning","Obbligatorio","Il primo da eseguire","Un sinonimo di pre-training"],"answer":0,"explain":"Per esempio: modello generale → linguaggio scientifico → classificazione di articoli."},{"id":"tra.q.obiettivo","kind":"mcq","prompt":"Perché un modello addestrato a predire il prossimo token può imparare anche grammatica e significato?","options":["Perché l'obiettivo di training dice cosa ottimizzare, non tutto ciò che il modello dovrà imparare internamente per riuscirci","Perché glielo insegniamo con regole esplicite","Perché è magia","Perché usa la regressione lineare"],"answer":0,"explain":"Catturare regolarità lessicali, sintattiche e semantiche aiuta a predire bene il token successivo."}]}]},{"id":"officinatransformer","name":"Officina del Transformer","stages":[{"title":"La catena di montaggio dell'encoder","presentation":"timeline","instructions":"Trascina i passi (o usa le frecce ▲▼) nell'ordine in cui l'encoder elabora l'input.","ref":"Lezione 11 · slide 31-41","items":[{"id":"trf.order.encoder","kind":"order","weight":3,"prompt":"Ordina i passi dell'encoder","entries":[{"label":"Suddividere il testo in token"},{"label":"Trasformare ogni token in un embedding"},{"label":"Aggiungere il positional encoding"},{"label":"Multi-head self-attention, con residual connection e layer normalization"},{"label":"Feed-forward network, con residual connection e layer normalization"},{"label":"Ripetere il blocco N volte"}],"explain":"Token → embedding → posizione → self-attention → FFNN, il tutto ripetuto N volte."}]},{"title":"I modelli in vetrina","presentation":"connect","instructions":"Collega ogni modello o meccanismo alla sua descrizione. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 11 · slide 35-55","items":[{"id":"trf.match.pezzi","kind":"match","weight":3,"prompt":"Pezzo → descrizione","leftTitle":"Pezzo","rightTitle":"Descrizione","pairs":[["Query","Ciò che il token che stiamo elaborando cerca negli altri token"],["Key","Le caratteristiche con cui un token viene confrontato con una Query"],["Value","L'informazione che un token mette a disposizione degli altri"],["BERT","Solo encoder: rappresenta il testo, non lo genera"],["T5","Encoder e decoder: ogni problema è testo in input → testo in output"],["GPT","Solo decoder: predizione sequenziale, ideale per generare"]],"explain":"Attention(Q, K, V) = softmax(QKᵀ / √dₖ) V."}]},{"title":"Collaudo della Meccanica","presentation":"battle","pick":4,"ref":"Lezione 11 · slide 27-75","items":[{"id":"trf.q.radice","kind":"mcq","prompt":"Perché nell'attention i punteggi QKᵀ vengono divisi per √dₖ?","options":["Per tenere sotto controllo la scala dei punteggi, che crescono con la dimensione dei vettori, prima della softmax","Per renderli tutti negativi","Per eliminare i token futuri","Per contare il numero di head"],"answer":0,"explain":"È un fattore di correzione: senza, la softmax riceverebbe valori troppo estremi."},{"id":"trf.q.softmax","kind":"mcq","prompt":"Che cosa produce la softmax applicata ai punteggi di attention?","options":["Pesi di attenzione tra 0 e 1 con somma pari a 1","Gli embedding dei token","La posizione dei token","I token futuri"],"answer":0,"explain":"Poi i pesi moltiplicano V: i Value dei token più rilevanti contano di più."},{"id":"trf.q.multihead","kind":"mcq","prompt":"A che cosa serve la multi-head attention?","options":["A eseguire più processi di attention in parallelo, ciascuno con propri pesi, per cogliere relazioni diverse tra i token","A elaborare più frasi contemporaneamente","A sostituire la feed-forward network","A generare più risposte diverse"],"answer":0,"explain":"Le head vengono concatenate e combinate con la matrice Wᴼ."},{"id":"trf.q.masked","kind":"mcq","prompt":"Perché il decoder usa la masked self-attention?","options":["Per impedire di guardare i token futuri, che durante il training sarebbero una forma di data leakage","Per nascondere i token all'encoder","Per ridurre il vocabolario","Per velocizzare il training"],"answer":0,"explain":"La maschera assegna −∞ alle posizioni future: il decoder è autoregressivo."},{"id":"trf.q.cross","kind":"mcq","prompt":"Nella cross-attention, da dove provengono Q, K e V?","options":["Q dal decoder, K e V dall'encoder","Tutte dal decoder","Tutte dall'encoder","Q dall'encoder, K e V dal decoder"],"answer":0,"explain":"Serve quando l'output dipende da un input da elaborare, come nella traduzione."},{"id":"trf.q.temperatura","kind":"mcq","prompt":"Che effetto ha abbassare la temperature?","options":["Favorisce i token già più probabili, limitando la «creatività»","Aumenta la scelta di token poco probabili","Allunga le risposte","Aumenta il numero di head"],"answer":0,"explain":"Si applica ai logits prima della softmax."},{"id":"trf.q.topp","kind":"mcq","prompt":"Che cosa fa il top-p?","options":["Sceglie il più piccolo insieme di token con probabilità cumulativa almeno p, e campiona solo tra questi","Sceglie sempre il token più probabile","Limita il campionamento ai k token più probabili","Elimina i token con probabilità sopra p"],"answer":0,"explain":"Top-k e top-p definiscono l'insieme dei candidati, non scelgono necessariamente il più probabile."},{"id":"trf.q.embedding","kind":"mcq","prompt":"Come vengono definiti i valori degli embedding?","options":["Sono parametri del modello appresi durante il training","Li scrive a mano il progettista","Sono gli identificativi numerici dei token","Sono sempre casuali e fissi"],"answer":0,"explain":"La matrice E ∈ ℝ^(V×d) ha una riga per ogni token del vocabolario."},{"id":"trf.q.flakiness","kind":"mcq","prompt":"Lo stesso prompt dà risposte diverse a ogni esecuzione. Come si chiama il fenomeno?","options":["Flakiness","Allucinazione","Grokking","Overfitting"],"answer":0,"explain":"L'allucinazione è invece generare informazioni false presentandole come plausibili."},{"id":"trf.q.foundation","kind":"mcq","prompt":"Quali due elementi hanno portato ai foundation model?","options":["Il transfer learning e architetture capaci di gestire grandi moli di dati","La regressione lineare e il k-means","Il test di Turing e il PEAS","La CRISP-DM e lo SCRUM"],"answer":0,"explain":"Gli LLM sono uno dei tanti foundation model, generalizzabili tramite fine-tuning o prompting."}]}]},{"id":"agenzia-genai","name":"Agenzia degli Agenti GenAI","stages":[{"title":"La cassetta degli attrezzi","presentation":"bins","instructions":"In quale famiglia di tool rientra ognuno? Puoi cliccare una carta già smistata per riprenderla.","ref":"Lezione 12 · slide 15-23","items":[{"id":"gen.cat.tool","kind":"categorize","weight":3,"prompt":"Tool → famiglia","categories":["Information & Retrieval","Action & Execution","Control & Governance"],"entries":[{"label":"Web search per informazioni aggiornate","cat":0},{"label":"RAG su una knowledge base di documenti","cat":0},{"label":"Query a un database","cat":0},{"label":"Inviare un'e-mail o un messaggio","cat":1},{"label":"Eseguire codice o comandi","cat":1},{"label":"Creare un evento o effettuare una prenotazione","cat":1},{"label":"Guardrail: «non inviare dati personali a servizi esterni»","cat":2},{"label":"Permessi: leggere il repository ma non fare deploy in produzione","cat":2},{"label":"Human-in-the-loop prima delle azioni rischiose","cat":2}],"explain":"Le prime due famiglie estendono ciò che l'agente sa e fa; Control & Governance stabilisce cosa può fare e a quali condizioni."}]},{"title":"Il loop dell'agente","presentation":"timeline","instructions":"Goal: tre giorni a Parigi con 600 €. Trascina i passi (o usa le frecce ▲▼) nell'ordine del loop agentico.","ref":"Lezione 12 · slide 8-10","items":[{"id":"gen.order.parigi","kind":"order","weight":2,"prompt":"Ordina il loop dell'esempio di Parigi","entries":[{"label":"Observe: trova voli e hotel disponibili"},{"label":"Reason: seleziona una combinazione promettente"},{"label":"Act: verifica disponibilità e prezzi con i tool"},{"label":"Observe: il costo complessivo è 680 €"},{"label":"Reason: il vincolo è violato, il piano va modificato"},{"label":"Act: cerca un hotel più economico"},{"label":"Reason: 570 €, obiettivo soddisfatto, stop"}],"explain":"Observe, reason/plan, act, ripetuti finché l'obiettivo è raggiunto."}]},{"title":"Riunione in Agenzia","presentation":"battle","pick":4,"ref":"Lezione 12 · slide 2-32","items":[{"id":"gen.q.definizione","kind":"mcq","prompt":"Che cos'è un agente GenAI?","options":["Un'applicazione che cerca di raggiungere un obiettivo osservando l'ambiente e agendo su di esso con i tool a disposizione","Un nuovo tipo di rete neurale più grande di un LLM","Un LLM con più parametri","Un chatbot senza memoria"],"answer":0,"explain":"È un sistema software che integra un foundation model con altri componenti."},{"id":"gen.q.loopeng","kind":"mcq","prompt":"Che cos'è il loop engineering?","options":["La progettazione del ciclo operativo dell'agente: come osserva, decide, agisce, verifica e quando si ferma o chiede aiuto","La scrittura di un singolo prompt","Il fine-tuning dell'LLM","L'ottimizzazione dei cicli for nel codice"],"answer":0,"explain":"Generalizza il prompt engineering e permette di programmare il livello di autonomia in base al rischio."},{"id":"gen.q.rag","kind":"mcq","prompt":"Che cosa modifica l'augmentation nel RAG?","options":["Il contesto fornito al modello, non il modello","I pesi del modello","L'architettura del Transformer","Il vocabolario dei token"],"answer":0,"explain":"Le informazioni recuperate dal retriever vengono aggiunte dinamicamente al prompt."},{"id":"gen.q.retriever","kind":"mcq","prompt":"Che cosa fa il retriever in un RAG basato su vector DB?","options":["Trasforma la query in embedding, cerca i vettori più simili e passa all'LLM i k chunk più rilevanti","Riaddestra l'LLM sui documenti","Esegue una query SQL esatta","Genera la risposta finale"],"answer":0,"explain":"Un DB vettoriale memorizza e ricerca vettori ad alta dimensionalità come gli embedding."},{"id":"gen.q.mcp","kind":"mcq","prompt":"Che cos'è il Model Context Protocol (MCP)?","options":["Uno standard client-server per connettere applicazioni di IA a tool, dati e sistemi esterni","Un algoritmo di attention","Una tecnica di fine-tuning","Un formato di file per i dataset"],"answer":0,"explain":"Gli MCP server espongono tool e risorse, l'MCP client li rende disponibili all'agente."},{"id":"gen.q.memoria","kind":"mcq","prompt":"Qual è la differenza tra memoria e contesto?","options":["Il contesto sono le informazioni disponibili in una specifica inferenza; la memoria conserva informazioni e le recupera quando servono","Sono sinonimi","La memoria è la RAM del computer","Il contesto dura per sempre, la memoria solo per un turno"],"answer":0,"explain":"Esiste memoria a breve e a lungo termine; l'orchestratore decide cosa ricordare e cosa dimenticare."},{"id":"gen.q.dimenticare","kind":"mcq","prompt":"Perché un agente dovrebbe dimenticare?","options":["Per evitare informazioni irrilevanti, obsolete, ridondanti o sensibili non più necessarie","Perché la memoria è sempre piena","Non dovrebbe mai dimenticare","Per ridurre i parametri del modello"],"answer":0,"explain":"Dimenticare è una funzione della memoria: conta la forgetting policy."},{"id":"gen.q.serve","kind":"mcq","prompt":"«Riassumi questo documento.» Serve un agente?","options":["No: un task semplice basta un LLM; l'agente serve quando il task richiede un workflow","Sì, sempre","Sì, un sistema multi-agente","No, serve un modello shallow"],"answer":0,"explain":"Più agenticità significa più flessibilità ma anche più complessità, costo e rischio."},{"id":"gen.q.rischi","kind":"mcq","prompt":"Quale rischio è tipico degli agenti e non di un singolo LLM?","options":["Agire in autonomia sulla base di una risposta errata, con errori che si propagano","Generare testo","Usare token","Avere un vocabolario"],"answer":0,"explain":"Rischi: error propagation, unintended actions, sicurezza, costi e runaway loops, necessità di human oversight."}]}]},{"id":"collaudo","name":"Collaudo SE4AI","stages":[{"title":"Le tecniche del collaudo","presentation":"connect","instructions":"Collega ogni tecnica alla sua descrizione. Clicca una voce a sinistra e poi una a destra.","ref":"Lezione 13 · slide 6-38","items":[{"id":"col.match.tecniche","kind":"match","weight":3,"prompt":"Tecnica → descrizione","leftTitle":"Tecnica","rightTitle":"Descrizione","pairs":[["SE4AI","Principi e pratiche dell'ingegneria del software per sistemi con componenti di IA"],["Property-based testing","Si definiscono proprietà che il comportamento deve rispettare, invece dell'output atteso"],["Counterfactual testing","Si cambia una caratteristica che non dovrebbe contare e si verifica che il comportamento resti coerente"],["Architectural runtime assurance","Controlli integrati nell'architettura che verificano e correggono l'output a runtime"],["LLM-as-a-Judge","Un LLM valuta l'output di un altro modello rispetto a criteri espliciti"],["Context engineering","Progettazione sistematica del contesto informativo dato al modello o all'agente"]],"explain":"Sono problemi di ingegnerizzazione di sistemi AI-enabled, non solo di algoritmi."}]},{"title":"Verbale del collaudo","presentation":"battle","pick":4,"ref":"Lezione 13 · slide 2-42","items":[{"id":"col.q.m1m2","kind":"mcq","prompt":"M1: 98% in 2 secondi. M2: 94% in 50 ms. Il sistema deve decidere su un flusso video entro 100 ms. Quale scegli?","options":["M2","M1","Entrambi vanno bene","Nessuno dei due, servono più dati"],"answer":0,"explain":"Il miglior modello non è il più accurato, ma quello che soddisfa meglio i requisiti del sistema."},{"id":"col.q.oracolo","kind":"mcq","prompt":"Perché assert(actual == expected) non funziona per testare un chatbot basato su LLM?","options":["Perché non esiste necessariamente un unico output corretto","Perché gli LLM non producono output","Perché il test è troppo veloce","Perché gli LLM sono deterministici"],"answer":0,"explain":"Ci si chiede se il comportamento rispetta la proprietà, non se coincide con un output previsto."},{"id":"col.q.controfattuale","kind":"mcq","prompt":"«Sono un ragazzo…» e «Sono una ragazza…», a parità di interessi, ricevono la stessa raccomandazione. Che test è?","options":["Counterfactual testing","Unit testing con oracolo","Test di Turing","Convalida incrociata"],"answer":0,"explain":"Cambiare il genere, che non dovrebbe contare, non deve cambiare la raccomandazione."},{"id":"col.q.probabilistico","kind":"mcq","prompt":"Con un LLM, che cosa si può garantire sulle allucinazioni?","options":["Al massimo di mantenere il tasso di risposte errate sotto una soglia","Che non ce ne saranno mai","Che si eliminano con più epoche","Che dipendono solo dall'utente"],"answer":0,"explain":"Molti requisiti sono probabilistici: l'incertezza del componente entra nella specifica."},{"id":"col.q.judge","kind":"mcq","prompt":"Quale attenzione serve con un LLM-as-a-Judge?","options":["Va progettato con criteri espliciti, ed è a sua volta probabilistico e fallibile","Basta dirgli «valuta questa risposta»","È sempre più affidabile di un umano","Non può introdurre bias"],"answer":0,"explain":"È utile quando non esiste un oracolo deterministico."},{"id":"col.q.prompt","kind":"mcq","prompt":"Come andrebbe trattato un prompt secondo la lezione?","options":["Come un pezzo di codice: progettato, versionato, testato e modificato controllandone gli effetti","Come una frase da scrivere di getto","Come un dato di training","Come un segreto da non condividere"],"answer":0,"explain":"Proprietà misurabili dei prompt, come la leggibilità, sono associate alla qualità degli output."},{"id":"col.q.contextfiles","kind":"mcq","prompt":"Che cosa sono gli Agent Context Files?","options":["File persistenti con istruzioni, regole e vincoli che l'agente considera durante i suoi task","I log delle conversazioni","I pesi del modello salvati su disco","I file temporanei del sistema operativo"],"answer":0,"explain":"Rendono parte delle specifiche consumabile dall'agente, e vanno ingegnerizzati."},{"id":"col.q.conflitto","kind":"mcq","prompt":"Qualità della raccomandazione e sforzo di interazione sono in conflitto. Come si formula il problema?","options":["Come ottimizzazione multi-obiettivo, cercando i migliori trade-off","Come classificazione binaria","Come un problema senza soluzione","Scegliendo sempre il massimo numero di domande"],"answer":0,"explain":"Non c'è una soluzione unica: è il ponte verso le lezioni sugli algoritmi di ricerca."},{"id":"col.q.aiact","kind":"mcq","prompt":"Che cosa richiede l'AI Act ai sistemi ad alto rischio?","options":["Di registrare gli eventi, garantire la tracciabilità delle decisioni e supportare analisi a posteriori","Di usare solo modelli deep","Di non usare dati","Di massimizzare solo l'accuratezza"],"answer":0,"explain":"Oltre a livelli adeguati di accuratezza, resilienza e protezione da manipolazioni e attacchi."}]}]}],"bossPool":[{"id":"boss4.dl","kind":"mcq","prompt":"Deep Learning = ?","options":["Representation Learning + Task Learning","Feature engineering manuale + regressione","Clustering + classificazione","Prompt engineering + RAG"],"answer":0,"explain":"Il modello impara anche la rappresentazione dei dati.","ref":"Lezione 10 · slide 5"},{"id":"boss4.xor","kind":"mcq","prompt":"Perché un singolo percettrone non risolve lo XOR?","options":["Perché XOR non è linearmente separabile","Perché il learning rate è troppo basso","Perché servono più epoche","Perché manca la funzione Heaviside"],"answer":0,"explain":"Serve almeno un livello nascosto.","ref":"Lezione 10 · slide 26"},{"id":"boss4.lr","kind":"mcq","prompt":"Nella regola del percettrone, che cos'è η?","options":["Il learning rate, un iperparametro","Un peso appreso","L'errore di predizione","La soglia di attivazione"],"answer":0,"explain":"Stabilisce quanto grande è la correzione, non la direzione.","ref":"Lezione 10 · slide 19-23"},{"id":"boss4.backprop","kind":"mcq","prompt":"Quale algoritmo calcola quanto ciascun peso contribuisce alla loss?","options":["Backpropagation","Gradient descent","Forward pass","Softmax"],"answer":0,"explain":"Il gradient descent poi aggiorna i pesi.","ref":"Lezione 10 · slide 32"},{"id":"boss4.grok","kind":"mcq","prompt":"Come si chiama il passaggio improvviso dalla memorizzazione alla generalizzazione dopo un training molto lungo?","options":["Grokking","Fine-tuning","Freezing","Overfitting"],"answer":0,"explain":"Osservato da OpenAI nel 2021.","ref":"Lezione 11 · slide 6"},{"id":"boss4.transfer","kind":"mcq","prompt":"Nel transfer learning vale...","options":["Ds ≠ Dt OR Ts ≠ Tt","Ds ≠ Dt AND Ts ≠ Tt","Ds = Dt e Ts = Tt","nessun vincolo"],"answer":0,"explain":"C'è un OR.","ref":"Lezione 11 · slide 16"},{"id":"boss4.gpt","kind":"mcq","prompt":"Quale modello è solo decoder?","options":["GPT","BERT","T5","RoBERTa"],"answer":0,"explain":"BERT e RoBERTa sono encoder, T5 encoder-decoder.","ref":"Lezione 11 · slide 51-55"},{"id":"boss4.mask","kind":"mcq","prompt":"A che cosa serve la maschera nella masked self-attention del decoder?","options":["A impedire di guardare i token futuri","A nascondere l'input dell'encoder","A ridurre i parametri","A scegliere la temperature"],"answer":0,"explain":"Altrimenti in training sarebbe data leakage.","ref":"Lezione 11 · slide 44-45"},{"id":"boss4.rag","kind":"mcq","prompt":"Nel RAG, che cosa viene modificato per migliorare la risposta?","options":["Il contesto del modello","I pesi del modello","Il vocabolario","La loss function"],"answer":0,"explain":"L'augmentation costruisce dinamicamente parte del prompt.","ref":"Lezione 12 · slide 21"},{"id":"boss4.loop","kind":"mcq","prompt":"Quali sono le fasi del loop agentico?","options":["Observe, reason/plan, act","Train, test, deploy","Encode, decode, softmax","Forward, loss, backprop"],"answer":0,"explain":"Ripetute rispetto al goal.","ref":"Lezione 12 · slide 8"},{"id":"boss4.counter","kind":"mcq","prompt":"Come si verifica che un chatbot non discrimini per genere?","options":["Con un counterfactual test che cambia solo il genere","Con un unico output atteso","Massimizzando l'accuratezza","Con la k-fold"],"answer":0,"explain":"La proprietà deve valere al variare di una caratteristica irrilevante.","ref":"Lezione 13 · slide 21"},{"id":"boss4.migliore","kind":"mcq","prompt":"In un contesto reale, qual è il miglior modello?","options":["Quello che meglio soddisfa i requisiti del sistema","Quello con l'accuratezza più alta","Quello con più parametri","Quello più recente"],"answer":0,"explain":"Latenza, fairness, explainability e costi contano quanto l'accuratezza.","ref":"Lezione 13 · slide 4-6"}]},{"id":"L5","name":"Colli della Ricerca Locale","implemented":true,"buildings":[{"id":"baita","name":"Baita dell'Alpinista","stages":[{"title":"Il vocabolario della montagna","presentation":"connect","instructions":"Clicca una voce a sinistra e poi quella corrispondente a destra.","ref":"Ricerca Locale · AIMA 4.1","items":[{"id":"bai.match.voc","kind":"match","weight":3,"prompt":"Concetto → significato","leftTitle":"Concetto","rightTitle":"Significato","pairs":[["Stato corrente","L'unica configurazione che l'algoritmo tiene in memoria"],["Vicinato","Gli stati raggiungibili con una piccola modifica"],["Funzione obiettivo","Il valore da massimizzare (o il costo da minimizzare)"],["Panorama degli stati","Gli stati disposti sul piano, con l'obiettivo come altitudine"],["Ottimo globale","Lo stato con il valore migliore in assoluto"]],"explain":"Ogni stato è una soluzione completa (magari pessima): la ricerca locale la migliora passo passo."}]},{"title":"Vero o Falso in quota","presentation":"rush","timeLimitSec":15,"pick":8,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Ricerca Locale · AIMA 4.1","items":[{"id":"bai.tf.cammino","kind":"tf","prompt":"Nella ricerca locale l'algoritmo restituisce il cammino dallo stato iniziale alla soluzione.","answer":false,"explain":"Restituisce uno stato: il cammino non interessa."},{"id":"bai.tf.memoria","kind":"tf","prompt":"La ricerca locale usa pochissima memoria, spesso costante.","answer":true,"explain":"Basta ricordare lo stato corrente (e magari il migliore visto)."},{"id":"bai.tf.grandi","kind":"tf","prompt":"La ricerca locale è adatta a spazi degli stati enormi o continui.","answer":true,"explain":"Non deve esplorarli sistematicamente."},{"id":"bai.tf.completo","kind":"tf","prompt":"L'hill climbing semplice è completo: se una soluzione esiste, la trova sempre.","answer":false,"explain":"Può bloccarsi in un massimo locale."},{"id":"bai.tf.greedy","kind":"tf","prompt":"L'hill climbing è detto anche ricerca locale greedy.","answer":true,"explain":"Sceglie il vicino migliore senza pensare al dopo."},{"id":"bai.tf.indietro","kind":"tf","prompt":"L'hill climbing torna indietro quando incontra un vicolo cieco.","answer":false,"explain":"Non fa backtracking: si ferma quando nessun vicino è migliore."},{"id":"bai.tf.minimizza","kind":"tf","prompt":"Se l'obiettivo è un costo da minimizzare, lo stesso algoritmo si chiama discesa del gradiente o gradient descent.","answer":true,"explain":"Stessa idea, verso il basso invece che verso l'alto."},{"id":"bai.tf.ottimizzazione","kind":"tf","prompt":"La ricerca locale si usa per problemi di ottimizzazione come scheduling e progettazione di circuiti.","answer":true,"explain":"Problemi in cui conta la configurazione finale."},{"id":"bai.tf.vicinicasuali","kind":"tf","prompt":"L'hill climbing a ogni passo sceglie un vicino a caso, anche peggiore.","answer":false,"explain":"Quella è un'altra idea (simulated annealing). L'hill climbing sceglie il vicino migliore."},{"id":"bai.tf.stop","kind":"tf","prompt":"L'hill climbing termina quando nessun vicino ha un valore migliore dello stato corrente.","answer":true,"explain":"Ha raggiunto una «vetta», non necessariamente la più alta."}]},{"title":"Prova delle Otto Regine","presentation":"battle","pick":3,"ref":"Ricerca Locale · AIMA 4.1.1","items":[{"id":"bai.q.regine","kind":"mcq","prompt":"Nelle 8 regine con formulazione a stato completo (una regina per colonna), quanti vicini ha uno stato se un vicino sposta una regina nella sua colonna?","options":["56","8","64","28"],"answer":0,"explain":"8 regine × 7 caselle alternative = 56."},{"id":"bai.q.euristica","kind":"mcq","prompt":"Quale euristica h si usa tipicamente per le 8 regine?","options":["Il numero di coppie di regine che si attaccano","Il numero di regine sulla scacchiera","La distanza della regina dall'angolo","Il numero di mosse fatte finora"],"answer":0,"explain":"Si minimizza h: una soluzione ha h = 0."},{"id":"bai.q.restituisce","kind":"mcq","prompt":"Che cosa restituisce l'hill climbing quando si ferma?","options":["Lo stato corrente, un massimo (forse solo locale)","Il cammino percorso","Tutti gli stati visitati","Sempre l'ottimo globale"],"answer":0,"explain":"Restituisce lo stato in cui si è fermato."},{"id":"bai.q.pregio","kind":"mcq","prompt":"Qual è il principale vantaggio della ricerca locale rispetto alla ricerca sistematica?","options":["Usa poca memoria e trova buone soluzioni in spazi enormi","Garantisce sempre la soluzione ottima","Restituisce il cammino più breve","Non richiede una funzione obiettivo"],"answer":0,"explain":"Rinuncia alla completezza in cambio di efficienza."},{"id":"bai.q.successo","kind":"mcq","prompt":"Dalle 8 regine con stato iniziale casuale, l'hill climbing a salita più ripida risolve il problema circa nel 14% dei casi. Che cosa succede nell'86% restante?","options":["Si blocca in un minimo locale di h","Va in loop infinito","Esaurisce la memoria","Trova una soluzione sbagliata con h = 0"],"answer":0,"explain":"Però è velocissimo: circa 4 passi quando riesce, 3 quando si blocca."},{"id":"bai.q.stato","kind":"mcq","prompt":"Che cos'è uno stato in una formulazione «a stato completo»?","options":["Una soluzione candidata completa, anche se non valida","Una soluzione parziale da estendere","Un cammino dalla radice","Un nodo foglia dell'albero di gioco"],"answer":0,"explain":"Si parte da una configurazione completa e la si modifica."}]}]},{"id":"belvedere","name":"Belvedere delle Trappole","stages":[{"title":"Riconosci la trappola","presentation":"bins","instructions":"Puoi cliccare una carta già smistata per riprenderla.","ref":"Ricerca Locale · AIMA 4.1.1","items":[{"id":"blv.cat.trappole","kind":"categorize","weight":3,"prompt":"Situazione → trappola","categories":["Massimo locale","Plateau","Cresta"],"entries":[{"label":"Un picco più alto dei vicini ma più basso della vetta globale","cat":0},{"label":"Nelle 8 regine: h = 1 e ogni mossa peggiora la situazione","cat":0},{"label":"Tutti i vicini hanno lo stesso valore dello stato corrente","cat":1},{"label":"Una «spalla» piatta da cui, proseguendo, si potrebbe ancora salire","cat":1},{"label":"Una sequenza di massimi locali difficile da percorrere con mosse singole","cat":2},{"label":"Si sale solo muovendosi in diagonale, ma le mosse disponibili sono orizzontali e verticali","cat":2}],"explain":"Massimi locali, plateau e creste sono i tre motivi classici per cui l'hill climbing si blocca."}]},{"title":"Problema e rimedio","presentation":"connect","instructions":"Clicca una voce a sinistra e poi quella corrispondente a destra.","ref":"Ricerca Locale · AIMA 4.1.1","items":[{"id":"blv.match.varianti","kind":"match","weight":3,"prompt":"Variante → idea","leftTitle":"Variante","rightTitle":"Idea","pairs":[["Mosse laterali (sideways moves)","Accetta vicini di pari valore per attraversare i plateau, con un limite di passi"],["Hill climbing stocastico","Sceglie a caso tra i vicini che migliorano, con probabilità legata alla pendenza"],["First-choice hill climbing","Genera vicini a caso e prende il primo che migliora"],["Random restart","Ripete l'hill climbing da stati iniziali casuali finché trova una soluzione"]],"explain":"Il random restart è completo con probabilità che tende a 1: prima o poi si parte dal pendio giusto."}]},{"title":"Prova del Belvedere","presentation":"battle","pick":3,"ref":"Ricerca Locale · AIMA 4.1.1","items":[{"id":"blv.q.sideways","kind":"mcq","prompt":"Con fino a 100 mosse laterali consecutive, le 8 regine passano dal 14% a circa il 94% di successi. Qual è il prezzo?","options":["Più passi per istanza (circa 21 quando riesce, 64 quando fallisce)","Più memoria esponenziale","La perdita della funzione obiettivo","Nessun prezzo"],"answer":0,"explain":"Attraversare i plateau richiede più passi."},{"id":"blv.q.restart","kind":"mcq","prompt":"Se ogni hill climbing ha probabilità p di successo, quanti riavvii servono in media con il random restart?","options":["1/p","p","p²","1 − p"],"answer":0,"explain":"Con p ≈ 0,14 servono circa 7 iterazioni."},{"id":"blv.q.limite","kind":"mcq","prompt":"Perché le mosse laterali hanno un limite al numero di passi consecutivi?","options":["Per evitare un ciclo infinito su un plateau senza uscita","Per risparmiare memoria","Per rendere l'algoritmo ottimo","Perché la funzione obiettivo cambia nel tempo"],"answer":0,"explain":"Su un massimo locale piatto si girerebbe all'infinito."},{"id":"blv.q.firstchoice","kind":"mcq","prompt":"Quando conviene il first-choice hill climbing?","options":["Quando ogni stato ha moltissimi vicini","Quando lo spazio ha pochissimi stati","Quando serve il cammino","Quando la funzione obiettivo è costante"],"answer":0,"explain":"Evita di valutare tutti i vicini a ogni passo."},{"id":"blv.q.forma","kind":"mcq","prompt":"Da che cosa dipende soprattutto il successo dell'hill climbing?","options":["Dalla forma del panorama degli stati","Dalla velocità del computer","Dal linguaggio di programmazione","Dal numero di obiettivi"],"answer":0,"explain":"Con pochi massimi locali e plateau, un random restart trova presto una buona soluzione."},{"id":"blv.q.milioni","kind":"mcq","prompt":"Con il random restart, quanto tempo serve per risolvere le n regine anche per n molto grandi?","options":["Pochissimo: anche milioni di regine in tempi brevi","Un tempo esponenziale in n","Non si possono risolvere","Esattamente n² secondi"],"answer":0,"explain":"Le n regine sono un caso particolarmente favorevole."}]}]},{"id":"fornace","name":"Fornace della Tempra","stages":[{"title":"Il ciclo della fornace","presentation":"timeline","instructions":"Trascina i passi (o usa le frecce ▲▼) nell'ordine di un'iterazione del simulated annealing.","ref":"Ricerca Locale · AIMA 4.1.2","items":[{"id":"frn.order.sa","kind":"order","weight":3,"prompt":"Ordina un passo del simulated annealing","entries":[{"label":"Leggo la temperatura T dallo schedule","reveal":"T scende a ogni iterazione"},{"label":"Se T = 0, restituisco lo stato corrente","reveal":"il raffreddamento è finito"},{"label":"Scelgo un vicino a caso","reveal":"non il migliore: uno qualsiasi"},{"label":"Calcolo ΔE = valore(vicino) − valore(corrente)","reveal":"ΔE > 0 vuol dire che migliora"},{"label":"Se ΔE > 0 mi sposto; altrimenti mi sposto con probabilità e^(ΔE/T)","reveal":"le mosse peggiori si accettano sempre meno"}],"explain":"Temperatura, test di arresto, vicino casuale, ΔE, accettazione probabilistica."}]},{"title":"Vero o Falso sulla brace","presentation":"rush","timeLimitSec":15,"pick":6,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Ricerca Locale · AIMA 4.1.2","items":[{"id":"frn.tf.peggiori","kind":"tf","prompt":"Il simulated annealing può accettare mosse che peggiorano la funzione obiettivo.","answer":true,"explain":"È proprio così che esce dai massimi locali."},{"id":"frn.tf.alta","kind":"tf","prompt":"Con T alta le mosse peggiorative vengono accettate più spesso.","answer":true,"explain":"e^(ΔE/T) si avvicina a 1 quando T è grande."},{"id":"frn.tf.bassa","kind":"tf","prompt":"Con T vicina a 0 il simulated annealing si comporta quasi come l'hill climbing.","answer":true,"explain":"Le mosse peggiorative diventano quasi impossibili."},{"id":"frn.tf.sempre","kind":"tf","prompt":"Una mossa che peggiora di poco viene accettata meno spesso di una che peggiora di molto.","answer":false,"explain":"Il contrario: più è grande il peggioramento, minore è la probabilità."},{"id":"frn.tf.migliore","kind":"tf","prompt":"Il simulated annealing sceglie a ogni passo il vicino migliore.","answer":false,"explain":"Sceglie un vicino a caso."},{"id":"frn.tf.lento","kind":"tf","prompt":"Se T scende abbastanza lentamente, l'algoritmo trova l'ottimo globale con probabilità che tende a 1.","answer":true,"explain":"È un risultato teorico: nella pratica lo schedule va calibrato."},{"id":"frn.tf.uso","kind":"tf","prompt":"Il simulated annealing è stato usato per il layout dei circuiti VLSI e per la pianificazione delle fabbriche.","answer":true,"explain":"È un classico dell'ottimizzazione combinatoria."},{"id":"frn.tf.schedule","kind":"tf","prompt":"Lo schedule di raffreddamento è appreso automaticamente dall'algoritmo.","answer":false,"explain":"Lo sceglie il progettista: è un iperparametro."}]},{"title":"Prova della Fonditrice","presentation":"battle","pick":3,"ref":"Ricerca Locale · AIMA 4.1.2","items":[{"id":"frn.q.prob","kind":"mcq","prompt":"ΔE = −2 e T = 2. Con quale probabilità il simulated annealing accetta la mossa?","options":["e^(−1) ≈ 0,37","e^(−4) ≈ 0,02","1","0"],"answer":0,"explain":"e^(ΔE/T) = e^(−2/2) = e^(−1)."},{"id":"frn.q.migliora","kind":"mcq","prompt":"ΔE = +3. Che cosa fa il simulated annealing?","options":["Accetta sempre la mossa","La accetta con probabilità e^(−3/T)","La rifiuta sempre","Abbassa la temperatura e riprova"],"answer":0,"explain":"Le mosse migliorative si accettano sempre."},{"id":"frn.q.idea","kind":"mcq","prompt":"Qual è l'idea chiave del simulated annealing?","options":["Combinare il movimento casuale con la salita, accettando sempre meno mosse peggiori","Esplorare tutti i vicini a ogni passo","Tenere in memoria k stati","Ricominciare da uno stato casuale a ogni passo"],"answer":0,"explain":"Esplorazione all'inizio, sfruttamento alla fine."},{"id":"frn.q.confronto","kind":"mcq","prompt":"T passa da 10 a 1 con ΔE = −5. Come cambia la probabilità di accettare la mossa?","options":["Scende da circa 0,61 a circa 0,007","Sale da circa 0,007 a circa 0,61","Resta uguale","Diventa negativa"],"answer":0,"explain":"e^(−0,5) ≈ 0,61; e^(−5) ≈ 0,007."},{"id":"frn.q.random","kind":"mcq","prompt":"Una passeggiata casuale pura (random walk) è...","options":["completa ma estremamente inefficiente","efficiente ma incompleta","sempre ottima","identica all'hill climbing"],"answer":0,"explain":"Il simulated annealing cerca un equilibrio tra random walk e hill climbing."}]}]},{"id":"serragenetica","name":"Serra Genetica","stages":[{"title":"Una generazione in serra","presentation":"timeline","instructions":"Trascina i passi (o usa le frecce ▲▼) nell'ordine di una generazione dell'algoritmo genetico.","ref":"Ricerca Locale · AIMA 4.1.4","items":[{"id":"ser.order.ga","kind":"order","weight":3,"prompt":"Ordina i passi di una generazione di un algoritmo genetico","entries":[{"label":"Parto da una popolazione di k individui","reveal":"per esempio stringhe di cifre"},{"label":"Valuto ogni individuo con la funzione di fitness","reveal":"nelle 8 regine: coppie che NON si attaccano"},{"label":"Seleziono i genitori, con probabilità proporzionale alla fitness","reveal":"i migliori si riproducono di più"},{"label":"Incrocio i genitori in un punto di crossover","reveal":"il figlio prende un pezzo da ciascuno"},{"label":"Applico una mutazione casuale con bassa probabilità","reveal":"cambia un gene a caso"},{"label":"I figli formano la nuova popolazione","reveal":"e si ricomincia"}],"explain":"Popolazione, fitness, selezione, crossover, mutazione, nuova generazione."}]},{"title":"Gli attrezzi del giardiniere","presentation":"connect","instructions":"Clicca una voce a sinistra e poi quella corrispondente a destra.","ref":"Ricerca Locale · AIMA 4.1.3-4.1.4","items":[{"id":"ser.match.termini","kind":"match","weight":3,"prompt":"Termine → significato","leftTitle":"Termine","rightTitle":"Significato","pairs":[["Individuo","Uno stato codificato, per esempio come stringa"],["Fitness","La funzione obiettivo che misura la bontà di un individuo"],["Crossover","Combina parti di due genitori in un figlio"],["Mutazione","Modifica casuale di un gene"],["Elitismo","Copia i migliori individui nella generazione successiva senza modificarli"],["Local beam search","Tiene i k stati migliori tra tutti i successori dei k correnti"]],"explain":"La local beam search condivide l'informazione tra i k stati; gli algoritmi genetici aggiungono la ricombinazione."}]},{"title":"Prova della Giardiniera","presentation":"battle","pick":3,"ref":"Ricerca Locale · AIMA 4.1.3-4.1.4","items":[{"id":"ser.q.beam","kind":"mcq","prompt":"Che differenza c'è tra la local beam search e k hill climbing con random restart in parallelo?","options":["Nella beam search i k stati condividono informazione: si tengono i k migliori tra TUTTI i successori","Nessuna differenza","La beam search usa un solo stato","La beam search accetta mosse peggiorative con e^(ΔE/T)"],"answer":0,"explain":"I thread non sono indipendenti: le risorse si spostano dove si sta progredendo."},{"id":"ser.q.diversita","kind":"mcq","prompt":"Qual è il rischio tipico della local beam search?","options":["Perdere diversità: i k stati finiscono tutti nella stessa regione","Esaurire la memoria esponenziale","Non terminare mai","Ignorare la funzione obiettivo"],"answer":0,"explain":"Rimedio: la stochastic beam search sceglie i k successori con probabilità proporzionale al valore."},{"id":"ser.q.fitness","kind":"mcq","prompt":"Nelle 8 regine, quanto vale la fitness di una soluzione se la fitness conta le coppie di regine che NON si attaccano?","options":["28","8","56","0"],"answer":0,"explain":"Le coppie possibili sono 8 · 7 / 2 = 28: in una soluzione nessuna si attacca."},{"id":"ser.q.crossover","kind":"mcq","prompt":"Genitori 32752411 e 24748552, punto di crossover dopo la terza cifra. Qual è il primo figlio?","options":["32748552","24752411","32752552","24748411"],"answer":0,"explain":"Le prime 3 cifre del primo genitore (327) e le ultime 5 del secondo (48552)."},{"id":"ser.q.mutazione","kind":"mcq","prompt":"A che cosa serve la mutazione?","options":["A introdurre diversità che il crossover da solo non può creare","A selezionare i genitori","A calcolare la fitness","A fermare l'algoritmo"],"answer":0,"explain":"Senza mutazione, un gene assente nella popolazione non comparirebbe mai."},{"id":"ser.q.blocchi","kind":"mcq","prompt":"Quando il crossover è più utile?","options":["Quando blocchi contigui della codifica corrispondono a componenti utili della soluzione","Quando la codifica è casuale","Quando la popolazione ha un solo individuo","Mai: è peggio della mutazione"],"answer":0,"explain":"Il crossover combina «mattoni» buoni sviluppati in individui diversi."}]}]},{"id":"officinaformulazione","name":"Officina della Formulazione","stages":[{"title":"Componenti della formulazione","presentation":"bins","instructions":"Puoi cliccare una carta già smistata per riprenderla.","ref":"Ricerca Locale · AIMA 4.1","items":[{"id":"off.cat.tsp","kind":"categorize","weight":3,"prompt":"Commesso viaggiatore: elemento → componente","categories":["Stato","Vicinato","Funzione obiettivo"],"entries":[{"label":"Un giro completo che visita ogni città una volta","cat":0},{"label":"Una permutazione delle città","cat":0},{"label":"Scambiare due città nel giro","cat":1},{"label":"Invertire un tratto del giro (mossa 2-opt)","cat":1},{"label":"La lunghezza totale del giro, da minimizzare","cat":2},{"label":"Il costo complessivo del carburante, da minimizzare","cat":2}],"explain":"Stato, vicinato e funzione obiettivo sono le tre scelte di progetto della ricerca locale."}]},{"title":"Prova del Progettista","presentation":"battle","pick":3,"ref":"Ricerca Locale · AIMA 4.1","items":[{"id":"off.q.orario","kind":"mcq","prompt":"Per costruire l'orario delle lezioni con la ricerca locale, quale funzione obiettivo è più sensata?","options":["Il numero di vincoli violati (sovrapposizioni, aule occupate), da minimizzare","Il numero di lezioni","L'ordine alfabetico dei corsi","Il numero di aule disponibili"],"answer":0,"explain":"Una soluzione valida ha zero violazioni."},{"id":"off.q.vicinato","kind":"mcq","prompt":"Che cosa succede se il vicinato è troppo piccolo?","options":["Ci sono più massimi locali: l'algoritmo si blocca facilmente","L'algoritmo diventa completo","Si consuma più memoria","La funzione obiettivo cambia"],"answer":0,"explain":"Un vicinato più ampio riduce i massimi locali ma rende ogni passo più costoso."},{"id":"off.q.grande","kind":"mcq","prompt":"E se il vicinato è enorme?","options":["Ogni passo costa molto, perché bisogna valutare tanti vicini","L'algoritmo non termina mai","Non esistono più massimi globali","Lo spazio degli stati si riduce"],"answer":0,"explain":"È il caso in cui conviene il first-choice hill climbing."},{"id":"off.q.continuo","kind":"mcq","prompt":"Come si applica l'hill climbing a uno spazio continuo, per esempio scegliere le coordinate di tre aeroporti?","options":["Seguendo il gradiente della funzione obiettivo, o discretizzando il vicinato con passi ±δ","Non si può applicare","Enumerando tutti i punti","Con il minimax"],"answer":0,"explain":"Nel continuo si usa il gradiente: è la stessa idea del gradient descent."},{"id":"off.q.quando","kind":"mcq","prompt":"Quale problema NON è adatto alla ricerca locale?","options":["Trovare la sequenza di mosse più breve per risolvere un puzzle","Disporre le componenti di un circuito","Assegnare turni al personale","Posizionare n regine"],"answer":0,"explain":"Se serve il cammino, la ricerca locale non basta: restituisce solo uno stato."},{"id":"off.q.vincoli","kind":"mcq","prompt":"Nel posizionamento di n regine, perché si mette una regina per colonna?","options":["Per ridurre lo spazio degli stati eliminando a priori gli attacchi in colonna","Perché è obbligatorio dalle regole degli scacchi","Per rendere h sempre zero","Per aumentare i vicini"],"answer":0,"explain":"Una buona formulazione incorpora già parte dei vincoli."}]}]}],"bossPool":[{"id":"boss5.cosa","kind":"mcq","prompt":"Che cosa restituisce un algoritmo di ricerca locale?","options":["Uno stato, non un cammino","Il cammino più breve","L'albero di ricerca","Una strategia di gioco"],"answer":0,"explain":"Conta la configurazione finale.","ref":"Ricerca Locale · AIMA 4.1"},{"id":"boss5.hc","kind":"mcq","prompt":"Perché l'hill climbing non è completo?","options":["Perché può fermarsi in un massimo locale o su un plateau","Perché usa memoria esponenziale","Perché sceglie vicini a caso","Perché non ha una funzione obiettivo"],"answer":0,"explain":"Si ferma quando nessun vicino è migliore.","ref":"Ricerca Locale · AIMA 4.1.1"},{"id":"boss5.restart","kind":"mcq","prompt":"Quale variante rende l'hill climbing completo con probabilità che tende a 1?","options":["Random restart","First-choice","Mosse laterali","Hill climbing a salita più ripida"],"answer":0,"explain":"Prima o poi parte dal pendio giusto.","ref":"Ricerca Locale · AIMA 4.1.1"},{"id":"boss5.sa","kind":"mcq","prompt":"Nel simulated annealing, che cosa controlla la temperatura T?","options":["La probabilità di accettare mosse peggiorative","Il numero di vicini","La dimensione della popolazione","La profondità dell'albero"],"answer":0,"explain":"Probabilità e^(ΔE/T).","ref":"Ricerca Locale · AIMA 4.1.2"},{"id":"boss5.saprob","kind":"mcq","prompt":"ΔE = −1 e T = 1. Con quale probabilità il simulated annealing accetta la mossa?","options":["e^(−1) ≈ 0,37","1","0","0,5"],"answer":0,"explain":"e^(ΔE/T) = e^(−1).","ref":"Ricerca Locale · AIMA 4.1.2"},{"id":"boss5.beam","kind":"mcq","prompt":"Che cosa conserva la local beam search a ogni passo?","options":["I k stati migliori tra tutti i successori dei k stati correnti","Il miglior successore di ciascuno stato, indipendentemente","Un solo stato","Tutti gli stati visitati"],"answer":0,"explain":"I k stati condividono l'informazione.","ref":"Ricerca Locale · AIMA 4.1.3"},{"id":"boss5.ga","kind":"mcq","prompt":"Quale operatore di un algoritmo genetico combina due genitori?","options":["Crossover","Mutazione","Selezione","Fitness"],"answer":0,"explain":"La mutazione modifica, la selezione sceglie, la fitness misura.","ref":"Ricerca Locale · AIMA 4.1.4"},{"id":"boss5.regine","kind":"mcq","prompt":"Nelle 8 regine (una per colonna), quanti vicini ha uno stato?","options":["56","64","8","28"],"answer":0,"explain":"8 regine × 7 posizioni alternative.","ref":"Ricerca Locale · AIMA 4.1.1"},{"id":"boss5.plateau","kind":"mcq","prompt":"Che cos'è un plateau?","options":["Una zona del panorama in cui i vicini hanno lo stesso valore","Il massimo globale","Una sequenza di massimi locali","Uno stato senza vicini"],"answer":0,"explain":"Senza mosse laterali, l'hill climbing si ferma.","ref":"Ricerca Locale · AIMA 4.1.1"}]},{"id":"L6","name":"Arena degli Avversari","implemented":true,"buildings":[{"id":"tribuna","name":"Tribuna dei Giochi","stages":[{"title":"Che gioco è?","presentation":"bins","instructions":"Puoi cliccare una carta già smistata per riprenderla.","ref":"Ricerca con Avversari · AIMA 5.1","items":[{"id":"tri.cat.giochi","kind":"categorize","weight":3,"prompt":"Gioco → tipo","categories":["Deterministico, informazione perfetta","Stocastico, informazione perfetta","Informazione imperfetta"],"entries":[{"label":"Scacchi","cat":0},{"label":"Go","cat":0},{"label":"Tris (tic-tac-toe)","cat":0},{"label":"Backgammon","cat":1},{"label":"Monopoli","cat":1},{"label":"Poker","cat":2},{"label":"Bridge","cat":2},{"label":"Battaglia navale","cat":2}],"explain":"Stocastico: c'è il caso (i dadi). Informazione imperfetta: parte dello stato è nascosta (le carte dell'avversario)."}]},{"title":"Le regole del gioco","presentation":"connect","instructions":"Clicca una voce a sinistra e poi quella corrispondente a destra.","ref":"Ricerca con Avversari · AIMA 5.1","items":[{"id":"tri.match.formul","kind":"match","weight":3,"prompt":"Elemento della formulazione → significato","leftTitle":"Elemento","rightTitle":"Significato","pairs":[["S0","Lo stato iniziale della partita"],["To-Move(s)","Il giocatore che deve muovere nello stato s"],["Actions(s)","Le mosse legali nello stato s"],["Result(s, a)","Lo stato che si ottiene applicando la mossa a"],["Is-Terminal(s)","Vero quando la partita è finita"],["Utility(s, p)","Il valore finale della partita per il giocatore p"]],"explain":"Stato iniziale, Actions e Result definiscono l'albero di gioco."}]},{"title":"Prova dell'Arbitra","presentation":"battle","pick":3,"ref":"Ricerca con Avversari · AIMA 5.1","items":[{"id":"tri.q.sommazero","kind":"mcq","prompt":"Che cosa vuol dire che un gioco è «a somma zero»?","options":["Ciò che guadagna un giocatore lo perde l'altro","Nessuno vince mai","Il punteggio parte da zero","Le mosse non hanno costo"],"answer":0,"explain":"Negli scacchi: 1 + 0, 0 + 1 o ½ + ½."},{"id":"tri.q.scacchi","kind":"mcq","prompt":"Gli scacchi hanno un fattore di ramificazione medio di circa 35 e partite di circa 80 mosse (semimosse). Quanto è grande l'albero di gioco?","options":["Circa 35^80, ovvero 10^123: impossibile esplorarlo tutto","Circa 35 · 80 nodi","Circa un milione di nodi","Infinito"],"answer":0,"explain":"Per questo servono potatura e valutazioni approssimate."},{"id":"tri.q.max","kind":"mcq","prompt":"Chi sono MAX e MIN?","options":["MAX è il giocatore di cui calcoliamo la strategia, MIN il suo avversario","Due algoritmi di ricerca","I valori massimo e minimo della funzione di utilità","Il primo e l'ultimo nodo dell'albero"],"answer":0,"explain":"MAX muove per primo, poi si alternano."},{"id":"tri.q.diverso","kind":"mcq","prompt":"Perché la ricerca con avversari è diversa dalla ricerca classica?","options":["Perché non controlliamo le mosse dell'avversario: serve una strategia, non una sequenza di azioni","Perché non c'è uno stato iniziale","Perché non esistono stati terminali","Perché lo spazio è continuo"],"answer":0,"explain":"Dobbiamo prevedere una risposta a ogni possibile mossa dell'avversario."},{"id":"tri.q.tris","kind":"mcq","prompt":"Il tris ha meno di 9! = 362.880 nodi terminali. Che cosa implica?","options":["Si può esplorare tutto l'albero e giocare in modo perfetto","È un gioco stocastico","Serve il simulated annealing","Non ha soluzione"],"answer":0,"explain":"Con un gioco piccolo il minimax completo è praticabile."},{"id":"tri.q.utility","kind":"mcq","prompt":"Negli scacchi, quali valori assume tipicamente l'utilità per il giocatore bianco?","options":["1 (vittoria), 0 (sconfitta), ½ (patta)","Qualsiasi numero tra −∞ e +∞","Il numero di pezzi rimasti","Il numero di mosse giocate"],"answer":0,"explain":"È definita solo negli stati terminali."}]}]},{"id":"palazzominimax","name":"Palazzo del Minimax","stages":[{"title":"Vero o Falso al palazzo","presentation":"rush","timeLimitSec":15,"pick":6,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Ricerca con Avversari · AIMA 5.2","items":[{"id":"pal.tf.max","kind":"tf","prompt":"In un nodo MAX, il valore minimax è il massimo dei valori dei figli.","answer":true,"explain":"MAX sceglie la mossa migliore per sé."},{"id":"pal.tf.min","kind":"tf","prompt":"In un nodo MIN, il valore minimax è la media dei valori dei figli.","answer":false,"explain":"È il minimo: MIN gioca in modo ottimo contro MAX."},{"id":"pal.tf.dfs","kind":"tf","prompt":"Il minimax esplora l'albero in profondità (depth-first).","answer":true,"explain":"Memoria O(bm), tempo O(b^m)."},{"id":"pal.tf.tempo","kind":"tf","prompt":"Il tempo del minimax è O(b^m), con b fattore di ramificazione e m profondità massima.","answer":true,"explain":"Esponenziale: per questo serve la potatura."},{"id":"pal.tf.ottimo","kind":"tf","prompt":"Contro un avversario ottimo, il minimax garantisce il miglior risultato possibile per MAX.","answer":true,"explain":"È la strategia ottima nei giochi deterministici a somma zero."},{"id":"pal.tf.subottimo","kind":"tf","prompt":"Contro un avversario che sbaglia, il minimax ottiene un risultato peggiore di quello calcolato.","answer":false,"explain":"Ottiene almeno quel risultato, spesso di più."},{"id":"pal.tf.foglie","kind":"tf","prompt":"I valori di utilità sono definiti nelle foglie, cioè negli stati terminali.","answer":true,"explain":"Poi vengono propagati verso la radice."},{"id":"pal.tf.multi","kind":"tf","prompt":"Con più di due giocatori, a ogni nodo si associa un vettore di utilità, una per giocatore.","answer":true,"explain":"Ogni giocatore sceglie la mossa che massimizza la propria componente."}]},{"title":"Calcola il valore","presentation":"battle","pick":4,"ref":"Ricerca con Avversari · AIMA 5.2","items":[{"id":"pal.q.semplice","kind":"mcq","prompt":"MAX ha tre mosse, ognuna porta a un nodo MIN. Le foglie sono: A = (3, 12, 8), B = (2, 4, 6), C = (14, 5, 2). Qual è il valore minimax della radice?","options":["3","2","14","12"],"answer":0,"explain":"MIN: A = 3, B = 2, C = 2. MAX sceglie max(3, 2, 2) = 3."},{"id":"pal.q.mossa","kind":"mcq","prompt":"Nello stesso albero (A = 3, 12, 8; B = 2, 4, 6; C = 14, 5, 2), quale mossa sceglie MAX?","options":["A","B","C","Indifferente"],"answer":0,"explain":"A garantisce 3, le altre solo 2."},{"id":"pal.q.min","kind":"mcq","prompt":"Un nodo MIN ha figli con valori 7, 3, 9. Quanto vale?","options":["3","9","7","19"],"answer":0,"explain":"MIN prende il minimo."},{"id":"pal.q.duelivelli","kind":"mcq","prompt":"MAX ha due mosse. La prima porta a un nodo MIN con foglie (5, 1); la seconda a un nodo MIN con foglie (4, 6). Quanto vale la radice?","options":["4","5","6","1"],"answer":0,"explain":"min(5, 1) = 1; min(4, 6) = 4; max(1, 4) = 4."},{"id":"pal.q.memoria","kind":"mcq","prompt":"Quanta memoria richiede il minimax esplorando in profondità?","options":["O(b · m)","O(b^m)","O(1)","O(m^b)"],"answer":0,"explain":"Tiene solo il cammino corrente con i fratelli dei nodi."},{"id":"pal.q.ipotesi","kind":"mcq","prompt":"Qual è l'ipotesi del minimax sull'avversario?","options":["Gioca in modo ottimo, minimizzando l'utilità di MAX","Gioca a caso","Coopera con MAX","Ripete sempre la stessa mossa"],"answer":0,"explain":"Se l'avversario non è ottimo, MAX ottiene almeno il valore calcolato."},{"id":"pal.q.tris","kind":"mcq","prompt":"Il valore minimax della posizione iniziale del tris è 0. Che cosa significa?","options":["Con gioco perfetto da entrambe le parti, la partita finisce in pareggio","Vince sempre chi inizia","Vince sempre chi risponde","Il gioco non termina"],"answer":0,"explain":"Ecco perché il tris diventa noioso in fretta."}]}]},{"id":"giardinopotatura","name":"Giardino della Potatura","stages":[{"title":"Vero o Falso tra le siepi","presentation":"rush","timeLimitSec":15,"pick":6,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Ricerca con Avversari · AIMA 5.3","items":[{"id":"pot.tf.stesso","kind":"tf","prompt":"La potatura alfa-beta restituisce lo stesso valore del minimax.","answer":true,"explain":"Taglia solo rami che non possono influenzare la decisione."},{"id":"pot.tf.alfa","kind":"tf","prompt":"α è il valore migliore (più alto) trovato finora per MAX lungo il cammino.","answer":true,"explain":"β è il migliore (più basso) per MIN."},{"id":"pot.tf.taglio","kind":"tf","prompt":"Si pota quando α ≥ β.","answer":true,"explain":"Nessuno dei due giocatori lascerebbe arrivare la partita lì."},{"id":"pot.tf.ordine","kind":"tf","prompt":"L'efficacia della potatura non dipende dall'ordine in cui si esaminano le mosse.","answer":false,"explain":"Dipende moltissimo: con le mosse migliori per prime si pota di più."},{"id":"pot.tf.doppio","kind":"tf","prompt":"Con un ordinamento perfetto, a parità di tempo l'alfa-beta può cercare circa il doppio della profondità del minimax.","answer":true,"explain":"O(b^(m/2)) invece di O(b^m)."},{"id":"pot.tf.casuale","kind":"tf","prompt":"Con mosse in ordine casuale, la complessità media è circa O(b^(3m/4)).","answer":true,"explain":"Comunque meglio del minimax."},{"id":"pot.tf.killer","kind":"tf","prompt":"Le «killer moves» sono le mosse che hanno già causato potature altrove, provate per prime.","answer":true,"explain":"È un'euristica di ordinamento."},{"id":"pot.tf.trasposizioni","kind":"tf","prompt":"Una tabella delle trasposizioni memorizza il valore di posizioni già viste, raggiungibili con sequenze di mosse diverse.","answer":true,"explain":"Evita di rivalutare la stessa posizione."}]},{"title":"Prova della Potatrice","presentation":"battle","pick":3,"ref":"Ricerca con Avversari · AIMA 5.3","items":[{"id":"pot.q.taglio","kind":"mcq","prompt":"Albero: A = (3, 12, 8), B = (2, ?, ?), C = (14, 5, 2). Dopo aver visto la prima foglia di B (valore 2), perché si possono ignorare le altre?","options":["Perché MAX ha già 3 con A, e B varrà al massimo 2","Perché 2 è il minimo assoluto","Perché B è un nodo MAX","Perché le foglie sono uguali"],"answer":0,"explain":"B è un nodo MIN: il suo valore sarà ≤ 2 < 3."},{"id":"pot.q.complessita","kind":"mcq","prompt":"Qual è la complessità dell'alfa-beta con ordinamento perfetto delle mosse?","options":["O(b^(m/2))","O(b^m)","O(m^b)","O(b · m)"],"answer":0,"explain":"Il fattore di ramificazione effettivo diventa √b."},{"id":"pot.q.scacchi","kind":"mcq","prompt":"Negli scacchi b ≈ 35. Quale fattore di ramificazione effettivo si ottiene con ordinamento perfetto?","options":["Circa 6","Circa 35","Circa 17","Circa 1"],"answer":0,"explain":"√35 ≈ 6."},{"id":"pot.q.ordine","kind":"mcq","prompt":"Quale ordinamento delle mosse massimizza la potatura?","options":["Esaminare per prime le mosse migliori","Esaminare per prime le mosse peggiori","Ordine alfabetico","Ordine casuale"],"answer":0,"explain":"Si trovano subito buoni valori di α e β."},{"id":"pot.q.iniziale","kind":"mcq","prompt":"Con quali valori di α e β parte la ricerca dalla radice?","options":["α = −∞, β = +∞","α = 0, β = 0","α = +∞, β = −∞","α = 1, β = −1"],"answer":0,"explain":"Nessuna garanzia all'inizio."},{"id":"pot.q.risultato","kind":"mcq","prompt":"La potatura alfa-beta può cambiare la mossa scelta rispetto al minimax?","options":["No: il valore della radice e la decisione sono gli stessi","Sì, sempre","Sì, se l'albero è profondo","Solo nei giochi stocastici"],"answer":0,"explain":"Risparmia lavoro senza perdere correttezza."}]}]},{"id":"torreorologio","name":"Torre dell'Orologio","stages":[{"title":"Che cosa misura la valutazione?","presentation":"bins","instructions":"Puoi cliccare una carta già smistata per riprenderla.","ref":"Ricerca con Avversari · AIMA 5.4","items":[{"id":"oro.cat.problemi","kind":"categorize","weight":3,"prompt":"Concetto → categoria","categories":["Funzione di valutazione","Test di cutoff","Problemi del cutoff"],"entries":[{"label":"Somma pesata del materiale: pedone 1, cavallo e alfiere 3, torre 5, regina 9","cat":0},{"label":"Stima dell'utilità attesa di una posizione non terminale","cat":0},{"label":"Fermarsi a una profondità d fissata","cat":1},{"label":"Approfondimento iterativo finché scade il tempo","cat":1},{"label":"Effetto orizzonte: un evento inevitabile viene spinto oltre la profondità di ricerca","cat":2},{"label":"Posizioni non quiescenti, per esempio a metà di uno scambio di pezzi","cat":2}],"explain":"Si sostituisce Utility con Eval e Is-Terminal con Is-Cutoff."}]},{"title":"Prova del Cronometrista","presentation":"battle","pick":3,"ref":"Ricerca con Avversari · AIMA 5.4","items":[{"id":"oro.q.materiale","kind":"mcq","prompt":"Con i pesi classici (pedone 1, cavallo 3, alfiere 3, torre 5, regina 9), il bianco ha una torre e due pedoni, il nero un alfiere e un cavallo. Quanto vale il materiale per il bianco?","options":["+1","−1","+3","0"],"answer":0,"explain":"Bianco 5 + 2 = 7, nero 3 + 3 = 6: differenza +1."},{"id":"oro.q.quiescenza","kind":"mcq","prompt":"Che cos'è la ricerca di quiescenza?","options":["Estendere la ricerca oltre il cutoff solo nelle posizioni instabili, come le catture in corso","Fermare la ricerca quando l'avversario non muove","Esplorare solo le posizioni tranquille","Ridurre la profondità quando si è in vantaggio"],"answer":0,"explain":"Si valuta solo quando la posizione è «tranquilla»."},{"id":"oro.q.orizzonte","kind":"mcq","prompt":"Che cos'è l'effetto orizzonte?","options":["Il programma ritarda con mosse inutili un evento dannoso inevitabile, spingendolo oltre la profondità di ricerca","Il programma vede tutte le mosse fino alla fine","La valutazione è sempre zero","La ricerca termina per mancanza di memoria"],"answer":0,"explain":"Il disastro non scompare: è solo fuori dal campo visivo."},{"id":"oro.q.iterativo","kind":"mcq","prompt":"Perché usare l'approfondimento iterativo nei giochi con limite di tempo?","options":["Perché quando scade il tempo si ha sempre la mossa dell'ultima profondità completata","Perché è più veloce del minimax","Perché non serve la funzione di valutazione","Perché esplora solo la profondità massima"],"answer":0,"explain":"Aiuta anche a ordinare le mosse per l'alfa-beta."},{"id":"oro.q.requisiti","kind":"mcq","prompt":"Quale proprietà deve avere una buona funzione di valutazione?","options":["Essere veloce da calcolare e correlata con le reali probabilità di vittoria","Essere esatta in ogni posizione","Restituire sempre valori positivi","Dipendere solo dal numero di mosse"],"answer":0,"explain":"Deve anche ordinare gli stati terminali come Utility."},{"id":"oro.q.forward","kind":"mcq","prompt":"Che cos'è il forward pruning, come nella beam search?","options":["Scartare subito alcune mosse che sembrano cattive, senza esplorarle","Potare con α e β","Ritornare alla mossa precedente","Esplorare in ampiezza"],"answer":0,"explain":"È rischioso: si può scartare la mossa migliore."}]}]},{"id":"casinomcts","name":"Casinò del Caso","stages":[{"title":"Un'iterazione di MCTS","presentation":"timeline","instructions":"Trascina le fasi (o usa le frecce ▲▼) nell'ordine di un'iterazione di MCTS.","ref":"Ricerca con Avversari · AIMA 5.4","items":[{"id":"cas.order.mcts","kind":"order","weight":3,"prompt":"Ordina le fasi di un'iterazione di Monte Carlo Tree Search","entries":[{"label":"Selection: scendo nell'albero seguendo una politica come UCB1","reveal":"bilancia sfruttamento ed esplorazione"},{"label":"Expansion: aggiungo un nuovo nodo figlio","reveal":"l'albero cresce di un nodo"},{"label":"Simulation: gioco una partita fino alla fine con mosse casuali o di una politica veloce","reveal":"detta anche playout o rollout"},{"label":"Back-propagation: aggiorno vittorie e visite lungo il cammino fino alla radice","reveal":"le statistiche guidano le prossime selezioni"}],"explain":"Selection, expansion, simulation, back-propagation, ripetute finché c'è tempo."}]},{"title":"Prova del Croupier","presentation":"battle","pick":3,"ref":"Ricerca con Avversari · AIMA 5.4-5.5","items":[{"id":"cas.q.chance","kind":"mcq","prompt":"Un nodo casuale ha due esiti: con probabilità 0,5 il valore è 4, con probabilità 0,5 il valore è 2. Quanto vale?","options":["3","4","2","6"],"answer":0,"explain":"Valore atteso: 0,5 · 4 + 0,5 · 2 = 3."},{"id":"cas.q.chance2","kind":"mcq","prompt":"Un nodo casuale ha esiti 10 con probabilità 0,1 e 0 con probabilità 0,9. Quanto vale?","options":["1","10","0","5"],"answer":0,"explain":"0,1 · 10 + 0,9 · 0 = 1."},{"id":"cas.q.scelta","kind":"mcq","prompt":"MAX sceglie tra due mosse che portano a nodi casuali: la prima vale 0,5 · 4 + 0,5 · 2, la seconda 0,9 · 3 + 0,1 · 1. Quale sceglie?","options":["La prima (3 contro 2,8)","La seconda (2,8 contro 3)","La seconda, perché ha un esito con probabilità 0,9","Indifferente"],"answer":0,"explain":"Prima: 3. Seconda: 2,7 + 0,1 = 2,8. MAX sceglie la prima."},{"id":"cas.q.scala","kind":"mcq","prompt":"Perché nell'expectiminimax la scala della funzione di valutazione è importante?","options":["Perché si calcolano medie: trasformazioni che conservano l'ordine possono cambiare la mossa scelta","Perché i valori devono essere interi","Perché serve per la potatura alfa-beta","Non è importante"],"answer":0,"explain":"Nel minimax conta solo l'ordine, nell'expectiminimax contano i valori."},{"id":"cas.q.ucb","kind":"mcq","prompt":"Nella formula UCB1, che ruolo ha il termine di esplorazione?","options":["Favorisce i nodi visitati poche volte","Favorisce i nodi con più vittorie","Pota i rami peggiori","Calcola l'utilità finale"],"answer":0,"explain":"UCB1 = vittorie/visite + C · √(ln N / n): il secondo termine premia l'incertezza."},{"id":"cas.q.go","kind":"mcq","prompt":"Perché MCTS funziona bene nel Go, dove l'alfa-beta fatica?","options":["Perché b ≈ 361 e scrivere una buona funzione di valutazione è difficile: MCTS stima i valori con le simulazioni","Perché il Go è stocastico","Perché il Go ha poche mosse","Perché MCTS esplora tutto l'albero"],"answer":0,"explain":"AlphaGo ha combinato MCTS con reti neurali per politica e valutazione."}]}]}],"bossPool":[{"id":"boss6.minimax","kind":"mcq","prompt":"In un nodo MIN con figli di valore 4, 8 e 6, quale valore propaga il minimax?","options":["4","8","6","18"],"answer":0,"explain":"MIN prende il minimo.","ref":"Ricerca con Avversari · AIMA 5.2"},{"id":"boss6.root","kind":"mcq","prompt":"MAX ha due mosse: la prima porta a un nodo MIN con foglie (3, 9), la seconda a un nodo MIN con foglie (5, 7). Quanto vale la radice?","options":["5","3","9","7"],"answer":0,"explain":"min = 3 e 5; max(3, 5) = 5.","ref":"Ricerca con Avversari · AIMA 5.2"},{"id":"boss6.alfabeta","kind":"mcq","prompt":"Che cosa garantisce la potatura alfa-beta rispetto al minimax?","options":["Lo stesso valore e la stessa decisione, esplorando meno nodi","Una mossa migliore","Una valutazione più precisa","Il funzionamento nei giochi stocastici"],"answer":0,"explain":"Pota solo i rami ininfluenti.","ref":"Ricerca con Avversari · AIMA 5.3"},{"id":"boss6.compl","kind":"mcq","prompt":"Con ordinamento perfetto delle mosse, quale complessità raggiunge l'alfa-beta?","options":["O(b^(m/2))","O(b^m)","O(b · m)","O(log b)"],"answer":0,"explain":"A parità di tempo, circa il doppio della profondità.","ref":"Ricerca con Avversari · AIMA 5.3"},{"id":"boss6.eval","kind":"mcq","prompt":"Che cosa sostituisce la funzione di valutazione nella ricerca a profondità limitata?","options":["La funzione di utilità negli stati in cui la ricerca si interrompe","Il test di terminazione","La funzione Result","L'insieme delle azioni"],"answer":0,"explain":"Eval stima l'utilità; Is-Cutoff sostituisce Is-Terminal.","ref":"Ricerca con Avversari · AIMA 5.4"},{"id":"boss6.orizzonte","kind":"mcq","prompt":"Che cos'è l'effetto orizzonte?","options":["Rinviare un evento dannoso inevitabile oltre la profondità di ricerca","Esplorare tutto l'albero","Potare troppo","Valutare solo le foglie"],"answer":0,"explain":"Il pericolo resta, ma non si vede più.","ref":"Ricerca con Avversari · AIMA 5.4"},{"id":"boss6.expecti","kind":"mcq","prompt":"Con probabilità 0,25 il valore è 8 e con probabilità 0,75 è 0. Quanto vale il nodo casuale?","options":["2","8","0","4"],"answer":0,"explain":"0,25 · 8 = 2.","ref":"Ricerca con Avversari · AIMA 5.5"},{"id":"boss6.mcts","kind":"mcq","prompt":"Quale fase di MCTS gioca una partita fino alla fine per stimare il valore di un nodo?","options":["Simulation (playout)","Selection","Expansion","Back-propagation"],"answer":0,"explain":"Il risultato viene poi propagato fino alla radice.","ref":"Ricerca con Avversari · AIMA 5.4"},{"id":"boss6.tipo","kind":"mcq","prompt":"Il poker è un gioco...","options":["a informazione imperfetta","deterministico a informazione perfetta","a un solo giocatore","senza stati terminali"],"answer":0,"explain":"Le carte degli avversari sono nascoste.","ref":"Ricerca con Avversari · AIMA 5.1"}]},{"id":"L7","name":"Porto della Ricerca e Apprendimento","implemented":true,"buildings":[{"id":"faroiperparametri","name":"Faro degli Iperparametri","stages":[{"title":"Parametro o iperparametro?","presentation":"bins","instructions":"Puoi cliccare una carta già smistata per riprenderla.","ref":"Ricerca in ML e DL","items":[{"id":"far.cat.param","kind":"categorize","weight":3,"prompt":"Elemento → tipo","categories":["Parametro (appreso dal training)","Iperparametro (scelto prima del training)"],"entries":[{"label":"I pesi di una rete neurale","cat":0},{"label":"I coefficienti β di una regressione lineare","cat":0},{"label":"Le soglie di split apprese da un albero di decisione","cat":0},{"label":"Il learning rate","cat":1},{"label":"Il numero k di vicini nel k-NN","cat":1},{"label":"La profondità massima di un albero","cat":1},{"label":"Il numero di hidden layer","cat":1},{"label":"Il numero k di cluster nel k-means","cat":1}],"explain":"Gli iperparametri definiscono lo spazio di ricerca; i parametri li trova il training dentro quello spazio."}]},{"title":"Tre strategie di ricerca","presentation":"connect","instructions":"Clicca una voce a sinistra e poi quella corrispondente a destra.","ref":"Ricerca in ML e DL","items":[{"id":"far.match.strategie","kind":"match","weight":3,"prompt":"Strategia → idea","leftTitle":"Strategia","rightTitle":"Idea","pairs":[["Grid search","Prova tutte le combinazioni di una griglia di valori"],["Random search","Campiona combinazioni a caso nello spazio degli iperparametri"],["Ottimizzazione bayesiana","Costruisce un modello surrogato e sceglie la prossima prova con una funzione di acquisizione"],["Algoritmo genetico","Evolve una popolazione di configurazioni con selezione, crossover e mutazione"]],"explain":"Valutare una configurazione costa un intero training: conviene sceglierle con giudizio."}]},{"title":"Prova della Guardiana","presentation":"battle","pick":3,"ref":"Ricerca in ML e DL","items":[{"id":"far.q.griglia","kind":"mcq","prompt":"Una grid search prova learning rate in {0,001; 0,01; 0,1}, profondità in {2, 4, 8, 16} e batch size in {32, 64}. Con 5-fold cross validation, quanti training servono?","options":["120","24","9","45"],"answer":0,"explain":"3 · 4 · 2 = 24 configurazioni, ciascuna addestrata 5 volte: 120."},{"id":"far.q.random","kind":"mcq","prompt":"Perché la random search spesso batte la grid search a parità di budget?","options":["Perché prova più valori distinti degli iperparametri che contano davvero","Perché esplora tutte le combinazioni","Perché non richiede validazione","Perché è deterministica"],"answer":0,"explain":"Bergstra e Bengio (2012): in genere solo pochi iperparametri contano davvero."},{"id":"far.q.bayes","kind":"mcq","prompt":"Qual è il vantaggio dell'ottimizzazione bayesiana?","options":["Usa i risultati delle prove precedenti per scegliere la prossima configurazione promettente","Garantisce l'ottimo globale","Non richiede training","Prova tutte le combinazioni"],"answer":0,"explain":"Bilancia esplorazione e sfruttamento con la funzione di acquisizione."},{"id":"far.q.esplosione","kind":"mcq","prompt":"Che cosa succede alla grid search quando aggiungo iperparametri?","options":["Il numero di configurazioni cresce in modo esponenziale","Cresce in modo lineare","Resta uguale","Diminuisce"],"answer":0,"explain":"È la maledizione della dimensionalità."},{"id":"far.q.funzione","kind":"mcq","prompt":"Nella ricerca di iperparametri, che cosa fa da funzione obiettivo?","options":["La performance del modello sul validation set","La loss sul training set","Il numero di parametri","L'accuratezza sul test set"],"answer":0,"explain":"Il test set non si tocca fino alla fine."},{"id":"far.q.scala","kind":"mcq","prompt":"Come conviene campionare un learning rate tra 0,0001 e 1?","options":["Su scala logaritmica","Su scala lineare","Solo agli estremi","Sempre 0,5"],"answer":0,"explain":"Così ogni ordine di grandezza riceve lo stesso numero di prove."}]}]},{"id":"scivologradiente","name":"Scivolo del Gradiente","stages":[{"title":"Vero o Falso sullo scivolo","presentation":"rush","timeLimitSec":15,"pick":6,"instructions":"Rispondi VERO (tasto ←) o FALSO (tasto →) prima che scada il tempo.","ref":"Ricerca in ML e DL","items":[{"id":"sci.tf.locale","kind":"tf","prompt":"Il gradient descent è un algoritmo di ricerca locale nello spazio dei parametri.","answer":true,"explain":"Si sposta da un punto a un vicino che riduce la loss."},{"id":"sci.tf.direzione","kind":"tf","prompt":"Il gradient descent si muove nella direzione del gradiente della loss.","answer":false,"explain":"Nella direzione opposta: il gradiente indica dove la loss cresce."},{"id":"sci.tf.lralto","kind":"tf","prompt":"Un learning rate troppo alto può far oscillare o divergere il training.","answer":true,"explain":"I passi scavalcano il minimo."},{"id":"sci.tf.lrbasso","kind":"tf","prompt":"Un learning rate troppo basso rende il training lento e può bloccarlo in un minimo locale.","answer":true,"explain":"Passi piccolissimi."},{"id":"sci.tf.sgd","kind":"tf","prompt":"Lo stochastic gradient descent stima il gradiente su un sottoinsieme (mini-batch) dei dati.","answer":true,"explain":"Più veloce e più rumoroso: il rumore aiuta anche a uscire da minimi poco profondi."},{"id":"sci.tf.globale","kind":"tf","prompt":"Il gradient descent garantisce sempre il minimo globale della loss di una rete neurale.","answer":false,"explain":"La loss di una rete non è convessa: si trova un minimo locale (spesso buono)."},{"id":"sci.tf.convessa","kind":"tf","prompt":"Per una funzione convessa, come l'errore quadratico della regressione lineare, ogni minimo locale è globale.","answer":true,"explain":"Lì il gradient descent, con un learning rate adatto, trova l'ottimo."},{"id":"sci.tf.momentum","kind":"tf","prompt":"Il momentum accumula la direzione dei passi precedenti per accelerare e attraversare zone piatte.","answer":true,"explain":"Come una palla che rotola."}]},{"title":"Prova della Bagnina","presentation":"battle","pick":3,"ref":"Ricerca in ML e DL","items":[{"id":"sci.q.passo","kind":"mcq","prompt":"w = 2, gradiente della loss in w = 4, learning rate 0,1. Quanto vale w dopo un passo di gradient descent?","options":["1,6","2,4","1,9","−2"],"answer":0,"explain":"w − η · ∇L = 2 − 0,1 · 4 = 1,6."},{"id":"sci.q.analogia","kind":"mcq","prompt":"A quale algoritmo di ricerca locale assomiglia il gradient descent?","options":["All'hill climbing a salita più ripida, rovesciato (discesa più ripida)","Al minimax","Alla ricerca in ampiezza","Alla potatura alfa-beta"],"answer":0,"explain":"Sceglie la direzione di massima discesa."},{"id":"sci.q.annealing","kind":"mcq","prompt":"Ridurre gradualmente il learning rate durante il training ricorda...","options":["Lo schedule di temperatura del simulated annealing","Il crossover di un algoritmo genetico","La potatura alfa-beta","Il random restart"],"answer":0,"explain":"Passi grandi all'inizio per esplorare, piccoli alla fine per rifinire."},{"id":"sci.q.restart","kind":"mcq","prompt":"Addestrare la stessa rete più volte con inizializzazioni casuali diverse ricorda...","options":["Il random restart dell'hill climbing","La local beam search","L'expectiminimax","La grid search"],"answer":0,"explain":"Punti di partenza diversi portano a minimi diversi."},{"id":"sci.q.sella","kind":"mcq","prompt":"Negli spazi ad altissima dimensione, quali punti rallentano spesso il gradient descent più dei minimi locali?","options":["I punti di sella e i plateau","I massimi globali","Le foglie dell'albero","I nodi MIN"],"answer":0,"explain":"Il gradiente è quasi nullo ma non si è in un minimo."},{"id":"sci.q.batch","kind":"mcq","prompt":"Perché si usano mini-batch invece dell'intero dataset per ogni passo?","options":["Per fare passi più frequenti ed economici, con un rumore utile","Perché il gradiente esatto è sempre sbagliato","Per evitare di calcolare la loss","Per usare meno epoche obbligatoriamente"],"answer":0,"explain":"Ogni passo costa meno e il rumore aiuta l'esplorazione."}]}]},{"id":"cantierenavale","name":"Cantiere Navale Genetico","stages":[{"title":"Il genetico in cantiere","presentation":"timeline","instructions":"Trascina i passi (o usa le frecce ▲▼) nell'ordine di un algoritmo genetico per la feature selection.","ref":"Ricerca in ML e DL","items":[{"id":"can.order.ga","kind":"order","weight":3,"prompt":"Ordina i passi di un algoritmo genetico per la feature selection","entries":[{"label":"Codifico ogni individuo come stringa di bit: 1 se la feature è usata, 0 altrimenti","reveal":"per esempio 1011001"},{"label":"Genero una popolazione iniziale casuale","reveal":"molti sottoinsiemi diversi"},{"label":"Addestro un modello per ogni individuo e misuro la fitness sul validation set","reveal":"per esempio F1 meno una penalità sul numero di feature"},{"label":"Seleziono i genitori, incrocio e muto i bit","reveal":"nasce una nuova generazione"},{"label":"Ripeto per più generazioni e verifico il sottoinsieme migliore sul test set","reveal":"il test set si usa solo alla fine"}],"explain":"Codifica, popolazione, fitness, operatori genetici, verifica finale."}]},{"title":"Prova della Carpentiera","presentation":"battle","pick":3,"ref":"Ricerca in ML e DL","items":[{"id":"can.q.sottoinsiemi","kind":"mcq","prompt":"Un dataset ha 20 feature. Quanti sottoinsiemi di feature esistono?","options":["2^20, circa un milione","20","400","20!"],"answer":0,"explain":"Ogni feature può esserci o non esserci."},{"id":"can.q.forward","kind":"mcq","prompt":"Che cosa fa la forward selection?","options":["Parte da nessuna feature e aggiunge a ogni passo quella che migliora di più il modello","Parte da tutte le feature e le toglie una alla volta","Sceglie le feature a caso","Usa solo la correlazione