eme delle soluzioni dominate","La media degli obiettivi"],"answer":0,"explain":"Ogni punto è un compromesso diverso.","ref":"Ricerca in ML e DL"},{"id":"boss7.nas","kind":"mcq","prompt":"Che cosa cerca la Neural Architecture Search?","options":["L'architettura della rete","I pesi della rete","Il dataset","La metrica di valutazione"],"answer":0,"explain":"Ogni candidato va addestrato: è costosa.","ref":"Ricerca in ML e DL"},{"id":"boss7.test","kind":"mcq","prompt":"Che ruolo ha il test set nella ricerca degli iperparametri?","options":["Nessuno: si usa una sola volta alla fine","È la funzione obiettivo della ricerca","Serve per scegliere k","Si usa a ogni generazione"],"answer":0,"explain":"Altrimenti la stima è ottimistica.","ref":"Ricerca in ML e DL"}]}]};

var Grading = (function () {
  var hex = function (n) { var s = ''; for (var i = 0; i < n; i++) s += ('0' + Math.floor(Math.random() * 256).toString(16)).slice(-2); return s; };
  var SHIMS = { 'node:fs': {}, 'node:path': {}, 'node:crypto': {
    randomBytes: function (n) { return { toString: function () { return hex(n); } }; },
    randomInt: function (n) { return Math.floor(Math.random() * n); }
  } };
  var module = { exports: {} };
  var require = function (m) { return SHIMS[m]; };
'use strict';
// Caricamento dei contenuti (content/*.json), campionamento delle prove e correzione.
// Le soluzioni restano sempre sul server: al client arrivano solo testi e id casuali.
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');

const rid = () => crypto.randomBytes(4).toString('hex');

function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = crypto.randomInt(i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function sample(arr, n) {
  return shuffle(arr).slice(0, Math.min(n, arr.length));
}

const ITEM_KINDS = ['mcq', 'tf', 'order', 'match', 'categorize', 'matrix'];

function validateItem(item, where) {
  const fail = (msg) => { throw new Error(`${where} (${item.id || '?'}): ${msg}`); };
  if (!item.id) fail('manca id');
  if (!ITEM_KINDS.includes(item.kind)) fail(`kind sconosciuto ${item.kind}`);
  switch (item.kind) {
    case 'mcq':
      if (!Array.isArray(item.options) || item.options.length < 2) fail('servono almeno 2 opzioni');
      if (!(item.answer >= 0 && item.answer < item.options.length)) fail('answer fuori range');
      break;
    case 'tf':
      if (typeof item.answer !== 'boolean') fail('answer deve essere true/false');
      break;
    case 'order':
      if (!Array.isArray(item.entries) || item.entries.length < 3) fail('servono almeno 3 elementi');
      break;
    case 'match':
      if (!Array.isArray(item.pairs) || item.pairs.length < 2) fail('servono almeno 2 coppie');
      break;
    case 'categorize':
      if (!Array.isArray(item.categories) || !Array.isArray(item.entries)) fail('categories/entries mancanti');
      for (const e of item.entries) if (!(e.cat >= 0 && e.cat < item.categories.length)) fail(`categoria errata per ${e.label}`);
      break;
    case 'matrix':
      if (!Array.isArray(item.rows) || !Array.isArray(item.cols)) fail('rows/cols mancanti');
      for (const r of item.rows) {
        if (!Array.isArray(r.answers) || r.answers.length !== item.cols.length) fail(`answers della riga ${r.label}`);
      }
      break;
  }
}

function loadContent(contentDir) {
  const levels = JSON.parse(fs.readFileSync(path.join(contentDir, 'levels.json'), 'utf8'));
  const boss = JSON.parse(fs.readFileSync(path.join(contentDir, 'boss.json'), 'utf8'));
  const buildings = new Map();
  const ids = new Set();
  for (const level of levels.levels) {
    level.buildings = [];
    level.bossPool = [];
    if (!level.file) { level.implemented = false; continue; }
    const data = JSON.parse(fs.readFileSync(path.join(contentDir, level.file), 'utf8'));
    level.implemented = true;
    level.buildings = data.buildings;
    level.bossPool = data.boss || [];
    for (const b of data.buildings) {
      if (buildings.has(b.id)) throw new Error(`edificio duplicato ${b.id}`);
      b.levelId = level.id;
      buildings.set(b.id, b);
      for (const [si, stage] of b.stages.entries()) {
        for (const it of stage.items) {
          validateItem(it, `${b.id}/stage${si}`);
          if (ids.has(it.id)) throw new Error(`id duplicato ${it.id}`);
          ids.add(it.id);
        }
      }
    }
    for (const q of level.bossPool) {
      validateItem(q, `${level.id}/boss`);
      if (q.kind !== 'mcq') throw new Error(`${q.id}: le domande del boss devono essere mcq`);
      if (ids.has(q.id)) throw new Error(`id duplicato ${q.id}`);
      ids.add(q.id);
    }
  }
  const npcs = loadNpcs(contentDir);
  return { levels: levels.levels, city: levels.city, boss, buildings, npcs };
}

// Ex-studenti per strada (facoltativo): consigli, conversazioni filosofiche e film.
const NPC_KINDS = ['consiglio', 'filosofia', 'film', 'tesi'];
function loadNpcs(contentDir) {
  const file = path.join(contentDir, 'npcs.json');
  if (!fs.existsSync(file)) return { npcs: [], films: [] };
  const data = JSON.parse(fs.readFileSync(file, 'utf8'));
  const seen = new Set();
  for (const n of data.npcs || []) {
    const where = `npcs.json (${n.id || '?'})`;
    if (!n.id || seen.has(n.id)) throw new Error(`${where}: id mancante o duplicato`);
    seen.add(n.id);
    if (!NPC_KINDS.includes(n.kind)) throw new Error(`${where}: kind sconosciuto ${n.kind}`);
    // Formato semplice (una sola conversazione): lines, question, choices e outro direttamente nell'ex-studente.
    if (!n.talks && n.lines) {
      n.talks = [{ topic: n.topic || 'Due chiacchiere', lines: n.lines, question: n.question, choices: n.choices, outro: n.outro, films: n.kind === 'film' }];
      for (const k of ['lines', 'question', 'choices', 'outro', 'again']) delete n[k];
    }
    if (!Array.isArray(n.talks) || !n.talks.length) throw new Error(`${where}: servono le conversazioni (talks)`);
    if (n.talks.length > 30) throw new Error(`${where}: al massimo 30 conversazioni`);
    n.talks.forEach((t, i) => {
      if (!t.topic || !Array.isArray(t.lines) || !t.lines.length) throw new Error(`${where}: la conversazione ${i + 1} richiede topic e lines`);
      const checkQ = (q, depth) => {
        if (!Array.isArray(q.choices) || q.choices.length < 2) throw new Error(`${where}: la conversazione «${t.topic}» ha una domanda ma meno di 2 choices`);
        for (const c of q.choices) {
          if (!c.label) throw new Error(`${where}: una scelta di «${t.topic}» non ha label`);
          if (c.then) { if (depth >= 4 || !c.then.question) throw new Error(`${where}: «${t.topic}» ha un then senza question o troppo profondo`); checkQ(c.then, depth + 1); }
        }
      };
      if (t.question) checkQ(t, 0);
      if (t.requires && i === 0) throw new Error(`${where}: la prima conversazione non può avere requires`);
    });
    if (n.kind === 'filosofia' && !n.talks.some((t) => t.question)) throw new Error(`${where}: una conversazione filosofica richiede almeno una question`);
    if (n.kind === 'film' && !n.talks.some((t) => t.films)) throw new Error(`${where}: un cinefilo richiede una conversazione con films: true`);
  }
  delete data._note;
  return { npcs: data.npcs || [], films: data.films || [], filmIntro: data.filmIntro || 'Che genere ti va?' };
}

