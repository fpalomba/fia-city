function planItem(item, iid) {
  const base = { id: iid, cid: item.id, kind: item.kind, prompt: item.prompt || '', weight: item.weight || 1 };
  switch (item.kind) {
    case 'mcq': {
      const opts = item.options.map((label, i) => ({ id: rid(), label, i }));
      const shown = item.keepOrder ? opts : shuffle(opts);
      return {
        client: { ...base, options: shown.map(({ id, label }) => ({ id, label })) },
        key: { kind: 'mcq', correct: opts[item.answer].id }
      };
    }
    case 'tf':
      return { client: base, key: { kind: 'tf', correct: item.answer } };
    case 'order': {
      const ents = item.entries.map((e) => ({ id: rid(), label: e.label, reveal: e.reveal || '' }));
      let shown = shuffle(ents);
      if (shown.every((e, i) => e.id === ents[i].id)) shown = shown.slice().reverse();
      return {
        client: { ...base, entries: shown.map(({ id, label }) => ({ id, label })), hint: item.hint || '' },
        key: { kind: 'order', correct: ents.map((e) => e.id), reveal: Object.fromEntries(ents.map((e) => [e.id, e.reveal])) }
      };
    }
    case 'match': {
      const pairs = item.pairs.map(([l, r]) => ({ l: { id: rid(), label: l }, r: { id: rid(), label: r } }));
      return {
        client: {
          ...base,
          left: shuffle(pairs.map((p) => p.l)),
          right: shuffle(pairs.map((p) => p.r)),
          leftTitle: item.leftTitle || '', rightTitle: item.rightTitle || ''
        },
        key: { kind: 'match', correct: Object.fromEntries(pairs.map((p) => [p.l.id, p.r.id])) }
      };
    }
    case 'categorize': {
      const cats = item.categories.map((label) => ({ id: rid(), label }));
      const ents = item.entries.map((e) => ({ id: rid(), label: e.label, cat: cats[e.cat].id }));
      return {
        client: { ...base, categories: cats, entries: shuffle(ents).map(({ id, label }) => ({ id, label })) },
        key: { kind: 'categorize', correct: Object.fromEntries(ents.map((e) => [e.id, e.cat])) }
      };
    }
    case 'matrix': {
      const rows = item.rows.map((r) => ({ id: rid(), label: r.label, answers: r.answers }));
      const shownRows = item.keepOrder ? rows : shuffle(rows);
      const correct = {};
      for (const r of rows) {
        r.answers.forEach((a, c) => { if (a !== null && a !== undefined) correct[`${r.id}:${c}`] = a; });
      }
      return {
        client: {
          ...base,
          cols: item.cols,
          rows: shownRows.map((r) => ({ id: r.id, label: r.label, ask: r.answers.map((a) => a !== null && a !== undefined) }))
        },
        key: { kind: 'matrix', correct }
      };
    }
  }
  throw new Error(`kind non gestito ${item.kind}`);
}

function buildPlan(building) {
  const stages = [];
  const keys = {};
  building.stages.forEach((stage, si) => {
    const pool = stage.pick ? sample(stage.items, stage.pick) : stage.items;
    const items = pool.map((it, k) => {
      const iid = `s${si}i${k}`;
      const { client, key } = planItem(it, iid);
      keys[iid] = { ...key, cid: it.id, weight: it.weight || 1, explain: it.explain || '', ref: it.ref || stage.ref || '' };
      return client;
    });
    stages.push({
      title: stage.title,
      instructions: stage.instructions || '',
      presentation: stage.presentation || 'default',
      timeLimitSec: stage.timeLimitSec || 0,
      npcLine: stage.npcLine || '',
      items
    });
  });
  return { stages, keys };
}

// ---- Correzione ------------------------------------------------------------

function gradeItem(key, response) {
  const c = key.correct;
  switch (key.kind) {
    case 'mcq':
      return { score: response === c ? 1 : 0, solution: c };
    case 'tf':
      return { score: response === c ? 1 : 0, solution: c };
    case 'order': {
      const resp = Array.isArray(response) ? response : [];
      const valid = resp.length === c.length && c.every((id) => resp.includes(id));
      if (!valid) return { score: 0, solution: c, reveal: key.reveal };
      // Concordanza a coppie (tau di Kendall normalizzata in [0,1]).
      const pos = Object.fromEntries(resp.map((id, i) => [id, i]));
      let ok = 0, tot = 0;
      for (let i = 0; i < c.length; i++) {
        for (let j = i + 1; j < c.length; j++) {
          tot++;
          if (pos[c[i]] < pos[c[j]]) ok++;
        }
      }
      const exact = c.every((id, i) => resp[i] === id);
      return { score: exact ? 1 : Math.round((ok / tot) * 0.9 * 100) / 100, solution: c, reveal: key.reveal };
    }
    case 'match':
    case 'categorize': {
      const resp = response && typeof response === 'object' ? response : {};
      const ks = Object.keys(c);
      const ok = ks.filter((k) => resp[k] === c[k]).length;
      return { score: Math.round((ok / ks.length) * 100) / 100, solution: c };
    }
    case 'matrix': {
      const resp = response && typeof response === 'object' ? response : {};
      const ks = Object.keys(c);
      const ok = ks.filter((k) => Number(resp[k]) === c[k] && resp[k] !== null && resp[k] !== undefined && resp[k] !== '').length;
      return { score: Math.round((ok / ks.length) * 100) / 100, solution: c };
    }
  }
  return { score: 0, solution: null };
}

function attemptScore(keys, answers) {
  let got = 0, tot = 0;
  for (const [iid, key] of Object.entries(keys)) {
    tot += key.weight;
    got += (answers[iid] || 0) * key.weight;
  }
  return tot ? Math.round((got / tot) * 1000) / 10 : 0;
}

// ---- Boss --------------------------------------------------------------------

function planBossQuestion(q) {
  const { client, key } = planItem(q, `b-${q.id}`);
  return { client, key: { ...key, cid: q.id, explain: q.explain || '', ref: q.ref || '' } };
}

module.exports = { loadContent, buildPlan, gradeItem, attemptScore, planBossQuestion, shuffle, sample };

  return module.exports;
})();

// FIA City su Google Apps Script: le stesse regole del server Node (server/game.js), con i dati
// salvati nel foglio Google a cui è collegato lo script. Le soluzioni restano qui e non arrivano
// mai al browser. CONFIG, CONTENT e Grading vengono aggiunti sopra da tools/build-static.js.

var SHEET_PLAYERS = 'Giocatori';
var SHEET_STATS = 'Domande';
var SHEET_ROSTER = 'Iscritti';
// Colonne del foglio Giocatori: A username, B stato del gioco, C..J dati (JSON spezzato), poi il riepilogo leggibile.
var DATA_COL = 3, DATA_CHUNKS = 8, CHUNK = 45000;
var SUMMARY_COL = DATA_COL + DATA_CHUNKS;
var USERNAME_RE = /^[a-z0-9][a-z0-9._-]{2,31}$/;

class GameError extends Error {
  constructor(status, message) { super(message); this.status = status; }
}

// ---------------- Web app ----------------

function doPost(e) {
  var out;
  try {
    var body = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    out = { ok: true, data: handle(body) };
  } catch (err) {
    if (err instanceof GameError) out = { ok: false, status: err.status, error: err.message };
    else { console.error(err); out = { ok: false, status: 500, error: 'Errore interno: ' + (err && err.message) }; }
  }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

function doGet() {
  return ContentService.createTextOutput(JSON.stringify({ ok: true, data: { app: 'FIA City', players: playersSheet().getLastRow() - 1 } }))
    .setMimeType(ContentService.MimeType.JSON);
}

function handle(body) {
  var a = String(body.action || '');
  if (a === 'login') return login(body.username);
  var p = auth(String(body.token || ''));
  switch (a) {
    case 'me': return progress(p);
    case 'logout': p.data.tokens = p.data.tokens.filter(function (t) { return t !== body.token; }); savePlayer(p); return { ok: true };
    case 'state': saveState(p, body.state); return { ok: true };
    case 'startAttempt': return startAttempt(p, String(body.buildingId || ''));
    case 'answer': return answer(p, Number(body.attemptId), String(body.itemId || ''), body.response);
    case 'bossDialog': return bossDialog(p, body.readSlides, !!body.hasDoubts);
    case 'bossStart': return bossStart(p);
    case 'bossNext': return bossNext(p);
    case 'bossAnswer': return bossAnswer(p, String(body.optionId || ''));
  }
  throw new GameError(404, 'Azione inesistente');
}

// ---------------- Foglio ----------------

var BUILDINGS = [];
var BUILDING_BY_ID = {};
CONTENT.levels.forEach(function (l) {
  l.buildings.forEach(function (b) { b.levelId = l.id; BUILDINGS.push(b); BUILDING_BY_ID[b.id] = b; });
});
var implementedLevels = function () { return CONTENT.levels.filter(function (l) { return l.implemented; }); };

function summaryHeader() {
  return ['creato', 'ultimo accesso', 'badge']
    .concat(BUILDINGS.map(function (b) { return b.name + ' (voto)'; }))
    .concat(BUILDINGS.map(function (b) { return b.name + ' (tentativi)'; }))
    .concat(['media quiz /30', 'tentativi boss', 'boss sconfitto', 'ha letto le slide', 'ha dubbi', 'voto finale', 'data voto finale']);
}

function playersSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(SHEET_PLAYERS);
  var header = ['username', 'stato (non modificare)'];
  for (var i = 1; i <= DATA_CHUNKS; i++) header.push('dati ' + i + ' (non modificare)');
  header = header.concat(summaryHeader());
  if (!sh) {
    sh = ss.insertSheet(SHEET_PLAYERS);
    ensureColumns(sh, header.length);
    sh.getRange(1, 1, 1, header.length).setValues([header]);
    sh.setFrozenRows(1);
    sh.hideColumns(2, 1 + DATA_CHUNKS);
    return sh;
  }
  // Se cambiano gli edifici cambia solo l'intestazione del riepilogo: i dati sono nelle colonne B..J.
  ensureColumns(sh, header.length);
  var cur = sh.getRange(1, 1, 1, header.length).getValues()[0];
  if (cur.join('\u0001') !== header.join('\u0001')) sh.getRange(1, 1, 1, header.length).setValues([header]);
  return sh;
}

// Un foglio nuovo ha 26 colonne: il riepilogo con un voto e un contatore per edificio ne richiede di più.
function ensureColumns(sh, n) {
  var max = sh.getMaxColumns();
  if (max < n) sh.insertColumnsAfter(max, n - max);
}

function findRow(sh, username) {
  var last = sh.getLastRow();
  if (last < 2) return 0;
  var r = sh.getRange(2, 1, last - 1, 1).createTextFinder(username).matchCase(true).matchEntireCell(true).findNext();
  return r ? r.getRow() : 0;
}

function emptyData() {
  return { createdAt: now(), tokens: [], nextId: 1, attempts: [], badges: {}, runs: [], dialog: null, final: null };
}

// Ogni pezzo di JSON inizia con «j»: così Fogli non lo scambia mai per un numero, una data o una formula.
function joinChunks(cells) {
  return cells.map(function (c) { c = String(c || ''); return c.charAt(0) === 'j' ? c.slice(1) : c; }).join('');
}

function loadPlayer(sh, row) {
  var v = sh.getRange(row, 1, 1, DATA_COL - 1 + DATA_CHUNKS).getValues()[0];
  var raw = joinChunks(v.slice(DATA_COL - 1, DATA_COL - 1 + DATA_CHUNKS));
  var data = raw ? JSON.parse(raw) : emptyData();
  return { sh: sh, row: row, username: String(v[0]), state: v[1] ? JSON.parse(v[1]) : {}, data: data };
}

// Scrive dati e riepilogo in un colpo solo (colonne C..fine). Lo stato del gioco ha una colonna sua,
// così il salvataggio periodico della posizione non si sovrappone a una risposta.
function savePlayer(p) {
  var s = JSON.stringify(p.data);
  if (s.length > CHUNK * DATA_CHUNKS) throw new GameError(500, 'Dati del giocatore troppo grandi');
  var cells = [];
  for (var i = 0; i < DATA_CHUNKS; i++) { var c = s.slice(i * CHUNK, (i + 1) * CHUNK); cells.push(c ? 'j' + c : ''); }
  var row = cells.concat(summaryRow(p));
  p.sh.getRange(p.row, DATA_COL, 1, row.length).setValues([row]);
}

function summaryRow(p) {
  var badges = badgeSet(p);
  var runs = p.data.runs.filter(function (r) { return r.end; });
  var d = p.data.dialog, f = p.data.final;
  return [p.data.createdAt, now(), badges.size + '/' + BUILDINGS.length]
    .concat(BUILDINGS.map(function (b) { var g = gradedScore(finishedAttempts(p, b.id)); return g === null ? '' : g; }))
    .concat(BUILDINGS.map(function (b) { return finishedAttempts(p, b.id).length; }))
    .concat([quizAverage30(p), runs.length, runs.some(function (r) { return r.won; }) ? 'si' : 'no',
      d ? d.readSlides : '', d ? (d.hasDoubts ? 'si' : 'no') : '', f ? f.grade : '', f ? f.at : '']);
}

function roster() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_ROSTER);
  if (!sh || sh.getLastRow() < 2) return null;
  var names = sh.getRange(2, 1, sh.getLastRow() - 1, 1).getValues()
    .map(function (r) { return String(r[0]).trim().toLowerCase(); }).filter(Boolean);
  return names.length ? new Set(names) : null;
}

function now() { return new Date().toISOString(); }

// ---------------- Giocatori e sessioni ----------------

function login(rawUsername) {
  var username = String(rawUsername || '').trim().toLowerCase();
  if (!USERNAME_RE.test(username)) {
    throw new GameError(400, 'Username non valido: usa 3-32 caratteri tra lettere, numeri, punto, trattino e underscore.');
  }
  var r = roster();
  if (r && !r.has(username)) throw new GameError(403, 'Questo username non è nell\'elenco degli iscritti. Contatta il docente.');
  var sh = playersSheet();
  // Il lucchetto evita due righe per lo stesso username se due accessi arrivano insieme.
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var row = findRow(sh, username);
    var isNew = false;
    if (!row) {
      // Formato testo: una matricola come 0512100123 resta tale e non diventa un numero.
      row = sh.getLastRow() + 1;
      var blank = [username, '{}'];
      for (var i = 0; i < DATA_CHUNKS; i++) blank.push('');
      var range = sh.getRange(row, 1, 1, blank.length);
      range.setNumberFormat('@');
      range.setValues([blank]);
      isNew = true;
    }
    var p = loadPlayer(sh, row);
    var token = Utilities.getUuid().replace(/-/g, '') + '~' + username;
    p.data.tokens = p.data.tokens.concat([token]).slice(-10);
    savePlayer(p);
    return { token: token, isNew: isNew };
  } finally {
    lock.releaseLock();
  }
}

function auth(token) {
  var cut = token.lastIndexOf('~');
  var username = cut > 0 ? token.slice(cut + 1) : '';
  var err = new GameError(401, 'Sessione scaduta: effettua di nuovo l\'accesso.');
  if (!username) throw err;
  var sh = playersSheet();
  var row = findRow(sh, username);
  if (!row) throw err;
  var p = loadPlayer(sh, row);
  if (p.data.tokens.indexOf(token) < 0) throw err;
  return p;
}

function saveState(p, state) {
  var s = JSON.stringify(state || {});
  if (s.length > 8000) throw new GameError(400, 'Stato troppo grande');
  p.sh.getRange(p.row, 2).setValue(s);
  p.sh.getRange(p.row, SUMMARY_COL + 1).setValue(now());
}

// ---------------- Progressi ----------------

function finishedAttempts(p, buildingId) {
  return p.data.attempts.filter(function (a) { return a.b === buildingId && a.end; });
}

function gradedScore(atts) {
  if (!atts.length) return null;
  var scores = atts.map(function (a) { return a.score; });
  switch (CONFIG.scorePolicy) {
    case 'best': return Math.max.apply(null, scores);
    case 'last': return scores[scores.length - 1];
    case 'mean': return Math.round((scores.reduce(function (s, x) { return s + x; }, 0) / scores.length) * 10) / 10;
    default: return scores[0];
  }
}

function badgeSet(p) { return new Set(Object.keys(p.data.badges)); }

function levelComplete(level, badges) {
  return level.implemented && level.buildings.length > 0 && level.buildings.every(function (b) { return badges.has(b.id); });
}

function levelUnlocked(levelIndex, badges) {
  for (var i = 0; i < levelIndex; i++) {
    var l = CONTENT.levels[i];
    if (l.implemented && !levelComplete(l, badges)) return false;
  }
  return true;
}

function bossUnlocked(badges) {
  var impl = implementedLevels();
  return impl.length > 0 && impl.every(function (l) { return levelComplete(l, badges); });
}

function quizAverage30(p) {
  var all = [];
  implementedLevels().forEach(function (l) { all = all.concat(l.buildings); });
  if (!all.length) return 0;
  var sum = all.reduce(function (s, b) { return s + (gradedScore(finishedAttempts(p, b.id)) || 0); }, 0);
  return Math.round((sum / all.length / 100) * 30 * 100) / 100;
}

function progress(p) {
  var badges = badgeSet(p);
  var buildings = {};
  implementedLevels().forEach(function (level) {
    level.buildings.forEach(function (b) {
      var atts = finishedAttempts(p, b.id);
      buildings[b.id] = {
        badge: badges.has(b.id),
        attempts: atts.length,
        graded: gradedScore(atts),
        best: atts.length ? Math.max.apply(null, atts.map(function (a) { return a.score; })) : null,
        inProgress: p.data.attempts.some(function (a) { return a.b === b.id && !a.end; })
      };
    });
  });
  var f = p.data.final;
  return {
    username: p.username,
    state: p.state,
    buildings: buildings,
    levels: CONTENT.levels.map(function (l, i) { return { id: l.id, unlocked: levelUnlocked(i, badges), complete: levelComplete(l, badges) }; }),
    quizAvg30: quizAverage30(p),
    boss: {
      unlocked: bossUnlocked(badges),
      runs: p.data.runs.filter(function (r) { return r.end; }).length,
      dialogDone: !!p.data.dialog,
      final: f ? { grade: f.grade, quizAvg30: f.quizAvg30, at: f.at } : null
    },
    rules: { passThreshold: CONFIG.passThreshold, scorePolicy: CONFIG.scorePolicy }
  };
}

// ---------------- Tentativi negli edifici ----------------

function feedbackFor(key, score, response) {
  var g = Grading.gradeItem(key, response);
  return { score: score, correct: score >= 0.999, solution: g.solution, reveal: g.reveal, explain: key.explain, ref: key.ref, response: response };
}

function startAttempt(p, buildingId) {
  var b = BUILDING_BY_ID[buildingId];
  if (!b) throw new GameError(404, 'Edificio inesistente');
  var levelIndex = CONTENT.levels.findIndex(function (l) { return l.id === b.levelId; });
  if (!levelUnlocked(levelIndex, badgeSet(p))) throw new GameError(403, 'Quartiere ancora bloccato');
  var att = p.data.attempts.find(function (a) { return a.b === buildingId && !a.end; });
  if (!att) {
    att = { id: p.data.nextId++, b: b.id, l: b.levelId, start: now(), end: null, score: null, plan: Grading.buildPlan(b), ans: {} };
    p.data.attempts.push(att);
    savePlayer(p);
  }
  var answered = {};
  Object.keys(att.ans).forEach(function (iid) {
    var a = att.ans[iid];
    answered[iid] = feedbackFor(att.plan.keys[iid], a.s, a.r);
  });
  return { attemptId: att.id, building: { id: b.id, name: b.name }, stages: att.plan.stages, answered: answered, previousAttempts: finishedAttempts(p, buildingId).length };
}

function answer(p, attemptId, itemId, response) {
  var att = p.data.attempts.find(function (a) { return a.id === attemptId; });
  if (!att) throw new GameError(404, 'Tentativo inesistente');
  if (att.end) throw new GameError(409, 'Tentativo già concluso');
  var key = att.plan.keys[itemId];
  if (!key) throw new GameError(400, 'Domanda inesistente');
  if (att.ans[itemId]) throw new GameError(409, 'Hai già risposto a questa domanda');
  var resp = response === undefined ? null : response;
  var g = Grading.gradeItem(key, resp);
  att.ans[itemId] = { s: g.score, r: resp };
  var fb = feedbackFor(key, g.score, resp);

  var done = Object.keys(att.plan.keys).every(function (k) { return !!att.ans[k]; });
  if (!done) { savePlayer(p); return { feedback: fb }; }

  var scores = {};
  Object.keys(att.ans).forEach(function (k) { scores[k] = att.ans[k].s; });
  var score = Grading.attemptScore(att.plan.keys, scores);
  // A tentativo concluso si tengono solo i punteggi per domanda (per le statistiche), non il piano.
  var cs = {};
  Object.keys(att.ans).forEach(function (k) { cs[att.plan.keys[k].cid] = att.ans[k].s; });
  att.end = now(); att.score = score; att.cs = cs;
  delete att.plan; delete att.ans;
  var passed = score >= CONFIG.passThreshold;
  var newBadge = false;
  if (passed && !p.data.badges[att.b]) { p.data.badges[att.b] = now(); newBadge = true; }
  savePlayer(p);
  var atts = finishedAttempts(p, att.b);
  var badges = badgeSet(p);
  var level = CONTENT.levels.find(function (l) { return l.id === att.l; });
  return {
    feedback: fb,
    summary: {
      score: score, passed: passed, newBadge: newBadge, hasBadge: badges.has(att.b),
      graded: gradedScore(atts), attempts: atts.length,
      scorePolicy: CONFIG.scorePolicy, passThreshold: CONFIG.passThreshold,
      levelComplete: levelComplete(level, badges), bossUnlocked: bossUnlocked(badges)
    }
  };
}

// ---------------- Boss finale ----------------

function bossPool() {
  var out = [];
  implementedLevels().forEach(function (l) { l.bossPool.forEach(function (q) { out.push(Object.assign({}, q, { levelId: l.id })); }); });
  return out;
}

function openRun(p) {
  for (var i = p.data.runs.length - 1; i >= 0; i--) if (!p.data.runs[i].end) return p.data.runs[i];
  return null;
}

function publicRun(run, s) {
  return {
    runId: run.id, hp: s.hp, maxHp: s.maxHp, lives: s.lives, maxLives: s.maxLives,
    phase: s.hp <= s.maxHp / 2 ? 2 : 1, correct: s.correct, wrong: s.wrong,
    finished: !!run.end, won: !!run.won
  };
}

function bossDialog(p, readSlides, hasDoubts) {
  if (['si', 'no', 'insisto'].indexOf(readSlides) < 0) throw new GameError(400, 'Risposta non valida');
  p.data.dialog = { readSlides: readSlides, hasDoubts: hasDoubts, at: now() };
  savePlayer(p);
  return { ok: true };
}

function bossStart(p) {
  if (!bossUnlocked(badgeSet(p))) throw new GameError(403, 'Il Prof. ti riceverà solo dopo che avrai ottenuto tutti i badge.');
  var run = openRun(p);
  if (!run) {
    var bc = CONFIG.boss;
    var pool = bossPool();
    if (!pool.length) throw new GameError(500, 'Nessuna domanda per il boss');
    run = {
      id: p.data.nextId++, start: now(), end: null, won: false,
      state: {
        hp: bc.maxHp, maxHp: bc.maxHp, lives: bc.lives, maxLives: bc.lives,
        damage: Math.ceil(bc.maxHp / bc.questionsToWin),
        correct: 0, wrong: 0, queue: Grading.shuffle(pool.map(function (q) { return q.id; })), current: null, log: []
      }
    };
    p.data.runs.push(run);
    savePlayer(p);
  }
  return publicRun(run, run.state);
}

function timeLimitFor(s) { return s.hp <= s.maxHp / 2 ? CONFIG.boss.phase2TimeLimitSec : CONFIG.boss.timeLimitSec; }

function bossNext(p) {
  var run = openRun(p);
  if (!run) throw new GameError(409, 'Nessuno scontro in corso');
  var s = run.state;
  if (!s.current) {
    var pool = bossPool();
    if (!s.queue.length) s.queue = Grading.shuffle(pool.map(function (q) { return q.id; }));
    var id = s.queue.shift();
    var item = pool.find(function (q) { return q.id === id; });
    var planned = Grading.planBossQuestion(item);
    s.current = { client: Object.assign({}, planned.client, { level: item.levelId }), key: planned.key, servedAt: Date.now(), limit: timeLimitFor(s) };
    savePlayer(p);
  }
  var remaining = Math.max(0, s.current.limit - (Date.now() - s.current.servedAt) / 1000);
  return { question: s.current.client, timeLimitSec: s.current.limit, remainingSec: Math.round(remaining * 10) / 10, run: publicRun(run, s) };
}

function bossAnswer(p, optionId) {
  var run = openRun(p);
  if (!run) throw new GameError(409, 'Nessuno scontro in corso');
  var s = run.state;
  if (!s.current) throw new GameError(409, 'Nessuna domanda in sospeso');
  var cur = s.current;
  var elapsed = (Date.now() - cur.servedAt) / 1000;
  var timedOut = elapsed > cur.limit + CONFIG.boss.graceSec;
  var ok = !timedOut && optionId === cur.key.correct;
  var phaseBefore = s.hp <= s.maxHp / 2 ? 2 : 1;
  var healed = 0;
  if (ok) { s.hp = Math.max(0, s.hp - s.damage); s.correct++; }
  else {
    s.lives--; s.wrong++;
    if (phaseBefore === 2 && CONFIG.boss.phase2HealOnWrong) { healed = Math.min(CONFIG.boss.phase2HealOnWrong, s.maxHp - s.hp); s.hp += healed; }
  }
  s.log.push({ cid: cur.key.cid, ok: ok, timedOut: timedOut, t: Math.round(elapsed * 10) / 10 });
  s.current = null;
  var won = s.hp <= 0;
  var lost = !won && s.lives <= 0;
  var final = null;
  if (won || lost) {
    run.end = now(); run.won = won;
    delete s.queue;
    if (won) {
      var ex = p.data.final;
      if (!ex) {
        var quizAvg30 = quizAverage30(p);
        var grade = Math.round(((30 + quizAvg30) / 2) * 100) / 100;
        p.data.final = { runId: run.id, quizAvg30: quizAvg30, grade: grade, at: run.end };
        final = { grade: grade, quizAvg30: quizAvg30, first: true };
      } else {
        final = { grade: ex.grade, quizAvg30: ex.quizAvg30, first: false };
      }
    }
  }
  savePlayer(p);
  return {
    correct: ok, timedOut: timedOut, healed: healed,
    solution: cur.key.correct, explain: cur.key.explain, ref: cur.key.ref,
    phaseChanged: phaseBefore === 1 && s.hp <= s.maxHp / 2 && s.hp > 0,
    run: publicRun(run, s),
    final: final
  };
}

// ---------------- Per il docente: menu del foglio ----------------

function onOpen() {
  SpreadsheetApp.getUi().createMenu('FIA City')
    .addItem('Prepara il foglio', 'preparaFoglio')
    .addItem('Aggiorna statistiche delle domande', 'aggiornaStatistiche')
    .addToUi();
}

function preparaFoglio() {
  playersSheet();
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss.getSheetByName(SHEET_ROSTER)) {
    var r = ss.insertSheet(SHEET_ROSTER);
    r.getRange(1, 1, 1000, 1).setNumberFormat('@'); // matricole con lo zero iniziale restano testo
    r.getRange(1, 1, 1, 2).setValues([['username', 'Elenco facoltativo: se scrivi qui degli username, solo loro possono entrare. Lascia vuoto per accesso libero.']]);
  }
}

function aggiornaStatistiche() {
  var sh = playersSheet();
  var texts = {};
  implementedLevels().forEach(function (l) {
    l.buildings.forEach(function (b) { b.stages.forEach(function (st) { st.items.forEach(function (it) { texts[it.id] = [b.name, it.prompt || it.id, it.kind]; }); }); });
    l.bossPool.forEach(function (it) { texts[it.id] = ['Boss finale', it.prompt, 'mcq']; });
  });
  var agg = {};
  var add = function (cid, v) { var a = agg[cid] || (agg[cid] = { n: 0, sum: 0 }); a.n++; a.sum += v; };
  var last = sh.getLastRow();
  if (last >= 2) {
    sh.getRange(2, DATA_COL, last - 1, DATA_CHUNKS).getValues().forEach(function (cells) {
      var raw = joinChunks(cells);
      if (!raw) return;
      var d = JSON.parse(raw);
      d.attempts.forEach(function (a) { if (a.cs) Object.keys(a.cs).forEach(function (cid) { add(cid, a.cs[cid]); }); });
      d.runs.forEach(function (r) { (r.state.log || []).forEach(function (e) { add(e.cid, e.ok ? 1 : 0); }); });
    });
  }
  var rows = Object.keys(agg).map(function (cid) {
    var t = texts[cid] || ['', cid, ''];
    return [cid, t[0], t[1], t[2], agg[cid].n, Math.round((agg[cid].sum / agg[cid].n) * 100) / 100];
  }).sort(function (a, b) { return a[5] - b[5]; });
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var st = ss.getSheetByName(SHEET_STATS) || ss.insertSheet(SHEET_STATS);
  st.clear();
  st.getRange(1, 1, 1, 6).setValues([['id', 'edificio', 'domanda', 'tipo', 'risposte', 'punteggio medio (0-1)']]);
  if (rows.length) st.getRange(2, 1, rows.length, 6).setValues(rows);
  st.setFrozenRows(1);
}
